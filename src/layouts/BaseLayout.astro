---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AmbientLayer from '../components/AmbientLayer.astro';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  footer?: boolean;
  /** 访问口令门：site=全站门（默认），maoxuan=毛选学习独立门 */
  gate?: 'site' | 'maoxuan';
}

const {
  title,
  description = SITE.description,
  noindex = false,
  footer = true,
  gate = 'site',
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
---

<!doctype html>
<html lang="zh-CN" data-theme="light" data-theme-mode="auto" data-gate={gate}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />

    <meta name="theme-color" content="#f6f5f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1d23" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var mode = stored === 'light' || stored === 'dark' ? stored : 'auto';
          // 按当地时间自动切换：6:00–18:00 白天（浅色），其余晚上（深色）
          var h = new Date().getHours();
          var themeByTime = h >= 6 && h < 18 ? 'light' : 'dark';
          var theme = mode === 'auto' ? themeByTime : mode;
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.setAttribute('data-theme-mode', mode);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.setAttribute('data-theme-mode', 'auto');
        }
      })();
    </script>

    <script is:inline>
      (function () {
        // 访问口令（混淆存储，避免源码直接可见）
        // gate 类型：site=全站，maoxuan=毛选学习（从 html data-gate 读取）
        var GATE = document.documentElement.getAttribute('data-gate') === 'maoxuan' ? 'maoxuan' : 'site';
        var KEY = GATE === 'maoxuan' ? 'maoxuan-access' : 'dengzhimin-access';
        var GATE_ID = GATE === 'maoxuan' ? 'maoxuan-gate' : 'site-gate';
        var PASS = String.fromCharCode(108, 101, 111, 50, 48, 50, 54);
        var gate = null;
        var input = null;
        var btn = null;
        var err = null;

        function entered() {
          try {
            return sessionStorage.getItem(KEY) === 'ok';
          } catch (e) {
            return false;
          }
        }
        function showGate() {
          if (gate) gate.hidden = false;
          if (input) input.focus();
        }
        function unlock() {
          // 毛选学习门不做记忆：每次进入都要重新输入
          if (GATE !== 'maoxuan') {
            try {
              sessionStorage.setItem(KEY, 'ok');
            } catch (e) {}
          }
          if (gate) gate.hidden = true;
          if (input) input.value = '';
          if (err) err.hidden = true;
        }
        function check() {
          if (GATE === 'maoxuan') {
            // 毛选学习：无条件弹门，每次进入都要口令
            showGate();
          } else if (!entered()) {
            showGate();
          }
        }
        // 等待 DOM 加载完成后再绑定（脚本在 head，gate 元素在 body）
        document.addEventListener('DOMContentLoaded', function () {
          gate = document.getElementById(GATE_ID);
          input = document.getElementById(GATE_ID + '-input');
          btn = document.getElementById(GATE_ID + '-btn');
          err = document.getElementById(GATE_ID + '-error');
          if (btn) {
            btn.addEventListener('click', function () {
              if (input && input.value === PASS) {
                unlock();
              } else {
                if (err) err.hidden = false;
                if (input) input.value = '';
                if (input) input.focus();
              }
            });
          }
          if (input) {
            input.addEventListener('keydown', function (e) {
              if (e.key === 'Enter') btn && btn.click();
            });
          }
          check();
        });
      })();
    </script>
  </head>
  <body>
    {
      gate === 'maoxuan' ? (
        <!-- 毛选学习口令门 -->
        <div class="gate" id="maoxuan-gate" hidden>
          <div class="gate-card glass">
            <h1 class="gate-title">毛选学习</h1>
            <p class="gate-sub">这个栏目暂未公开，输入口令继续访问。</p>
            <div class="gate-form">
              <input
                class="gate-input"
                id="maoxuan-gate-input"
                type="password"
                placeholder="输入访问口令"
                autocomplete="off"
                autofocus
              />
              <button class="btn btn-primary gate-btn" id="maoxuan-gate-btn">进入</button>
            </div>
            <p class="gate-error" id="maoxuan-gate-error" hidden>口令不正确，请重试。</p>
          </div>
        </div>
      ) : (
        <!-- 访问口令门 -->
        <div class="gate" id="site-gate" hidden>
          <div class="gate-card glass">
            <h1 class="gate-title">LEODENG</h1>
            <p class="gate-sub">这个站点暂未公开，输入口令继续访问。</p>
            <div class="gate-form">
              <input
                class="gate-input"
                id="site-gate-input"
                type="password"
                placeholder="输入访问口令"
                autocomplete="off"
                autofocus
              />
              <button class="btn btn-primary gate-btn" id="site-gate-btn">进入</button>
            </div>
            <p class="gate-error" id="site-gate-error" hidden>口令不正确，请重试。</p>
          </div>
        </div>
      )
    }

    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main" style="padding-top: var(--header-h)">
      <slot />
    </main>
    {footer && <Footer />}
    <AmbientLayer />
  </body>
</html>
