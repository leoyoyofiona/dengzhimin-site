---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Typewriter from '../components/Typewriter.astro';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="建议墙"
  description={`公开透明的建议墙：你的每一条建议都会被看见。`}
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Suggestions · 弹幕墙</p>
      <h1 class="display page-title">建议墙</h1>
      <Typewriter text="公开透明：你提的建议，所有人都看得见。" />
    </div>
  </section>

  <section class="container board-body">
    <!-- 提交区 -->
    <div class="compose card">
      <div class="compose-head">
        <span class="compose-icon"><Icon name="message" size={18} /></span>
        <h2 class="compose-title">提一条建议</h2>
        <span class="compose-note">无需登录，匿名即可提交；所有建议公开、所有人可见。</span>
      </div>
      <div class="compose-row">
        <input
          id="sg-name"
          class="name-input"
          type="text"
          maxlength="20"
          placeholder="你的昵称（可选，默认匿名）"
          autocomplete="off"
        />
      </div>
      <textarea
        id="sg-text"
        class="msg-input"
        rows="3"
        maxlength="500"
        placeholder="想对这个小站或作者说什么建议…（⌘/Ctrl + Enter 快捷发布）"
      ></textarea>
      <div class="compose-foot">
        <span class="count-hint" id="sg-count">0 / 500</span>
        <button class="btn btn-primary" id="sg-send">
          发射弹幕 <Icon name="arrow-right" size={14} />
        </button>
      </div>
      <p class="send-status" id="sg-status" hidden></p>
    </div>

    <!-- 弹幕播放区 -->
    <div class="danmaku card">
      <div class="messages-head">
        <h2 class="messages-title">弹幕现场</h2>
        <span class="messages-count" id="sg-total">加载中…</span>
        <span class="danmaku-tools">
          <button class="dm-btn" id="dm-pause" type="button" title="暂停/播放弹幕">⏸</button>
          <button class="dm-btn" id="dm-list-toggle" type="button" title="展开/收起建议列表">📋</button>
        </span>
      </div>
      <div class="dm-stage" id="dm-stage" aria-hidden="false">
        <div class="dm-hint" id="dm-hint">弹幕加载中…</div>
      </div>
      <!-- 完整建议列表（可展开） -->
      <div class="sg-list-wrap" id="sg-list-wrap" hidden>
        <ul class="sg-list" id="sg-list"></ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ SUG_API: 'https://dengzhimin-guestbook-api.leooelcn.workers.dev/api/suggestions' }}>
  const API = SUG_API;
  const MAX = 300;

  const nameInput = document.getElementById('sg-name');
  const textInput = document.getElementById('sg-text');
  const sendBtn = document.getElementById('sg-send');
  const statusEl = document.getElementById('sg-status');
  const countEl = document.getElementById('sg-count');
  const totalEl = document.getElementById('sg-total');
  const stage = document.getElementById('dm-stage');
  const hint = document.getElementById('dm-hint');
  const listWrap = document.getElementById('sg-list-wrap');
  const listEl = document.getElementById('sg-list');
  const pauseBtn = document.getElementById('dm-pause');
  const listBtn = document.getElementById('dm-list-toggle');

  let items = []; // 全部建议（旧→新）
  let running = true;
  let dmIndex = 0;
  let dmTimer = null;

  function esc(s) {
    return String(s ?? '').replace(/[&<>"']/g, function (c) {
      return c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '"' ? '&quot;' : '&#39;';
    });
  }
  function fmtTime(t) {
    if (!t) return '';
    const d = new Date(t);
    const p = (n) => String(n).padStart(2, '0');
    return d.getMonth() + 1 + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
  }
  // 弹幕颜色（柔和、可读）
  const DM_COLORS = ['#e8590c', '#0b7285', '#862e9c', '#c2255c', '#2b8a3e', '#5c7cfa', '#e67700', '#6741d9'];

  function showList() {
    if (!items.length) {
      listEl.innerHTML = '<li class="sg-empty">还没有建议——做第一个提建议的人吧。</li>';
      return;
    }
    listEl.innerHTML = items
      .slice()
      .reverse()
      .map(function (m) {
        const name = m.name || '匿名';
        return (
          '<li class="sg-item">' +
            '<span class="sg-item-name">' + esc(name) + '</span>' +
            '<span class="sg-item-text">' + esc(m.text) + '</span>' +
            '<time class="sg-item-time">' + fmtTime(m.time) + '</time>' +
          '</li>'
        );
      })
      .join('');
  }

  // 播放一条弹幕：把建议文本创建为从右向左飘过的节点
  function fireDm(item) {
    if (!item) return;
    const span = document.createElement('span');
    span.className = 'dm-item';
    span.textContent = (item.name && item.name !== '匿名' ? item.name + '：' : '') + item.text;
    // 随机颜色 + 随机速度/纵向位置（0–8 行）
    span.style.color = DM_COLORS[Math.floor(Math.random() * DM_COLORS.length)];
    span.style.top = 6 + Math.floor(Math.random() * 8) * 12 + '%';
    const dur = 9 + Math.random() * 5; // 9–14 秒
    // 弹幕为 JS 动态创建，scoped CSS 不生效 → 关键样式全部 inline
    span.style.position = 'absolute';
    span.style.left = '100%';
    span.style.whiteSpace = 'nowrap';
    span.style.fontSize = '1rem';
    span.style.fontWeight = '600';
    span.style.letterSpacing = '0.02em';
    span.style.textShadow = '0 1px 2px rgba(0,0,0,0.12)';
    span.style.animationName = 'dm-fly';
    span.style.animationTimingFunction = 'linear';
    span.style.animationIterationCount = '1';
    span.style.willChange = 'transform';
    span.style.pointerEvents = 'none';
    span.style.animationDuration = dur + 's';
    stage.appendChild(span);
    span.addEventListener('animationend', function () { span.remove(); });
    span.style.opacity = '0.92';
  }

  function nextDm() {
    if (!running || !items.length) return;
    fireDm(items[dmIndex % items.length]);
    dmIndex++;
    const gap = 500 + Math.random() * 900;
    dmTimer = setTimeout(nextDm, gap);
  }

  function load() {
    const ctrl = new AbortController();
    const timer = setTimeout(function () { ctrl.abort(); }, 6000);
    fetch(API, { signal: ctrl.signal })
      .then(function (r) {
        clearTimeout(timer);
        if (!r.ok) throw new Error('load failed');
        return r.json();
      })
      .then(function (list) {
        items = Array.isArray(list) ? list : [];
        totalEl.textContent = items.length + ' 条建议';
        hint.hidden = true;
        if (!items.length) {
          stage.innerHTML = '<div class="dm-hint">还没有弹幕——发射第一条吧。</div>';
          return;
        }
        showList();
        nextDm();
      })
      .catch(function () {
        clearTimeout(timer);
        hint.textContent = '建议服务在你的网络暂不可用（大陆等地区可能受限），海外访客可正常使用。';
        hint.hidden = false;
        totalEl.textContent = '暂不可用';
      });
  }

  // 提交建议
  async function send() {
    const text = textInput.value.trim();
    if (!text) { textInput.focus(); return; }
    sendBtn.disabled = true;
    statusEl.hidden = true;
    try {
      const ctrl = new AbortController();
      const timer = setTimeout(function () { ctrl.abort(); }, 6000);
      const res = await fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: nameInput.value.trim(), text: text }),
        signal: ctrl.signal,
      });
      clearTimeout(timer);
      if (!res.ok) throw new Error('send failed');
      // 乐观本地加入并立即发射
      const rec = { name: nameInput.value.trim() || '匿名', text: text, time: Date.now() };
      items.push(rec);
      textInput.value = '';
      nameInput.value = '';
      countEl.textContent = '0 / 500';
      totalEl.textContent = items.length + ' 条建议';
      hint.hidden = true;
      showList();
      // 立即发射自己的建议
      fireDm(rec);
      if (!running) { running = true; nextDm(); }
      if (!dmTimer) nextDm();
    } catch (e) {
      statusEl.textContent = '发布失败，请稍后重试。';
      statusEl.hidden = false;
    }
    sendBtn.disabled = false;
  }

  textInput.addEventListener('input', function () {
    countEl.textContent = textInput.value.length + ' / 500';
  });
  sendBtn.addEventListener('click', send);
  textInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) send();
  });

  // 暂停 / 播放
  pauseBtn.addEventListener('click', function () {
    running = !running;
    pauseBtn.textContent = running ? '⏸' : '▶';
    if (running && !dmTimer) nextDm();
  });
  // 展开 / 收起列表
  listBtn.addEventListener('click', function () {
    listWrap.hidden = !listWrap.hidden;
    if (!listWrap.hidden && items.length) showList();
  });

  load();
</script>

<style>
  .page-head {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }
  .page-head::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -10%;
    width: 60%;
    height: 140%;
    background: var(--gradient-soft);
    filter: blur(90px);
    opacity: 0.5;
    pointer-events: none;
  }
  .page-title { font-size: var(--text-2xl); margin-top: 0.35rem; }
  .eyebrow { color: var(--text-tertiary); font-size: var(--text-sm); }

  .board-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 4rem;
    max-width: 980px;
  }
  .card {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-glass);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    padding: 1.4rem 1.6rem;
    box-shadow: var(--shadow-sm);
  }
  .compose-head, .messages-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .compose-icon { color: var(--accent); display: inline-flex; }
  .compose-title, .messages-title { font-size: var(--text-lg); margin: 0; }
  .compose-note { font-size: var(--text-sm); color: var(--text-tertiary); margin-left: auto; }
  .compose-row { margin-bottom: 0.7rem; }
  .name-input {
    width: min(280px, 100%);
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: inherit;
    font-size: var(--text-base);
  }
  .msg-input {
    width: 100%;
    resize: vertical;
    min-height: 84px;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: inherit;
    font-size: var(--text-base);
    line-height: 1.6;
  }
  .compose-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: 0.7rem;
  }
  .count-hint { font-size: var(--text-sm); color: var(--text-tertiary); }
  .send-status { margin-top: 0.6rem; color: #e03131; font-size: var(--text-sm); }
  .send-status[hidden] { display: none; }

  /* 弹幕舞台 */
  .danmaku { position: relative; overflow: hidden; }
  .messages-count { font-size: var(--text-sm); color: var(--text-tertiary); }
  .danmaku-tools { margin-left: auto; display: flex; gap: 0.4rem; }
  .dm-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 30px; border-radius: var(--radius-full);
    border: 1px solid var(--border); background: var(--bg-elevated);
    color: var(--text-secondary); cursor: pointer; font-size: 0.8rem;
    transition: background var(--speed) var(--ease), color var(--speed) var(--ease);
  }
  .dm-btn:hover { color: var(--text); background: var(--bg-glass-strong); }

  .dm-stage {
    position: relative;
    height: 220px;
    border-radius: var(--radius-md);
    background:
      radial-gradient(420px 200px at 20% 10%, rgba(10, 132, 255, 0.06), transparent 60%),
      radial-gradient(360px 200px at 85% 90%, rgba(94, 92, 230, 0.05), transparent 60%),
      var(--bg-elevated);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .dm-hint {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-tertiary); font-size: var(--text-sm);
    text-align: center; padding: 0 2rem; line-height: 1.7;
  }

  /* 完整列表 */
  .sg-list-wrap { margin-top: 1rem; max-height: 320px; overflow-y: auto; }
  .sg-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.55rem; }
  .sg-item {
    display: flex; align-items: baseline; gap: 0.6rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    font-size: var(--text-base);
  }
  .sg-item-name {
    flex-shrink: 0; font-weight: 600; color: var(--accent);
    max-width: 8em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .sg-item-text { flex: 1; color: var(--text); line-height: 1.55; }
  .sg-item-time { flex-shrink: 0; font-size: var(--text-xs); color: var(--text-tertiary); }
  .sg-empty { color: var(--text-tertiary); padding: 0.8rem; }

  @media (max-width: 640px) {
    .compose-note { display: none; }
    .card { padding: 1.1rem 1rem; }
    .dm-stage { height: 190px; }
    .sg-item { flex-wrap: wrap; }
    .sg-item-time { width: 100%; }
  }
</style>

<style is:global>
  /* 弹幕关键帧需全局（JS 动态元素引用） */
  @keyframes dm-fly {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100vw - 100%)); }
  }
</style>
