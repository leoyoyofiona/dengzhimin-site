---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Typewriter from '../components/Typewriter.astro';
import { SECTIONS, formatDate } from '../lib/site';
import { getCollection } from 'astro:content';

// 聚合全站文章，生成搜索索引
const index = [];
for (const s of SECTIONS) {
  const posts = (await getCollection(s.slug)).filter((p) => !p.data.draft);
  for (const p of posts) {
    index.push({
      title: p.data.title,
      description: p.data.description,
      tags: p.data.tags ?? [],
      topics: p.data.topics ?? [],
      date: formatDate(p.data.date),
      href: `/${s.slug}/${p.slug}/`,
      section: s.title,
      sectionColor: s.color,
      body: p.body?.slice(0, 1200) ?? '',
    });
  }
}
const searchIndex = JSON.stringify(index);
---

<BaseLayout
  title="搜索"
  description="搜索这个网站的所有内容。"
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Search</p>
      <h1 class="display page-title">搜索</h1>
      <Typewriter text="输入关键词，查找全站文章。" />
    </div>
  </section>

  <section class="container search-body">
    <div class="search-box">
      <Icon name="search" size={20} />
      <input
        id="search-input"
        type="search"
        placeholder="输入关键词，如：贝叶斯、AI、教学…"
        autocomplete="off"
        autofocus
      />
    </div>
    <p class="search-hint" id="search-hint"></p>
    <div class="results" id="results"></div>
  </section>
</BaseLayout>

<script define:vars={{ INDEX: index }} is:inline>
  const input = document.getElementById('search-input');
  const results = document.getElementById('results');
  const hint = document.getElementById('search-hint');

  function escapeRe(s) {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function highlight(text, q) {
    if (!q) return text;
    const words = q.split(/\s+/).filter(Boolean);
    if (words.length === 0) return text;
    const re = new RegExp('(' + words.map(escapeRe).join('|') + ')', 'gi');
    return text.replace(re, '<mark>$1</mark>');
  }

  function render(q) {
    const query = (q || '').trim().toLowerCase();
    if (!query) {
      hint.textContent = '共 ' + INDEX.length + ' 篇文章，输入关键词开始搜索';
      results.innerHTML = '';
      return;
    }
    const words = query.split(/\s+/).filter(Boolean);
    const matched = INDEX.filter(function (p) {
      const hay = [p.title, p.description, p.section]
        .concat(p.tags || [], p.topics || [], [p.body])
        .join(' ')
        .toLowerCase();
      return words.every(function (w) {
        return hay.indexOf(w) !== -1;
      });
    });
    hint.textContent = '找到 ' + matched.length + ' 篇相关文章';
    if (matched.length === 0) {
      results.innerHTML = '<div class="empty card"><p class="empty-title">没有找到相关内容</p><p class="secondary">换个关键词试试。</p></div>';
      return;
    }
    results.innerHTML = matched
      .map(function (p) {
        var tagsHtml = p.tags.length > 0 || p.topics.length > 0
          ? '<div class="r-tags">' + (p.topics || []).concat(p.tags || []).slice(0, 3).map(function (t) { return '<span class="badge">' + highlight(t, query) + '</span>'; }).join('') + '</div>'
          : '';
        return (
          '<a class="card card-hover result" href="' + p.href + '" style="--c: ' + p.sectionColor + '">' +
            '<div class="r-top">' +
              '<span class="r-section" style="--sc: ' + p.sectionColor + '">' + p.section + '</span>' +
              '<time class="r-date">' + p.date + '</time>' +
            '</div>' +
            '<h3 class="r-title">' + highlight(p.title, query) + '</h3>' +
            '<p class="r-desc">' + highlight(p.description, query) + '</p>' +
            tagsHtml +
          '</a>'
        );
      })
      .join('');
  }

  input.addEventListener('input', function () {
    render(input.value);
  });
  render('');
</script>

<style>
  .page-head {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }
  .page-head::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -10%;
    width: 60%;
    height: 140%;
    background: var(--gradient-soft);
    filter: blur(90px);
    opacity: 0.5;
    pointer-events: none;
  }
  .page-title {
    font-size: var(--text-2xl);
    margin-top: 0.35rem;
  }
  .page-sub {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    max-width: 28rem;
    white-space: nowrap;
    overflow: hidden;
  }

  .search-body {
    padding-bottom: 4rem;
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-tertiary);
    max-width: 42rem;
    transition:
      border-color var(--speed) var(--ease),
      box-shadow var(--speed) var(--ease);
  }
  .search-box:focus-within {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .search-box input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: var(--text-base);
    font-family: inherit;
    color: var(--text);
  }
  .search-box input::placeholder {
    color: var(--text-tertiary);
  }
  .search-hint {
    margin: 1rem 0 1.25rem;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
  .results {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
  }
  .result {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.6rem;
    text-decoration: none;
  }
  .r-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .r-section {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--sc);
  }
  html[data-theme="dark"] .r-section {
    color: color-mix(in srgb, var(--sc) 55%, #ffffff);
  }
  .r-date {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
  .r-title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
  }
  .r-desc {
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .r-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }
  mark {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--text);
    border-radius: 3px;
    padding: 0 0.15em;
  }
  .empty {
    padding: 3rem 2rem;
    text-align: center;
  }
  .empty-title {
    font-size: var(--text-xl);
    font-weight: 600;
  }
</style>
