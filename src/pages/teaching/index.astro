---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Typewriter from '../../components/Typewriter.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { SECTIONS, firstImage } from '../../lib/site';

const section = SECTIONS.find((s) => s.slug === 'teaching')!;
const all = await getCollection('teaching');

// 排序工具：有 order 的置顶（小在前），否则按日期倒序
function sortPosts(list: CollectionEntry<'teaching'>[]) {
  return [...list].sort((a, b) => {
    const ao = a.data.order ?? 999;
    const bo = b.data.order ?? 999;
    if (ao !== bo) return ao - bo;
    return b.data.date.getTime() - a.data.date.getTime();
  });
}

const posts = sortPosts(all.filter((p) => !p.data.draft));
---

<BaseLayout
  title={section.title}
  description={`${section.title}（${section.en}）—— ${section.description}`}
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">{section.en}</p>
      <h1 class="display page-title">{section.title}</h1>
      <Typewriter text={section.description} />
    </div>
  </section>

  <section class="container list-body">
    {
      posts.length > 0 ? (
        <div class="grid dock-grid">
          {
            posts.map((post) => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                tags={post.data.tags}
                href={`/teaching/${post.slug}/`}
                gradient={section.gradient}
                featured={post.data.featured}
                section={section.title}
                sectionColor={section.color}
                image={firstImage(post.body) ?? undefined}
              />
            ))
          }
        </div>
      ) : (
        <div class="empty">
          <p class="empty-title">还没有内容</p>
          <p class="secondary">这里会陆续记录一些教学思考与课程笔记。</p>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .page-head {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }
  .page-head::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -10%;
    width: 60%;
    height: 140%;
    background: var(--gradient-soft);
    filter: blur(90px);
    opacity: 0.5;
    pointer-events: none;
  }
  .eyebrow a {
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    transition: color var(--speed) var(--ease);
  }
  .eyebrow a:hover {
    color: var(--accent);
  }
  .page-title {
    font-size: var(--text-2xl);
    margin-top: 0.35rem;
  }
  .list-body {
    padding-bottom: 4rem;
    max-width: 1320px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }
  .empty {
    padding: 3rem 2rem;
    text-align: center;
  }
  .empty-title {
    font-size: var(--text-xl);
    font-weight: 600;
  }
  .empty code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-glass);
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
    border: 1px solid var(--border);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
