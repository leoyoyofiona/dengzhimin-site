---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Typewriter from '../../components/Typewriter.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { SECTIONS, firstImage } from '../../lib/site';

const section = SECTIONS.find((s) => s.slug === 'teaching')!;
const all = await getCollection('teaching');

// 排序工具：有 order 的置顶（小在前），否则按日期倒序
function sortPosts(list: CollectionEntry<'teaching'>[]) {
  return [...list].sort((a, b) => {
    const ao = a.data.order ?? 999;
    const bo = b.data.order ?? 999;
    if (ao !== bo) return ao - bo;
    return b.data.date.getTime() - a.data.date.getTime();
  });
}

const maoxuanAll = all.filter((p) => !p.data.draft && p.slug.startsWith('maoxuan/'));
// 三个子栏目：毛选精读（未细分）、黑板前、白板前
const SUBS = [
  {
    key: 'maoxuan',
    title: '毛选精读',
    desc: '一段一段读经典，把道理和自己的教学、研究对照起来。',
    href: '/teaching/maoxuan/',
    color: '#3b82f6',
    icon: 'book',
    items: sortPosts(maoxuanAll.filter((p) => !p.data.sub)),
  },
  {
    key: 'heiban',
    title: '黑板前的冥想',
    desc: '站在黑板前，把经典讲清楚、想透彻',
    href: '/teaching/maoxuan/heiban/',
    color: '#0ea5e9',
    icon: 'doc',
    items: sortPosts(maoxuanAll.filter((p) => p.data.sub === 'heiban')),
  },
  {
    key: 'baiban',
    title: '白板前的冥想',
    desc: '站在白板前，让想法自由生长、连成一片',
    href: '/teaching/maoxuan/baiban/',
    color: '#22c55e',
    icon: 'edit',
    items: sortPosts(maoxuanAll.filter((p) => p.data.sub === 'baiban')),
  },
];

// 普通文章（不含毛选精读）
const posts = sortPosts(all.filter((p) => !p.data.draft && !p.slug.startsWith('maoxuan/')));
---

<BaseLayout
  title={section.title}
  description={`${section.title}（${section.en}）—— ${section.description}`}
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">{section.en}</p>
      <h1 class="display page-title">{section.title}</h1>
      <Typewriter text={section.description} />
    </div>
  </section>

  <section class="container list-body">
    <!-- 三个子栏目长条框 -->
    {
      SUBS.map((sub) => (
        <div class="block">
          <a class="block-head" href={sub.href} style={`--c: ${sub.color}`}>
            <div class="block-head-main">
              <span class="block-icon"><Icon name={sub.icon} size={15} /></span>
              <h2 class="block-title">{sub.title}</h2>
              <span class="block-count">{sub.items.length} 篇</span>
              <span class="block-go">进入 <Icon name="arrow-right" size={13} /></span>
            </div>
            <Typewriter text={sub.desc} class="block-desc" />
          </a>
          {
            sub.items.length > 0 ? (
              <div class="grid dock-grid">
                {
                  sub.items.map((post) => (
                    <PostCard
                      title={post.data.title}
                      description={post.data.description}
                      date={post.data.date}
                      tags={post.data.tags}
                      href={`/teaching/${post.slug}/`}
                      gradient={section.gradient}
                      featured={post.data.featured}
                      section={sub.title}
                      sectionColor={sub.color}
                      image={firstImage(post.body) ?? undefined}
                    />
                  ))
                }
              </div>
            ) : (
              <div class="block-empty">
                <Icon name={sub.icon} size={14} />
                <span>这个栏目还没有文章，慢慢来。</span>
              </div>
            )
          }
        </div>
      ))
    }

    <!-- 其他教学文章 -->
    {
      posts.length > 0 && (
        <div class="block">
          <div class="block-head" style={`--c: ${section.color}`}>
            <span class="block-icon"><Icon name="book" size={15} /></span>
            <h2 class="block-title">其他笔记</h2>
            <span class="block-count">{posts.length} 篇</span>
          </div>
          <div class="grid dock-grid">
            {
              posts.map((post) => (
                <PostCard
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.date}
                  tags={post.data.tags}
                  href={`/teaching/${post.slug}/`}
                  gradient={section.gradient}
                  featured={post.data.featured}
                  section={section.title}
                  sectionColor={section.color}
                  image={firstImage(post.body) ?? undefined}
                />
              ))
            }
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .page-head {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }
  .page-head::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -10%;
    width: 60%;
    height: 140%;
    background: var(--gradient-soft);
    filter: blur(90px);
    opacity: 0.5;
    pointer-events: none;
  }
  .page-title {
    font-size: var(--text-2xl);
    margin-top: 0.35rem;
  }
  .list-body {
    padding-bottom: 4rem;
    max-width: 1320px;
  }

  /* ===== 子栏目长条框 ===== */
  .block + .block {
    margin-top: 2.25rem;
  }
  .block-head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1.25rem;
    margin-bottom: 1.25rem;
    border-radius: var(--radius-lg, 16px);
    background: linear-gradient(120deg, color-mix(in srgb, var(--c) 9%, transparent), color-mix(in srgb, var(--c) 4%, transparent));
    border: 1px solid var(--border);
    text-decoration: none;
    transition: border-color var(--speed) var(--ease), transform var(--speed) var(--ease);
  }
  a.block-head:hover {
    border-color: color-mix(in srgb, var(--c) 45%, transparent);
    transform: translateY(-1px);
  }
  .block-head-main {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .block-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    padding-left: 2.65rem;
  }
  .block-icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: linear-gradient(120deg, var(--c), color-mix(in srgb, var(--c) 65%, #fff));
  }
  .block-title {
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .block-count {
    margin-left: 0.25rem;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .block-go {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c);
  }
  .block-empty {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 1.1rem 1.5rem;
    border-radius: var(--radius-lg, 16px);
    border: 1px dashed var(--border);
    color: var(--text-tertiary);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }
  .empty {
    padding: 3rem 2rem;
    text-align: center;
  }
  .empty-title {
    font-size: var(--text-xl);
    font-weight: 600;
  }
  .empty code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--bg-glass);
    padding: 0.1rem 0.4rem;
    border-radius: 6px;
    border: 1px solid var(--border);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .block-count {
      display: none;
    }
  }
</style>
