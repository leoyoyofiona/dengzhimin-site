---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Typewriter from '../../../components/Typewriter.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

// 第一卷文章
const all = await getCollection('teaching');
const posts = all
  .filter((p) => !p.data.draft && p.slug.startsWith('maoxuan/juan1/'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-CN'));

// 按时期分组
const PERIODS = ['第一次国内革命战争时期', '第二次国内革命战争时期'];
const groups = PERIODS.map((period) => ({
  period,
  items: posts.filter((p) => p.data.period === period),
}));

const section = { title: '毛选学习', en: 'Teaching', color: '#b91c1c' };
---

<BaseLayout title="第一卷" description="《毛泽东选集》第一卷原文" gate="maoxuan">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">
        <a href="/teaching/maoxuan/">← 毛选学习</a>
      </p>
      <h1 class="display page-title">第一卷</h1>
      <Typewriter text="第一次国内革命战争时期 · 第二次国内革命战争时期" />
    </div>
  </section>

  <section class="container list-body">
    {
      groups.map((g) => (
        <div class="group">
          <div class="group-head">
            <span class="group-dot" style="background: #b91c1c" />
            <h2 class="group-title">{g.period}</h2>
            <span class="group-count">{g.items.length} 篇</span>
          </div>
          <div class="article-list">
            {
              g.items.map((post) => (
                <a class="article-item" href={`/teaching/${post.slug}/`}>
                  <span class="article-title">{post.data.title}</span>
                  <Icon name="arrow-right" size={14} />
                </a>
              ))
            }
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page-head {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }
  .page-head::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -10%;
    width: 60%;
    height: 140%;
    background: var(--gradient-soft);
    filter: blur(90px);
    opacity: 0.5;
    pointer-events: none;
  }
  .eyebrow a {
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    transition: color var(--speed) var(--ease);
  }
  .eyebrow a:hover {
    color: var(--accent);
  }
  .page-title {
    font-size: var(--text-2xl);
    margin-top: 0.35rem;
  }
  .list-body {
    padding-bottom: 4rem;
    max-width: 900px;
  }

  .group + .group {
    margin-top: 2.5rem;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .group-dot {
    align-self: center;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .group-title {
    font-size: var(--text-lg);
    font-weight: 650;
  }
  .group-count {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  .article-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .article-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-md, 12px);
    border: 1px solid var(--border);
    background: var(--bg-glass);
    text-decoration: none;
    transition: border-color var(--speed) var(--ease), background-color var(--speed) var(--ease);
  }
  .article-item:hover {
    border-color: color-mix(in srgb, #b91c1c 45%, transparent);
    background: color-mix(in srgb, #b91c1c 5%, transparent);
  }
  .article-title {
    font-size: var(--text-base);
    font-weight: 550;
    color: var(--text);
  }
  .article-item:hover .article-title {
    color: #b91c1c;
  }
  .article-item > :last-child {
    flex-shrink: 0;
    color: var(--text-tertiary);
  }
  .article-item:hover > :last-child {
    color: #b91c1c;
  }
</style>
