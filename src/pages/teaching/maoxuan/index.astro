---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Typewriter from '../../../components/Typewriter.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

// 毛选学习：读取 src/content/teaching/maoxuan/ 下的文章
const all = await getCollection('teaching');
const posts = all.filter((p) => !p.data.draft && p.slug.startsWith('maoxuan/'));

// 7 卷定义
const VOLUMES = [
  { n: 1, title: '第一卷', desc: '第一次国内革命战争时期 · 第二次国内革命战争时期', color: '#b91c1c' },
  { n: 2, title: '第二卷', desc: '抗日战争时期（上）', color: '#b45309' },
  { n: 3, title: '第三卷', desc: '抗日战争时期（下）', color: '#a16207' },
  { n: 4, title: '第四卷', desc: '第三次国内革命战争时期', color: '#166534' },
  { n: 5, title: '第五卷', desc: '社会主义革命和社会主义建设时期（一）', color: '#1e40af' },
  { n: 6, title: '第六卷', desc: '社会主义革命和社会主义建设时期（二）', color: '#6d28d9' },
  { n: 7, title: '第七卷', desc: '文化大革命时期', color: '#9f1239' },
];

// 每卷已有文章数
const volCounts = VOLUMES.map((v) => ({
  ...v,
  count: posts.filter((p) => p.data.juan === v.n).length,
}));

const section = { title: '黑/白板前的冥想', en: 'Teaching', color: '#3b82f6' };
---

<BaseLayout
  title="毛选学习"
  description={`毛选学习 —— 阅读《毛泽东选集》原文`}
  gate="maoxuan"
  noindex
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">
        <a href="/teaching/">← {section.title}</a>
      </p>
      <h1 class="display page-title">毛选学习</h1>
      <Typewriter text="通读原文，逐卷学习。这里只放原文，不作解读。" />
    </div>
  </section>

  <section class="container list-body">
    <p class="lead">
      《毛泽东选集》（1—7 卷全）原文阅读。按卷册组织，每卷内按历史时期分组。
    </p>

    <div class="vol-grid">
      {
        volCounts.map((v) => (
          <a class="vol-card" href={v.count > 0 ? `/teaching/maoxuan/juan/${v.n}/` : undefined} style={`--c: ${v.color}`}>
            <span class="vol-num">{v.n}</span>
            <div class="vol-info">
              <h2 class="vol-title">{v.title}</h2>
              <p class="vol-desc">{v.desc}</p>
              <span class="vol-count">
                {v.count > 0 ? `${v.count} 篇` : '待推送'}
              </span>
            </div>
            {
              v.count > 0 && (
                <span class="vol-go"><Icon name="arrow-right" size={14} /></span>
              )
            }
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }
  .page-head::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -10%;
    width: 60%;
    height: 140%;
    background: var(--gradient-soft);
    filter: blur(90px);
    opacity: 0.5;
    pointer-events: none;
  }
  .eyebrow a {
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    transition: color var(--speed) var(--ease);
  }
  .eyebrow a:hover {
    color: var(--accent);
  }
  .page-title {
    font-size: var(--text-2xl);
    margin-top: 0.35rem;
  }
  .list-body {
    padding-bottom: 4rem;
    max-width: 1000px;
  }
  .lead {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
  }

  /* ===== 卷册入口卡片 ===== */
  .vol-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  .vol-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius-lg, 18px);
    background: var(--bg-glass);
    border: 1px solid var(--border);
    text-decoration: none;
    transition: border-color var(--speed) var(--ease), transform var(--speed) var(--ease), box-shadow var(--speed) var(--ease);
  }
  a.vol-card:hover {
    border-color: color-mix(in srgb, var(--c) 45%, transparent);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--c) 10%, transparent);
  }
  .vol-card.is-empty {
    opacity: 0.6;
    cursor: default;
  }
  .vol-num {
    flex-shrink: 0;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-lg);
    font-weight: 700;
    color: #fff;
    background: linear-gradient(120deg, var(--c), color-mix(in srgb, var(--c) 65%, #fff));
  }
  .vol-info {
    flex: 1;
    min-width: 0;
  }
  .vol-title {
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .vol-desc {
    margin-top: 0.2rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vol-count {
    display: inline-block;
    margin-top: 0.3rem;
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }
  .vol-go {
    flex-shrink: 0;
    color: var(--c);
  }

  @media (max-width: 720px) {
    .vol-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
