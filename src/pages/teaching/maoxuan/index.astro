---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Typewriter from '../../../components/Typewriter.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';

// 毛选精读子栏目：读取 src/content/teaching/maoxuan/ 下的文章
const all = await getCollection('teaching');
const posts = all.filter((p) => !p.data.draft && p.slug.startsWith('maoxuan/'));

// 两个子栏目
const SUBS = [
  { key: 'heiban', title: '黑板前的冥想', desc: '站在黑板前，把经典讲清楚、想透彻', color: '#3b82f6', icon: 'book' },
  { key: 'baiban', title: '白板前的冥想', desc: '站在白板前，让想法自由生长、连成一片', color: '#0ea5e9', icon: 'doc' },
] as const;

const grouped = SUBS.map((sub) => ({
  ...sub,
  items: posts.filter((p) => p.data.sub === sub.key),
}));

const section = { title: '黑/白板前的冥想', en: 'Teaching', color: '#3b82f6' };
---

<BaseLayout
  title="毛选精读"
  description={`毛选精读 —— ${section.title}（${section.en}）子栏目`}
  gate="maoxuan"
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">
        <a href="/teaching/">← {section.title}</a>
      </p>
      <h1 class="display page-title">毛选精读</h1>
      <Typewriter text="一段一段读经典，把道理和自己的教学、研究对照起来。" />
    </div>
  </section>

  <section class="container list-body">
    <div class="sub-grid">
      {
        grouped.map((group) => (
          <a class="sub-card" href={`/teaching/maoxuan/${group.key}/`} style={`--c: ${group.color}`}>
            <div class="sub-head">
              <span class="sub-icon"><Icon name={group.icon} size={16} /></span>
              <h2 class="sub-title">{group.title}</h2>
              <span class="sub-count">{group.items.length} 篇</span>
            </div>
            <p class="sub-desc">{group.desc}</p>
            <div class="sub-foot">
              {
                group.items.length > 0 ? (
                  <span class="sub-latest">
                    最新：{group.items[0].data.title}
                  </span>
                ) : (
                  <span class="sub-latest sub-latest--empty">还没有文章，慢慢来</span>
                )
              }
              <span class="sub-go">进入 <Icon name="arrow-right" size={13} /></span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }
  .page-head::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -10%;
    width: 60%;
    height: 140%;
    background: var(--gradient-soft);
    filter: blur(90px);
    opacity: 0.5;
    pointer-events: none;
  }
  .eyebrow a {
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    transition: color var(--speed) var(--ease);
  }
  .eyebrow a:hover {
    color: var(--accent);
  }
  .page-title {
    font-size: var(--text-2xl);
    margin-top: 0.35rem;
  }
  .list-body {
    padding-bottom: 4rem;
    max-width: 1000px;
  }

  /* ===== 子栏目入口卡片 ===== */
  .sub-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .sub-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem 1.6rem;
    border-radius: var(--radius-lg, 18px);
    background: var(--bg-glass);
    border: 1px solid var(--border);
    transition: border-color var(--speed) var(--ease), transform var(--speed) var(--ease), box-shadow var(--speed) var(--ease);
  }
  .sub-card:hover {
    border-color: color-mix(in srgb, var(--c) 45%, transparent);
    transform: translateY(-2px);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--c) 10%, transparent);
  }
  .sub-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .sub-icon {
    flex-shrink: 0;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: linear-gradient(120deg, var(--c), color-mix(in srgb, var(--c) 65%, #fff));
  }
  .sub-title {
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .sub-count {
    margin-left: auto;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  .sub-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .sub-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }
  .sub-latest {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sub-latest--empty {
    font-style: italic;
  }
  .sub-go {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--c);
    flex-shrink: 0;
  }

  @media (max-width: 720px) {
    .sub-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
