---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Typewriter from '../components/Typewriter.astro';
import { SITE } from '../lib/site';
---

<BaseLayout title="留言板" description={`在 ${SITE.name} 的留言板说点什么。`}>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Guestbook</p>
      <h1 class="display page-title">留言板</h1>
      <Typewriter text="想说什么就说什么。留个言，证明你来过。" />
    </div>
  </section>

  <section class="container board-body">
    <div class="compose card">
      <div class="compose-head">
        <span class="compose-icon"><Icon name="message" size={18} /></span>
        <h2 class="compose-title">留言板</h2>
        <span class="compose-note">所有访客的留言在这里共享，需要 GitHub 账号登录后留言。</span>
      </div>

      <!-- Utterances 评论组件：所有访客共享，存储于 GitHub Issues -->
      <div class="utterances-wrap">
        <script
          src="https://utteranc.es/client.js"
          repo="leoyoyofiona/dengzhimin-site"
          issue-term="pathname"
          label="guestbook"
          theme="preferred-color-scheme"
          crossorigin="anonymous"
          async
        >
        </script>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }
  .page-head::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -10%;
    width: 60%;
    height: 140%;
    background: var(--gradient-soft);
    filter: blur(90px);
    opacity: 0.5;
    pointer-events: none;
  }
  .page-title {
    font-size: var(--text-2xl);
    margin-top: 0.35rem;
  }

  .board-body {
    padding-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 760px;
  }

  .compose {
    padding: 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .compose-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .compose-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--gradient);
    color: #fff;
    flex-shrink: 0;
  }
  .compose-title {
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .compose-note {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    margin-left: auto;
    max-width: 24rem;
    text-align: right;
  }

  /* Utterances 适配站点主题 */
  .utterances-wrap {
    width: 100%;
  }
  .utterances-wrap iframe {
    border: none;
    width: 100% !important;
    max-width: 100%;
  }
  .utterances {
    max-width: 100% !important;
  }

  @media (max-width: 560px) {
    .compose-note {
      margin-left: 0;
      text-align: left;
      width: 100%;
    }
  }
</style>
