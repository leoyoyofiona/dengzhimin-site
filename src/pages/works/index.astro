---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Typewriter from '../../components/Typewriter.astro';
import { SITE } from '../../lib/site';
import { works } from '../../data/works';
---

<BaseLayout title="si码如山" description="LEODENG 的作品集——一些折腾出来的小东西，代码都在 GitHub 上。">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Works</p>
      <h1 class="display page-title">si码如山</h1>
      <Typewriter text="一些折腾出来的小东西，代码都在 GitHub 上。鼠标放上去，翻个面看看。" class="page-sub secondary tw-nowrap" />
    </div>
  </section>

  <section class="container list-body">
    <div class="works-grid">
      {
        works.map((w) => (
          <div class="flip">
            <div class="flip-inner">
              <!-- 正面：海报 + 简介 -->
              <div class="flip-face flip-front card">
                {w.poster && (
                  <div class="work-poster">
                    <img src={`/images/works/${w.poster}`} alt={`${w.title} 海报`} loading="lazy" />
                  </div>
                )}
                <div class="work-body">
                  <div class="work-head">
                    <h3 class="work-title">{w.title}</h3>
                  </div>
                  <p class="work-desc">{w.description}</p>
                  <div class="work-tags">
                    {w.tags.slice(0, 3).map((t) => (
                      <span class="badge">{t}</span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- 背面：动态演示（GIF）或高清图 + 操作按钮 -->
              <div class="flip-face flip-back card">
                <div class="back-media">
                  {w.demo ? (
                    <img
                      class="back-demo"
                      src={`/images/works/${w.demo}`}
                      alt={`${w.title} 动态演示`}
                      loading="lazy"
                    />
                  ) : (
                    <img
                      src={w.posterHd ? `/images/works/hd/${w.posterHd}` : (w.poster ? `/images/works/${w.poster}` : '')}
                      alt={`${w.title} 全貌`}
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="back-actions">
                  <h3 class="back-title">{w.title}</h3>
                  <div class="back-row">
                    {
                      w.site ? (
                        <a class="btn btn-primary" href={w.site} target="_blank" rel="noopener noreferrer">
                          <Icon name="external" size={15} />访问作品
                        </a>
                      ) : (
                        <a class="btn btn-primary" href={w.url} target="_blank" rel="noopener noreferrer">
                          <Icon name="github" size={15} />查看仓库
                        </a>
                      )
                    }
                    <button
                      class="like-btn"
                      data-like={w.title}
                      aria-label={`给「${w.title}」点赞`}
                      aria-pressed="false"
                    >
                      <Icon name="heart" size={16} />
                      <span class="like-count">0</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="github-cta">
      <p class="secondary">想看全部代码？</p>
      <a
        class="btn btn-primary"
        href={`https://github.com/${SITE.github}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="github" size={18} />访问我的 GitHub
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const LIKES_KEY = 'leodeng-likes';

  function loadLikes() {
    try {
      return JSON.parse(localStorage.getItem(LIKES_KEY) || '{}');
    } catch (e) {
      return {};
    }
  }
  function saveLikes(map) {
    try {
      localStorage.setItem(LIKES_KEY, JSON.stringify(map));
    } catch (e) {
      /* ignore */
    }
  }

  const likes = loadLikes();
  document.querySelectorAll('.like-btn').forEach(function (btn) {
    const key = btn.dataset.like;
    const countEl = btn.querySelector('.like-count');
    // 初始：本机已点赞数
    const likedCount = likes[key] || 0;
    countEl.textContent = String(likedCount > 0 ? likedCount : 0);
    if (likedCount > 0) {
      btn.classList.add('liked');
      btn.setAttribute('aria-pressed', 'true');
    }
    btn.addEventListener('click', function () {
      const isLiked = btn.classList.toggle('liked');
      btn.setAttribute('aria-pressed', String(isLiked));
      const cur = likes[key] || 0;
      const next = isLiked ? cur + 1 : Math.max(0, cur - 1);
      likes[key] = next;
      countEl.textContent = String(next);
      saveLikes(likes);
    });
  });
</script>

<style>
  .page-head {
    position: relative;
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }
  .page-head::before {
    content: '';
    position: absolute;
    top: -40%;
    left: -10%;
    width: 60%;
    height: 140%;
    background: var(--gradient-soft);
    filter: blur(90px);
    opacity: 0.5;
    pointer-events: none;
  }
  .page-title {
    font-size: var(--text-2xl);
    margin-top: 0.35rem;
  }
  .page-sub {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .list-body {
    padding-bottom: 4rem;
    max-width: 1320px;
  }
  .works-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    perspective: 1200px;
  }

  /* ===== 3D 翻转卡片 ===== */
  .flip {
    position: relative;
    aspect-ratio: 4 / 4.4;
    perspective: 1200px;
  }
  .flip-inner {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease-out);
  }
  .flip:hover .flip-inner {
    transform: rotateY(180deg);
  }
  .flip-face {
    position: absolute;
    inset: 0;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(24px);
    backdrop-filter: saturate(180%) blur(24px);
  }
  .flip-back {
    transform: rotateY(180deg);
  }

  /* 正面 */
  .work-poster {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-glass);
  }
  .work-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .work-body {
    padding: 1rem 1.2rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .work-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .work-title {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  /* 爱心点赞按钮 */
  .like-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.16);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
    flex-shrink: 0;
    transition:
      color 0.28s var(--ease-out),
      border-color 0.28s var(--ease-out),
      background-color 0.28s var(--ease-out),
      transform 0.28s var(--ease-out);
  }
  .like-btn:hover {
    border-color: rgba(255, 55, 95, 0.7);
    transform: scale(1.06);
  }
  .like-btn.liked {
    color: #fff;
    border-color: #ff375f;
    background: #ff375f;
  }
  .like-btn.liked svg {
    fill: currentColor;
  }
  .like-btn svg {
    transition: transform 0.28s var(--ease-out);
  }
  .like-btn:active svg {
    transform: scale(1.35);
  }
  .work-desc {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .work-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  /* 背面 */
  .back-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--bg-glass);
  }
  .back-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* 动态演示 GIF：完整显示，铺满留白 */
  .back-media .back-demo {
    object-fit: cover;
  }
  .back-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.15) 45%, transparent 70%);
  }
  .back-actions {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
    z-index: 1;
  }
  .back-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: #fff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }
  .back-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    width: 100%;
  }

  .github-cta {
    margin-top: 3rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 1000px) {
    .works-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .works-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
