---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="页面未找到" noindex>
  <section class="nf">
    <div class="nf-inner">
      <p class="nf-code gradient-text">404</p>
      <h1 class="nf-title">页面不见了</h1>
      <p class="nf-sub secondary">你访问的页面可能已被移动、删除，或从未存在。</p>
      <div class="nf-actions">
        <a class="btn btn-primary" href="/"><Icon name="arrow-right" size={16} />回到首页</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    place-items: center;
    min-height: 70vh;
    padding: 2rem;
  }
  .nf-inner {
    text-align: center;
    max-width: 26rem;
  }
  .nf-code {
    font-size: clamp(5rem, 18vw, 9rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .nf-title {
    font-size: var(--text-3xl);
    margin-top: 1.5rem;
  }
  .nf-sub {
    margin-top: 0.75rem;
  }
  .nf-actions {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
  }
</style>
