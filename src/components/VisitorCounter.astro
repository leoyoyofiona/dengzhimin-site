---
import Icon from './Icon.astro';

interface Props {
  /** 显示变体：header=导航栏内联，home=首页顶部独立胶囊，footer=页脚行内 */
  variant?: 'home' | 'footer' | 'header';
  /** 自定义 id（同页多实例时避免冲突） */
  id?: string;
}
const { variant = 'footer', id = 'visitor-counter' } = Astro.props;
---

<span class:list={['visitor-counter', `vc-${variant}`]} id={id} title="访问统计">
  <Icon name="eye" size={variant === 'home' ? 14 : 13} />
  <span class="vc-text">访问中…</span>
</span>

<style>
  .visitor-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-tertiary);
  }
  .vc-text {
    font-variant-numeric: tabular-nums;
  }

  /* 首页顶部：独立胶囊，居中显示 */
  .vc-home {
    margin-inline: auto;
    padding: 0.6rem 1.4rem;
    border-radius: var(--radius-full);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
    box-shadow: var(--shadow-sm);
    font-size: var(--text-base);
    font-weight: 550;
    color: var(--text);
    white-space: nowrap;
  }
  .vc-home svg {
    color: var(--accent);
  }

  /* 导航栏内联：紧凑、与免责声明对齐 */
  .vc-header {
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .vc-header svg {
    color: var(--accent);
  }
  @media (max-width: 1080px) {
    /* 较窄屏隐藏"访问/浏览"文字精简显示 */
    .vc-header .vc-text {
      max-width: 7em;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .vc-header {
      font-size: 0.7rem;
      padding: 0.28rem 0.4rem;
    }
  }
  @media (max-width: 1024px) {
    /* 移动端：导航隐藏，Header 计数器一并隐藏（页脚仍有） */
    .vc-header {
      display: none;
    }
  }
</style>

<script>
  // ===== 访问统计：上报 + 显示（访客数 / 浏览次数） =====
  // 优先显示全站统计（Cloudflare API）；大陆等地区连不上 API 时（被墙）
  // 自动降级为本机累计，避免请求长时间挂起。
  // Astro 会把组件脚本打包为单份执行，因此用 querySelectorAll 遍历页面上所有实例
  import { probeApi, fetchWithTimeout } from '../lib/netcheck';
  (function () {
    const API = 'https://1303737693-hqp1nw586s.ap-shanghai.tencentscf.com/api/visits';
    const uidKey = 'leodeng:visitor-uid';
    const localKey = 'leodeng:visits-local';

    function getUid() {
      try {
        let uid = localStorage.getItem(uidKey);
        if (!uid) {
          uid =
            (crypto.randomUUID && crypto.randomUUID()) ||
            'v-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
          localStorage.setItem(uidKey, uid);
        }
        return uid;
      } catch (_) {
        return '';
      }
    }

    function fmt(n) {
      if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
      if (n >= 10000) return (n / 10000).toFixed(1) + 'w';
      return String(n);
    }

    // 本机累计访问（每次页面加载 +1）+ 本机今日浏览，作为 API 不可用时的兜底
    function vcTodayKey() {
      try {
        const d = new Date(Date.now() + 8 * 3600 * 1000);
        return d.toISOString().slice(0, 10);
      } catch (_) { return ''; }
    }
    let localVisits = 0;
    let localToday = 0;
    try {
      localVisits = (parseInt(localStorage.getItem(localKey), 10) || 0) + 1;
      localStorage.setItem(localKey, String(localVisits));
      const tk = vcTodayKey();
      const tKey = localKey + ':day';
      try {
        const s = JSON.parse(localStorage.getItem(tKey) || '{}');
        localToday = s && s.date === tk ? (Number(s.count) || 0) + 1 : 1;
        localStorage.setItem(tKey, JSON.stringify({ date: tk, count: localToday }));
      } catch (_) { localToday = 1; }
    } catch (_) {}

    function showLocal(text, counter) {
      text.textContent = '累计访问 1 人 · 累计浏览 ' + fmt(Math.max(localVisits, 1)) + ' 次 · 今日浏览 ' + fmt(Math.max(localToday, 1)) + ' 次';
      counter.title = '全站统计暂不可用，当前为本机累计';
    }

    function init(counter) {
      if (!counter) return;
      const text = counter.querySelector('.vc-text');
      if (!text) return;

      async function report(attempt = 0) {
        try {
          const res = await fetchWithTimeout(API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ uid: getUid() }),
          });
          if (!res.ok) throw new Error('bad status');
          const data = await res.json();
          text.textContent = '累计访问 ' + fmt(data.visitors || 0) + ' 人 · 累计浏览 ' + fmt(data.views || 0) + ' 次 · 今日浏览 ' + fmt(data.todayViews || 0) + ' 次';
        } catch (_) {
          // 网络偶发抖动重试一次；仍失败（或被墙）则本机累计
          if (attempt < 1) {
            setTimeout(function () {
              report(attempt + 1);
            }, 2500);
            return;
          }
          showLocal(text, counter);
        }
      }
      // 立即显示本机计数（保证秒开），再探测 API；可达才拉全站统计
      showLocal(text, counter);
      probeApi().then((mode) => {
        if (mode === 'cloud') report();
      });
    }

    document.querySelectorAll('.visitor-counter').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = '1';
      init(el);
    });
  })();
</script>
