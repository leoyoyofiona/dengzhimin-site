---
import Icon from './Icon.astro';
import { formatDate } from '../lib/site';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  href: string;
  gradient?: string;
  featured?: boolean;
  section?: string;
  sectionColor?: string;
  image?: string;
  'data-topics'?: string;
}
const {
  title,
  description,
  date,
  tags = [],
  href,
  gradient,
  featured = false,
  section = '',
  sectionColor = 'var(--accent)',
  image = '',
  'data-topics': dataTopics,
} = Astro.props;
---

<a
  class="card card-hover post-card"
  href={href}
  style={`--card-grad: ${gradient ?? 'var(--gradient)'}; --sec-c: ${sectionColor}`}
  data-topics={dataTopics}
>
  {image && (
    <div class="pc-cover">
      <img src={image} alt="" loading="lazy" />
      {featured && (
        <span class="badge badge-accent pc-featured"><Icon name="sparkles" size={12} />精选</span>
      )}
    </div>
  )}
  <div class="post-top">
    <span class="sec-badge">{section || '随笔'}</span>
    <time class="post-date"><Icon name="calendar" size={14} />{formatDate(date)}</time>
  </div>
  <h3 class="post-title">{title}</h3>
  <p class="post-desc">{description}</p>
  <div class="post-foot">
    {tags.length > 0 && (
      <div class="tags">
        {tags.slice(0, 3).map((t) => (
          <span class="badge">{t}</span>
        ))}
      </div>
    )}
    <span class="read-more">阅读 <Icon name="arrow-right" size={14} /></span>
  </div>
</a>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.9rem 2rem;
    overflow: hidden;
    text-decoration: none;
  }
  .post-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--card-grad, var(--gradient));
    opacity: 0.32;
  }
  .pc-cover {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: -1.9rem -2rem 0.35rem;
    overflow: hidden;
    background: var(--bg-glass);
  }
  .pc-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-out);
  }
  .post-card:hover .pc-cover img {
    transform: scale(1.06);
  }
  .pc-featured {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    z-index: 3; /* 确保不被封面图或标题遮挡 */
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }
  .post-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .sec-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.18rem 0.6rem;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--sec-c);
    background: color-mix(in srgb, var(--sec-c) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--sec-c) 30%, transparent);
    white-space: nowrap;
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sec-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sec-c);
    flex-shrink: 0;
  }
  .post-date {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
  .post-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .post-desc {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .post-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-tertiary);
    white-space: nowrap; /* 防止"阅读"两字被拆成上下排 */
    flex-shrink: 0;
    transition: color var(--speed) var(--ease), gap var(--speed) var(--ease);
    margin-left: auto;
  }
  .post-card:hover .read-more {
    color: var(--accent);
    gap: 0.6rem;
  }
</style>
