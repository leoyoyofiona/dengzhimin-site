---
import Icon from './Icon.astro';
import { formatDate } from '../lib/site';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  href: string;
  gradient?: string;
  featured?: boolean;
  section?: string;
  sectionColor?: string;
  image?: string;
  'data-topics'?: string;
}
const {
  title,
  description,
  date,
  tags = [],
  href,
  gradient,
  featured = false,
  section = '',
  sectionColor = 'var(--accent)',
  image = '',
  'data-topics': dataTopics,
} = Astro.props;
---

<a
  class="card card-hover post-card"
  href={href}
  style={`--card-grad: ${gradient ?? 'var(--gradient)'}; --sec-c: ${sectionColor}`}
  data-topics={dataTopics}
>
  {image && (
    <div class="pc-cover">
      <img src={image} alt="" loading="lazy" />
    </div>
  )}
  <button
    class="pc-fav"
    type="button"
    aria-label="收藏这篇文章"
    title="收藏"
    data-url={href}
    data-title={title}
    data-section={section}
    data-color={sectionColor}
    data-date={date.toISOString().slice(0, 10)}
  >
    <Icon name="heart" size={15} />
  </button>
  <div class="post-top">
    <span class="sec-badge">{section || '随笔'}</span>
    <time class="post-date"><Icon name="calendar" size={14} />{formatDate(date)}</time>
  </div>
  <h3 class="post-title">{title}</h3>
  <p class="post-desc">{description}</p>
  <div class="post-foot">
    {tags.length > 0 && (
      <div class="tags">
        {tags.slice(0, 3).map((t) => (
          <span class="badge">{t}</span>
        ))}
      </div>
    )}
    <span class="read-more">阅读 <Icon name="arrow-right" size={14} /></span>
  </div>
</a>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.9rem 2rem;
    overflow: hidden;
    text-decoration: none;
  }
  .post-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--card-grad, var(--gradient));
    opacity: 0.32;
  }
  .pc-cover {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: -1.9rem -2rem 0.35rem;
    overflow: hidden;
    background: var(--bg-glass);
  }
  .pc-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-out);
  }
  .post-card:hover .pc-cover img {
    transform: scale(1.06);
  }
  .post-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .sec-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.18rem 0.6rem;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--sec-c);
    background: var(--bg-glass);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
    border: 1px solid color-mix(in srgb, var(--sec-c) 30%, var(--border));
    white-space: nowrap;
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  html[data-theme="dark"] .sec-badge {
    color: color-mix(in srgb, var(--sec-c) 55%, #ffffff);
  }
  html[data-theme="dark"] .sec-badge::before {
    background: color-mix(in srgb, var(--sec-c) 70%, #ffffff);
  }
  .sec-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sec-c);
    flex-shrink: 0;
  }
  .post-date {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
  .post-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .post-desc {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .post-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-tertiary);
    white-space: nowrap; /* 防止"阅读"两字被拆成上下排 */
    flex-shrink: 0;
    transition: color var(--speed) var(--ease), gap var(--speed) var(--ease);
    margin-left: auto;
  }
  .post-card:hover .read-more {
    color: var(--accent);
    gap: 0.6rem;
  }

  /* ===== 卡片快捷收藏按钮（右上角） ===== */
  .pc-fav {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
    color: var(--text-tertiary);
    cursor: pointer;
    opacity: 0;
    transform: translateY(-4px) scale(0.9);
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.25s var(--ease-out),
      color var(--speed) var(--ease),
      background-color var(--speed) var(--ease),
      border-color var(--speed) var(--ease);
    box-shadow: var(--shadow-sm);
  }
  .post-card:hover .pc-fav,
  .pc-fav:focus-visible,
  .pc-fav.is-faved {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .pc-fav:hover {
    color: #e11d48;
    border-color: color-mix(in srgb, #e11d48 50%, transparent);
    background: color-mix(in srgb, #e11d48 8%, transparent);
  }
  .pc-fav.is-faved {
    color: #e11d48;
    border-color: color-mix(in srgb, #e11d48 60%, transparent);
    background: color-mix(in srgb, #e11d48 12%, transparent);
  }
  .pc-fav.is-faved svg {
    fill: currentColor;
  }
  .pc-fav svg {
    transition: transform 0.25s var(--ease-out);
  }
  .pc-fav.is-faved svg {
    animation: pc-fav-pop 0.35s var(--ease-out);
  }
  @keyframes pc-fav-pop {
    0% {
      transform: scale(0.6);
    }
    60% {
      transform: scale(1.3);
    }
    100% {
      transform: scale(1);
    }
  }
  @media (hover: none) {
    /* 触屏：始终显示收藏按钮 */
    .pc-fav {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  // ===== 卡片快捷收藏（本地 + 云端按访客 uid 同步） =====
  import { FAV_KEY, HIST_KEY, readLocal, writeLocal, fetchCloud, pushCloud, mergeCloud, getUid } from '../lib/favcloud';
  // 初始化：标记已收藏的卡片，并从云端拉取合并
  const favBtns = document.querySelectorAll('.pc-fav');
  if (favBtns.length > 0) {
    let favs = readLocal(FAV_KEY);
    const history = readLocal(HIST_KEY);
    // 用户本次会话是否操作过收藏：操作后不再用云端旧数据覆盖本地
    let touched = false;
    // 云端合并（收藏按 uid 独立，换设备也能恢复）
    fetchCloud().then((cloud) => {
      if (touched || !cloud) return;
      const merged = mergeCloud(favs, history, cloud);
      favs = merged.favs;
      writeLocal(FAV_KEY, favs);
      writeLocal(HIST_KEY, merged.history);
      favBtns.forEach((btn) => {
        const url = btn.dataset.url;
        if (favs.some((f) => f.url === url)) {
          btn.classList.add('is-faved');
          btn.setAttribute('aria-label', '取消收藏');
          btn.title = '取消收藏';
        }
      });
    });
    favBtns.forEach((btn) => {
      const url = btn.dataset.url;
      if (favs.some((f) => f.url === url)) {
        btn.classList.add('is-faved');
        btn.setAttribute('aria-label', '取消收藏');
        btn.title = '取消收藏';
      }
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        touched = true;
        const rec = {
          url,
          title: btn.dataset.title,
          section: btn.dataset.section,
          color: btn.dataset.color,
          date: btn.dataset.date,
          time: Date.now(),
        };
        favs = readLocal(FAV_KEY);
        const i = favs.findIndex((f) => f.url === url);
        if (i >= 0) {
          favs.splice(i, 1);
          btn.classList.remove('is-faved');
          btn.setAttribute('aria-label', '收藏这篇文章');
          btn.title = '收藏';
        } else {
          favs.unshift(rec);
          btn.classList.add('is-faved');
          btn.setAttribute('aria-label', '取消收藏');
          btn.title = '取消收藏';
        }
        writeLocal(FAV_KEY, favs);
        pushCloud(favs, readLocal(HIST_KEY));
      });
    });
  }
</script>
