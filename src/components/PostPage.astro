---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { SECTIONS, formatDate, type Section } from '../lib/site';

interface Props {
  slug: Section['slug'];
  post: CollectionEntry<'teaching' | 'research' | 'work' | 'life' | 'papers' | 'github'>;
  /** 访问口令门：site=全站门（默认），maoxuan=毛选学习独立门 */
  gate?: 'site' | 'maoxuan';
}
const { slug, post, gate = 'site' } = Astro.props;
const section = SECTIONS.find((s) => s.slug === slug)!;
const { Content } = await post.render();
const postUrl = `/${slug}/${post.slug}/`;
// 毛选文章归属"毛选学习"栏目（而非教学笔记）
const isMaoxuanPost = post.slug.startsWith('maoxuan/');
const postSection = isMaoxuanPost ? '毛选学习' : section.title;
const postColor = isMaoxuanPost ? '#b91c1c' : section.color;
---

<BaseLayout title={post.data.title} description={post.data.description} gate={gate} noindex={isMaoxuanPost}>
  <article class="article">
    <div class="container">
      <header class="article-head">
        <a class="back" href={`/${slug}/`}>
          <span class="back-arrow"><Icon name="arrow-right" size={16} /></span>
          返回{section.title}
        </a>
        <h1 class="display article-title">{post.data.title}</h1>
        <p class="article-desc secondary">{post.data.description}</p>
        <div class="article-meta">
          <time class="meta-time"><Icon name="calendar" size={15} />{formatDate(post.data.date)}</time>
          {post.data.tags.map((t) => (
            <span class="badge">{t}</span>
          ))}
          <button
            class="fav-btn"
            id="fav-btn"
            type="button"
            data-url={postUrl}
            data-title={post.data.title}
            data-section={postSection}
            data-color={postColor}
            data-date={post.data.date.toISOString().slice(0, 10)}
            aria-pressed="false"
            title="收藏这篇文章"
          >
            <Icon name="heart" size={15} />
            <span class="fav-label">收藏</span>
          </button>
        </div>
      </header>

      <div class:list={['prose', { 'prose-maoxuan': post.slug.startsWith('maoxuan/') }]}>
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // ===== 毛选学习：正文 〔n〕 角标 → 可点击上标，点击滚动到文末对应注释条目 =====
  const prose = document.querySelector('.prose-maoxuan');
  if (prose) {
    const paras = Array.from(prose.querySelectorAll('p'));

    // 注释区起点：第一个含"注　　释"标记的段落（该标记常与正文同行或紧跟 〔1〕）
    const NOTE_RE = /注[\s\u3000]*释[\s\u3000]*(\*|〔\d+〕)/;
    let noteStart = paras.findIndex((p) => NOTE_RE.test(p.textContent || ''));

    // 正文角标 → 上标
    const toSup = (t) => t.replace(/〔(\d+)〕/g, '<sup class="fn-ref" data-fn="$1">〔$1〕</sup>');
    // 注释条目角标 → 锚点（可被正文角标滚动定位）
    const toAnchor = (t) => t.replace(/〔(\d+)〕/g, '<span class="note-anchor" data-fn="$1">〔$1〕</span>');
    // 注释标题行加样式（"注　　释*"）
    const titleHtml = (t) =>
      t
        .replace(/^注[\s\u3000]*释[\s\u3000]*\*?/, '<span class="notes-title">$&</span>')
        .replace(/〔(\d+)〕/g, '<span class="note-anchor" data-fn="$1">〔$1〕</span>');

    if (noteStart >= 0) {
      // 起点段：标记之前是正文（若同一段），标记之后进入注释区
      const first = paras[noteStart];
      const ft = first.textContent || '';
      const m = ft.match(NOTE_RE);
      if (m && m.index > 0) {
        const head = ft.slice(0, m.index);
        const tail = ft.slice(m.index);
        let html = head.replace(/〔(\d+)〕/g, '<sup class="fn-ref" data-fn="$1">〔$1〕</sup>');
        if (/〔\d+〕/.test(tail)) html += titleHtml(tail);
        else html += tail.replace(/^注[\s\u3000]*释[\s\u3000]*\*?/, '<span class="notes-title">$&</span>');
        first.innerHTML = html;
      } else {
        // 标记在段首：整段为注释区（标题 + 可能的首条注释）
        first.innerHTML = titleHtml(ft);
      }
      // 起点段之后的段落：全部按注释区处理
      for (let i = noteStart + 1; i < paras.length; i++) {
        const t = paras[i].textContent || '';
        if (/〔\d+〕/.test(t)) paras[i].innerHTML = toAnchor(t);
      }
      // 正文段落（注释区之前）
      for (let i = 0; i < noteStart; i++) {
        const t = paras[i].textContent || '';
        if (/〔\d+〕/.test(t)) paras[i].innerHTML = toSup(t);
      }
    } else {
      // 没有"注　　释"标记：全文都当正文处理
      paras.forEach((p) => {
        const t = p.textContent || '';
        if (/〔\d+〕/.test(t)) p.innerHTML = toSup(t);
      });
    }

    // ===== 注释跳转 + 返回 =====
    // 记录"从哪个角标跳过来"，用于返回
    let jumpSource = null; // 来源角标元素（fn-ref）
    let backBtn = null; // 注释锚点旁的"返回"按钮
    let floatBackBtn = null; // 右下角固定悬浮"返回原文"按钮

    // 移除返回按钮（内联 + 悬浮）
    function removeBackBtn() {
      if (backBtn && backBtn.parentNode) backBtn.parentNode.removeChild(backBtn);
      backBtn = null;
      if (floatBackBtn && floatBackBtn.parentNode) floatBackBtn.parentNode.removeChild(floatBackBtn);
      floatBackBtn = null;
    }

    // 创建右下角固定"返回原文"悬浮按钮（注释很长、滚动阅读后仍可返回）
    function addFloatBackBtn(fn) {
      if (floatBackBtn) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'fn-float-back';
      btn.setAttribute('aria-label', '返回正文阅读位置');
      btn.innerHTML = '<span class="fn-back-arrow" aria-hidden="true">↺</span> 返回原文';
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        goBack();
      });
      document.body.appendChild(btn);
      floatBackBtn = btn;
    }

    // 在注释锚点后插入"返回"按钮
    function addBackBtn(afterEl, fn) {
      removeBackBtn();
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'fn-back';
      btn.setAttribute('aria-label', `返回正文〔${fn}〕处`);
      btn.innerHTML = '返回 <span class="fn-back-arrow" aria-hidden="true">↺</span>';
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        goBack();
      });
      afterEl.parentNode.insertBefore(btn, afterEl.nextSibling);
      backBtn = btn;
      // 同时显示右下角悬浮返回按钮
      addFloatBackBtn(fn);
    }

    // 返回原文阅读位置
    function goBack() {
      removeBackBtn();
      const src = jumpSource;
      jumpSource = null;
      if (!src) return;
      src.scrollIntoView({ behavior: 'smooth', block: 'center' });
      // 高亮来源角标，提醒阅读位置
      src.classList.add('fn-return-highlight');
      setTimeout(() => src.classList.remove('fn-return-highlight'), 2200);
    }

    // 统一跳转：滚动到目标锚点 + 高亮 + 插入返回按钮
    function jumpToNote(target, source) {
      if (!target) return;
      jumpSource = source || null;
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.classList.add('note-highlight');
      setTimeout(() => target.classList.remove('note-highlight'), 2000);
      // 在锚点后插入"返回"按钮（同一段落多条注释时锚点在段中，按钮跟随其后）
      addBackBtn(target, target.dataset.fn);
    }

    // 点击正文角标 → 滚动到对应注释锚点并高亮
    prose.addEventListener('click', (e) => {
      const el = e.target.closest('.fn-ref');
      if (!el) return;
      e.preventDefault();
      const fn = el.dataset.fn;
      const target = prose.querySelector(`.note-anchor[data-fn="${fn}"]`);
      if (target) {
        jumpToNote(target, el);
      } else {
        // 本篇注释缺失（部分文章注释在原始资料中即不完整）
        el.classList.add('fn-missing');
        setTimeout(() => el.classList.remove('fn-missing'), 1600);
      }
    });

    // 注释条目锚点也可点击：跳到同号其他锚点（用于注释内"见注〔n〕"交叉引用）
    prose.addEventListener('click', (e) => {
      // 点击"返回"按钮时不触发锚点跳转
      if (e.target.closest('.fn-back')) return;
      const anchor = e.target.closest('.note-anchor');
      if (!anchor) return;
      const fn = anchor.dataset.fn;
      const siblings = [...prose.querySelectorAll(`.note-anchor[data-fn="${fn}"]`)];
      if (siblings.length > 1) {
        // 点击的是引用（非第一条定义处）→ 跳转到第一条
        const target = siblings[0];
        if (target !== anchor) {
          e.preventDefault();
          jumpToNote(target, anchor);
        }
      }
    });
  }

  // ===== 收藏 + 浏览历史（本地 + 云端按访客 uid 同步） =====
  import { FAV_KEY, HIST_KEY, readLocal, writeLocal, fetchCloud, pushCloud, mergeCloud, syncCloud } from '../lib/favcloud';

  // 用户本次会话是否操作过收藏：操作后不再用云端旧数据覆盖本地
  let touched = false;
  // 本会话取消收藏的 url（推送时从云端合并结果中剔除，防止旧数据"复活"）
  const sessionRemoved = new Set<string>();
  // 云端合并基准（单次拉取）：页面加载把云端并到本地，用户操作为基准
  const cloudReady = fetchCloud().then((cloud) => {
    const merged = mergeCloud(readLocal(FAV_KEY), readLocal(HIST_KEY), cloud);
    writeLocal(FAV_KEY, merged.favs);
    writeLocal(HIST_KEY, merged.history);
    return merged;
  }).catch(() => ({ favs: readLocal(FAV_KEY), history: readLocal(HIST_KEY) }));

  const favBtn = document.getElementById('fav-btn');
  if (favBtn) {
    const url = favBtn.dataset.url;
    const rec = {
      url,
      title: favBtn.dataset.title,
      section: favBtn.dataset.section,
      color: favBtn.dataset.color,
      date: favBtn.dataset.date,
      time: Date.now(),
    };

    function setFavUi(faved: boolean) {
      favBtn.classList.toggle('is-faved', faved);
      favBtn.setAttribute('aria-pressed', String(faved));
      favBtn.title = faved ? '取消收藏' : '收藏这篇文章';
      const label = favBtn.querySelector('.fav-label');
      if (label) label.textContent = faved ? '已收藏' : '收藏';
    }
    // 本地已有收藏则立即标红（保证即时反馈，不等云端）
    if (readLocal(FAV_KEY).some((f) => f.url === url)) setFavUi(true);
    // 云端合并完成后校对一次（换设备恢复场景）
    cloudReady.then((merged) => {
      if (touched) return;
      if (merged.favs.some((f) => f.url === url)) setFavUi(true);
    });

    favBtn.addEventListener('click', () => {
      touched = true;
      // 立即基于本地状态切换并反馈（本地就是权威：取消/收藏都即时生效）
      const localFavs = readLocal(FAV_KEY);
      const i = localFavs.findIndex((f) => f.url === url);
      if (i >= 0) {
        localFavs.splice(i, 1);
        sessionRemoved.add(url);
        setFavUi(false);
      } else {
        localFavs.unshift({ ...rec });
        sessionRemoved.delete(url);
        setFavUi(true);
      }
      writeLocal(FAV_KEY, localFavs);
      // 推送云端：等合并基准完成后，合并云端项并剔除本会话删除项，防清零/防复活
      cloudReady.then((base) => {
        const latest = readLocal(FAV_KEY);
        // 以本地最新为准，补上云端有而本地没有的（非本会话删除项）
        const finalFavs = mergeCloud(latest, [], { favs: base.favs, history: [] }).favs.filter(
          (f) => !sessionRemoved.has(f.url),
        );
        writeLocal(FAV_KEY, finalFavs);
        pushCloud(finalFavs, readLocal(HIST_KEY));
        // 同步 UI（云端补充项不影响当前按钮状态，按钮已按本地设置）
      });
    });
  }

  // 浏览历史：去重，最多保留 60 条（本地 + 云端）
  // 注意：先合并云端再写本地并推送，避免页面加载早期本地为空时
  // 用空数据覆盖云端导致收藏/足迹清零。
  const histUrl = window.location.pathname;
  if (histUrl && !histUrl.endsWith('/favorites/')) {
    const title = document.querySelector('.article-title')?.textContent || '';
    const favBtnEl = document.getElementById('fav-btn');
    const sectionName = favBtnEl?.dataset.section || document.querySelector('.back')?.textContent?.trim()?.replace(/^返回/, '') || '';
    const sectionColor = favBtnEl?.dataset.color || '';
    const dateStr = favBtnEl?.dataset.date || '';
    // 先拉取云端合并足迹（用户操作过收藏则不以云端覆盖本地收藏）
    syncCloud(readLocal(FAV_KEY), readLocal(HIST_KEY), { push: false }).then((merged) => {
      let history = touched ? readLocal(HIST_KEY) : merged.history;
      history = history.filter((h) => h.url !== histUrl);
      history.unshift({
        url: histUrl,
        title,
        section: sectionName,
        color: sectionColor,
        date: dateStr,
        time: Date.now(),
      });
      history = history.slice(0, 60);
      // 收藏列表：用户本会话已操作则以本地为准（剔除本会话删除项）
      const favs = touched ? readLocal(FAV_KEY) : merged.favs;
      writeLocal(FAV_KEY, favs);
      writeLocal(HIST_KEY, history);
      pushCloud(favs, history);
    });
  }
</script>

<style>
  .article {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 4rem;
  }
  .article .container {
    max-width: 820px;
  }

  .article-head {
    margin-bottom: 2.5rem;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    transition: color var(--speed) var(--ease);
  }
  .back:hover {
    color: var(--accent);
  }
  .back-arrow {
    display: inline-flex;
    transform: scaleX(-1);
  }
  .article-title {
    font-size: var(--text-4xl);
    letter-spacing: -0.03em;
  }
  .article-desc {
    margin-top: 1rem;
    font-size: var(--text-xl);
    line-height: 1.6;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .meta-time {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    margin-right: 0.25rem;
  }
  /* ===== 收藏按钮 ===== */
  .fav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    padding: 0.35rem 0.75rem;
    font-size: var(--text-sm);
    font-weight: 550;
    color: var(--text-secondary);
    background: var(--bg-glass);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: color var(--speed) var(--ease), border-color var(--speed) var(--ease),
      background-color var(--speed) var(--ease), transform var(--speed) var(--ease);
  }
  .fav-btn:hover {
    color: #e11d48;
    border-color: color-mix(in srgb, #e11d48 45%, transparent);
    background: color-mix(in srgb, #e11d48 6%, transparent);
  }
  .fav-btn:active {
    transform: scale(0.94);
  }
  .fav-btn.is-faved {
    color: #e11d48;
    border-color: color-mix(in srgb, #e11d48 55%, transparent);
    background: color-mix(in srgb, #e11d48 10%, transparent);
  }
  .fav-btn.is-faved svg {
    fill: currentColor;
  }
  .fav-btn svg {
    transition: transform var(--speed) var(--ease);
  }
  .fav-btn.is-faved svg {
    animation: fav-pop 0.35s var(--ease-out);
  }
  @keyframes fav-pop {
    0% {
      transform: scale(0.6);
    }
    60% {
      transform: scale(1.25);
    }
    100% {
      transform: scale(1);
    }
  }
  @media (max-width: 560px) {
    .fav-label {
      display: none;
    }
  }
</style>

<style is:global>
  /* ===== 毛选学习专属排版（全局：正文由 <Content /> 渲染，Astro scoped 样式无法命中） ===== */
  .prose-maoxuan p {
    text-indent: 2em; /* 首行缩进两字 */
    margin-top: 0.85em;
  }
  .prose-maoxuan .fn-ref {
    font-size: 0.7em; /* 更小 */
    vertical-align: super; /* 上标 */
    line-height: 0;
    color: #b91c1c; /* 颜色 */
    font-weight: 600;
    cursor: pointer;
    padding: 0 0.1em;
    user-select: none;
  }
  .prose-maoxuan .fn-ref:hover {
    color: #ef4444;
    text-decoration: underline;
  }
  /* 注释区标题（"注　　释*"） */
  .prose-maoxuan .notes-title {
    display: block;
    margin-block: 1.6em 0.8em;
    font-weight: 700;
    font-size: 1.05em;
    letter-spacing: 0.1em;
    color: var(--text);
    text-indent: 0;
  }
  /* 注释条目锚点：保持原文角标样式，与正文上标区分 */
  .prose-maoxuan .note-anchor {
    font-size: 0.75em;
    vertical-align: super;
    line-height: 0;
    color: #b91c1c;
    font-weight: 600;
    margin: 0 0.05em;
    cursor: pointer;
    border-radius: 3px;
    transition: background-color 0.3s, box-shadow 0.3s;
    padding: 0.1em 0.05em;
  }
  .prose-maoxuan .note-anchor:hover {
    color: #ef4444;
  }
  /* 跳转后的高亮 */
  .prose-maoxuan .note-anchor.note-highlight {
    background: rgba(185, 28, 28, 0.14);
    box-shadow: 0 0 0 3px rgba(185, 28, 28, 0.18);
    color: #b91c1c;
  }
  /* 注释旁边的"返回"按钮：跳到注释后可一键回到原文 */
  .prose-maoxuan .fn-back {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0 0.15em 0 0.45em;
    padding: 0.18em 0.6em;
    font-size: 0.72em;
    font-weight: 600;
    line-height: 1.3;
    vertical-align: middle;
    color: #b91c1c;
    background: rgba(185, 28, 28, 0.08);
    border: 1px solid rgba(185, 28, 28, 0.32);
    border-radius: 9999px;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition: color var(--speed) var(--ease), background-color var(--speed) var(--ease),
      border-color var(--speed) var(--ease), transform var(--speed) var(--ease);
  }
  .prose-maoxuan .fn-back:hover {
    color: #fff;
    background: #b91c1c;
    border-color: #b91c1c;
    transform: translateY(-1px);
  }
  .prose-maoxuan .fn-back:active {
    transform: scale(0.94);
  }
  .prose-maoxuan .fn-back-arrow {
    font-size: 0.95em;
    line-height: 1;
  }
  /* 右下角固定"返回原文"悬浮按钮（跳转注释后出现） */
  .fn-float-back {
    position: fixed;
    right: max(1.1rem, env(safe-area-inset-right));
    bottom: max(1.2rem, env(safe-area-inset-bottom));
    z-index: 200;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 1.1rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: #fff;
    background: linear-gradient(120deg, #b91c1c, #dc2626);
    border: none;
    border-radius: 9999px;
    box-shadow: 0 8px 24px rgba(185, 28, 28, 0.35);
    cursor: pointer;
    opacity: 0;
    transform: translateY(14px) scale(0.92);
    pointer-events: none;
    transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
    animation: float-back-in 0.3s var(--ease-out) forwards;
  }
  @keyframes float-back-in {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }
  }
  .fn-float-back:hover {
    box-shadow: 0 12px 32px rgba(185, 28, 28, 0.45);
    transform: translateY(-2px) scale(1.02);
  }
  .fn-float-back:active {
    transform: scale(0.95);
  }
  /* 窄屏：悬浮按钮文字精简 */
  @media (max-width: 560px) {
    .fn-float-back {
      padding: 0.55rem 0.95rem;
      font-size: var(--text-xs);
    }
  }
