---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SECTIONS, firstImage } from '../lib/site';
import { getCollection } from 'astro:content';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const nav = [
  { href: '/', label: '首页', tip: '回到这个安静的小站' },
  { href: '/teaching', label: '黑/白板前的冥想', tip: SECTIONS.find((s) => s.slug === 'teaching')?.description },
  { href: '/research', label: '每日文摘搬运', tip: SECTIONS.find((s) => s.slug === 'research')?.description },
  { href: '/papers', label: '文献精选', tip: SECTIONS.find((s) => s.slug === 'papers')?.description },
  { href: '/github', label: 'GitHub热门搬运', tip: SECTIONS.find((s) => s.slug === 'github')?.description },
  { href: '/work', label: '快乐之源', tip: SECTIONS.find((s) => s.slug === 'work')?.description },
  { href: '/life', label: '不胡思乱想', tip: SECTIONS.find((s) => s.slug === 'life')?.description },
  { href: '/works', label: 'si码如山', tip: '折腾出来的小东西，代码都在 GitHub' },
  { href: '/about', label: '关于', tip: '留言板 · 想说什么就说什么' },
];

// ===== 今日更新：查询今天发布的所有文章（按栏目分组，取卡片图） =====
const todayStr = new Date().toISOString().slice(0, 10);
function todayKey(d: Date): string {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}
const todayPosts = (
  await Promise.all(
    SECTIONS.map(async (s) => {
      const all = await getCollection(s.slug);
      return all
        .filter((p) => !p.data.draft && todayKey(p.data.date) === todayStr)
        .map((p) => ({
          href: `/${s.slug}/${p.slug}/`,
          title: p.data.title,
          section: s.title,
          color: s.color,
          image: firstImage(p.body),
        }));
    }),
  )
).flat().sort((a, b) => a.section.localeCompare(b.section));

const isActive = (href: string) => {
  if (href === '/') return path === '/';
  // 精确匹配路径边界：/work 不能匹配 /works
  return path === href || path.startsWith(href + '/');
};
---

<header class="header" id="site-header">
  <div class="container header-inner">
    <div class="brand">
      <div class="brand-top">
        <Logo />
        <img class="header-avatar" src="/images/avatar-real.jpg" alt="LEODENG 头像" />
      </div>
      <p class="header-tag">
        <span class="tag-ghost" aria-hidden="true">随手记下一些思考与日常，慢慢分享给路过的你。</span>
        <span class="tag-live" id="header-typewriter"></span>
      </p>
    </div>

    <nav class="nav" aria-label="主导航">
      <ul>
        {
          nav.map((item) => (
            <li class="nav-item">
              <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
                {item.label}
              </a>
              {item.tip && <span class="nav-tip" role="tooltip">{item.tip}</span>}
            </li>
          ))
        }
        <li class="nav-item today-item">
          <a href="/" class="nav-link today-link">
            <span class="today-dot" aria-hidden="true"></span>
            今日更新
          </a>
          <div class="today-panel" id="today-panel">
            <div class="today-panel-head">
              <span class="today-panel-title">今日更新</span>
              <span class="today-panel-date">{todayStr}</span>
            </div>
            {
              todayPosts.length > 0 ? (
                <div class="today-list">
                  {
                    todayPosts.map((p) => (
                      <a class="today-card" href={p.href}>
                        {
                          p.image && (
                            <span class="today-card-img">
                              <img src={p.image} alt="" loading="lazy" />
                            </span>
                          )
                        }
                        <span class="today-card-body">
                          <span class="today-card-section" style={`color: ${p.color}`}>{p.section}</span>
                          <span class="today-card-title">{p.title}</span>
                        </span>
                        <Icon name="arrow-right" size={13} />
                      </a>
                    ))
                  }
                </div>
              ) : (
                <p class="today-empty">今天还没有发布新文章。</p>
              )
            }
          </div>
        </li>
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-btn search-btn" href="/search/" aria-label="搜索">
        <Icon name="search" size={18} />
      </a>
      <button class="icon-btn" id="theme-toggle" aria-label="切换主题模式" title="主题模式">
        <span class="i-sun"><Icon name="sun" size={18} /></span>
        <span class="i-moon"><Icon name="moon" size={18} /></span>
        <span class="i-auto"><Icon name="auto" size={18} /></span>
      </button>
      <a class="disclaimer-link" href="/disclaimer/" title="本站搬运内容的免责声明">免责声明</a>
      <button class="icon-btn menu-btn" id="menu-toggle" aria-label="打开菜单" aria-expanded="false">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul>
      <li>
        <a href="/search/" class="mobile-link">
          <span class="mobile-link-icon"><Icon name="search" size={16} /></span>
          搜索
        </a>
      </li>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class:list={['mobile-link', { active: isActive(item.href) }]}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: background-color 0.35s var(--ease), box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .header.scrolled {
    background: var(--bg-glass);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom-color: var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: auto;
    min-height: var(--header-h);
    padding-block: 0.45rem;
  }

  /* ===== 品牌区：logo + 照片 + 打字机 ===== */
  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 220px;
    width: 220px;
    max-width: 220px;
    flex-shrink: 0;
    flex-grow: 0;
  }
  .brand-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .header-avatar {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    object-fit: cover;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
  }
  .header-tag {
    position: relative;
    font-size: 0.68rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    width: 220px;
    min-width: 220px;
    max-width: 220px;
    height: 1em;
    line-height: 1;
    text-align: left;
    flex-shrink: 0;
  }
  /* 隐形占位：保持完整文字宽度，布局永不因打字变化 */
  .tag-ghost {
    visibility: hidden;
    white-space: nowrap;
    display: block;
  }
  /* 打字机文字：绝对定位覆盖在占位上，不参与布局 */
  .tag-live {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    color: var(--text-tertiary);
  }

  .nav {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
  }
  .nav ul {
    display: flex;
    align-items: center;
    gap: 0.05rem;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: nowrap;
    white-space: nowrap;
  }
  .nav-item {
    position: relative;
    flex-shrink: 0;
  }
  /* 主题标签的悬浮简介 */
  .nav-tip {
    position: fixed;
    top: 60px;
    left: 50%;
    min-width: max-content;
    max-width: 260px;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-secondary);
    white-space: normal;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.25s var(--ease-out),
      visibility 0.25s;
    z-index: 110;
  }
  .nav-tip::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: var(--bg-glass-strong);
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
  }
  .nav-tip.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-link {
    position: relative;
    display: block;
    padding: 0.32rem 0.28rem;
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-full);
    transition: color var(--speed) var(--ease), background-color var(--speed) var(--ease);
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--bg-glass);
  }
  .nav-link.active {
    color: var(--text);
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gradient);
  }

  /* ===== 今日更新：导航项 + 悬停下拉面板 ===== */
  .today-item {
    position: relative;
  }
  .today-link {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    color: var(--accent);
  }
  .today-link:hover {
    color: var(--accent);
    background: transparent;
  }
  .today-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gradient);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    animation: today-pulse 2.2s var(--ease-out) infinite;
  }
  @keyframes today-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    }
    50% {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 6%, transparent);
    }
  }
  .today-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translate(-50%, 8px);
    width: min(360px, calc(100vw - 2rem));
    padding: 0.85rem;
    border-radius: var(--radius-lg, 16px);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.28s var(--ease-out),
      transform 0.28s var(--ease-out),
      visibility 0.28s;
    z-index: 120;
  }
  .today-panel::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: var(--bg-glass-strong);
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
  }
  .today-item:hover .today-panel,
  .today-item:focus-within .today-panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }
  .today-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.15rem 0.2rem 0.55rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.5rem;
  }
  .today-panel-title {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--text);
  }
  .today-panel-date {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .today-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-height: 56vh;
    overflow-y: auto;
  }
  .today-card {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem;
    border-radius: var(--radius-md, 12px);
    text-decoration: none;
    transition: background-color var(--speed) var(--ease);
  }
  .today-card:hover {
    background: var(--bg-glass);
  }
  .today-card-img {
    flex-shrink: 0;
    width: 52px;
    height: 40px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-glass);
    border: 1px solid var(--border);
  }
  .today-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .today-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }
  .today-card-section {
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .today-card-title {
    font-size: var(--text-sm);
    font-weight: 550;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .today-card > :last-child {
    flex-shrink: 0;
    color: var(--text-tertiary);
    transition: color var(--speed) var(--ease), transform var(--speed) var(--ease);
  }
  .today-card:hover > :last-child {
    color: var(--accent);
    transform: translateX(2px);
  }
  .today-empty {
    padding: 1rem 0.4rem;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    flex-shrink: 0;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--text);
    transition: background-color var(--speed) var(--ease), color var(--speed) var(--ease);
  }
  .icon-btn:hover {
    background: var(--bg-glass);
  }
  /* 免责声明链接（低调小字，位于主题切换按钮右侧） */
  .disclaimer-link {
    padding: 0.3rem 0.45rem;
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--text-tertiary);
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    white-space: nowrap;
    transition: color var(--speed) var(--ease), border-color var(--speed) var(--ease), background-color var(--speed) var(--ease);
  }
  .disclaimer-link:hover {
    color: var(--text-secondary);
    border-color: var(--border);
    background: var(--bg-glass);
  }
  .menu-btn {
    display: none;
  }

  /* 主题切换图标（三态：自动 / 浅色 / 深色） */
  .i-sun,
  .i-moon,
  .i-auto {
    display: none;
  }
  /* 自动模式：显示「自动」图标 */
  html[data-theme-mode='auto'] .i-auto {
    display: inline-flex;
  }
  /* 浅色模式：显示月亮（提示可切深色） */
  html[data-theme-mode='light'] .i-moon {
    display: inline-flex;
  }
  /* 深色模式：显示太阳（提示可切浅色） */
  html[data-theme-mode='dark'] .i-sun {
    display: inline-flex;
  }

  .mobile-menu {
    display: none;
    border-top: 1px solid var(--border);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
  }
  .mobile-menu ul {
    list-style: none;
    padding: 0.75rem var(--gutter) 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 0.5rem;
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: color var(--speed) var(--ease), background-color var(--speed) var(--ease);
  }
  .mobile-link-icon {
    display: inline-flex;
    color: var(--text-tertiary);
  }
  .mobile-link:hover,
  .mobile-link.active {
    color: var(--text);
    background: var(--bg-glass);
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    .mobile-menu:not([hidden]) {
      display: block;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // ===== Header 高度自适应：main padding-top 跟随 header 实际高度 =====
  function syncMainPadding() {
    const main = document.getElementById('main');
    if (!main || !header) return;
    main.style.paddingTop = header.offsetHeight + 'px';
  }
  syncMainPadding();
  window.addEventListener('resize', syncMainPadding);
  // header 布局变化（导航换行等）后重新测量
  new ResizeObserver(syncMainPadding).observe(header);

  // ===== Header 打字机效果 =====
  const headerTw = document.getElementById('header-typewriter');
  const headerGhost = document.querySelector('.tag-ghost');
  if (headerTw && headerGhost) {
    const full = headerGhost.textContent || '';
    let hi = 0;
    let hDeleting = false;
    function hTick() {
      if (!hDeleting) {
        hi++;
        headerTw.textContent = full.slice(0, hi);
        if (hi >= full.length) {
          hDeleting = true;
          setTimeout(hTick, 2400);
          return;
        }
        setTimeout(hTick, 95);
      } else {
        hi--;
        headerTw.textContent = full.slice(0, hi);
        if (hi <= 0) {
          hDeleting = false;
          setTimeout(hTick, 600);
          return;
        }
        setTimeout(hTick, 48);
      }
    }
    setTimeout(hTick, 300);
  }

  const themeBtn = document.getElementById('theme-toggle');

  function themeByTime() {
    const h = new Date().getHours();
    return h >= 6 && h < 18 ? 'light' : 'dark';
  }

  function applyTheme(mode) {
    const root = document.documentElement;
    let theme = mode;
    if (mode === 'auto') {
      theme = themeByTime();
    }
    root.setAttribute('data-theme', theme);
    root.setAttribute('data-theme-mode', mode);
  }

  function currentMode() {
    return document.documentElement.getAttribute('data-theme-mode') || 'auto';
  }

  themeBtn?.addEventListener('click', () => {
    const order = ['auto', 'light', 'dark'];
    const cur = currentMode();
    const next = order[(order.indexOf(cur) + 1) % order.length];
    applyTheme(next);
    try {
      localStorage.setItem('theme', next);
    } catch (_) {
      /* 忽略隐私模式下 localStorage 不可用 */
    }
  });

  // 自动模式下按当地时间切换：每 30 秒检查一次，跨时段自动更新
  setInterval(() => {
    if (currentMode() === 'auto') {
      applyTheme('auto');
    }
  }, 30000);

  // ===== 导航 tooltip：fixed 定位到导航项下方（避免 overflow 裁剪）=====
  document.querySelectorAll('.nav-item').forEach(function (item) {
    const tip = item.querySelector('.nav-tip');
    if (!tip) return;
    item.addEventListener('mouseenter', function () {
      const rect = item.getBoundingClientRect();
      // 居中于导航项
      tip.style.left = rect.left + rect.width / 2 + 'px';
      tip.style.top = rect.bottom + 10 + 'px';
      // 防超出右屏
      tip.style.transform = 'translateX(-50%)';
      const tipRect = tip.getBoundingClientRect();
      if (tipRect.right > window.innerWidth - 8) {
        tip.style.transform = 'translateX(calc(-50% - ' + (tipRect.right - window.innerWidth + 8) + 'px))';
      }
      tip.classList.add('show');
    });
    item.addEventListener('mouseleave', function () {
      tip.classList.remove('show');
    });
  });

  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {    const open = menu?.hasAttribute('hidden');
    if (open) menu?.removeAttribute('hidden');
    else menu?.setAttribute('hidden', '');
    menuBtn?.setAttribute('aria-expanded', String(open));
  });
</script>
