---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import VisitorCounter from './VisitorCounter.astro';
import { SECTIONS, firstImage } from '../lib/site';
import { getCollection } from 'astro:content';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const nav = [
  { href: '/', label: '首页', tip: '回到这个安静的小站' },
  { href: '/teaching', label: '黑/白板前的冥想', tip: SECTIONS.find((s) => s.slug === 'teaching')?.description },
  { href: '/research', label: '每日文摘搬运', tip: SECTIONS.find((s) => s.slug === 'research')?.description },
  { href: '/papers', label: '文献精选', tip: SECTIONS.find((s) => s.slug === 'papers')?.description },
  { href: '/github', label: 'GitHub热门搬运', tip: SECTIONS.find((s) => s.slug === 'github')?.description },
  { href: '/work', label: '快乐之源', tip: SECTIONS.find((s) => s.slug === 'work')?.description },
  { href: '/life', label: '不胡思乱想', tip: SECTIONS.find((s) => s.slug === 'life')?.description },
  { href: '/works', label: 'si码如山', tip: '折腾出来的小东西，代码都在 GitHub' },
  { href: '/about', label: '关于', tip: '留言板 · 想说什么就说什么' },
];

// ===== 今日更新：查询今天发布的所有文章（按栏目分组，取卡片图） =====
const todayStr = new Date().toISOString().slice(0, 10);
function todayKey(d: Date): string {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}
const todayPosts = (
  await Promise.all(
    SECTIONS.map(async (s) => {
      const all = await getCollection(s.slug);
      return all
        .filter((p) => !p.data.draft && todayKey(p.data.date) === todayStr)
        .map((p) => ({
          href: `/${s.slug}/${p.slug}/`,
          title: p.data.title,
          section: s.title,
          color: s.color,
          image: firstImage(p.body),
        }));
    }),
  )
).flat().sort((a, b) => a.section.localeCompare(b.section));

const isActive = (href: string) => {
  if (href === '/') return path === '/';
  // 精确匹配路径边界：/work 不能匹配 /works
  return path === href || path.startsWith(href + '/');
};
---

<header class="header" id="site-header">
  <div class="container header-inner">
    <div class="brand">
      <div class="brand-top">
        <img class="header-avatar" src="/images/avatar-real.jpg" alt="LEODENG 头像" />
        <Logo />
      </div>
      <p class="header-tag">
        <span class="tag-ghost" aria-hidden="true">随手记下一些思考与日常，慢慢分享给路过的你。</span>
        <span class="tag-live" id="header-typewriter"></span>
      </p>
    </div>

    <nav class="nav" aria-label="主导航">
      <ul>
        {
          nav.map((item) => (
            <li class="nav-item">
              <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
                {item.label}
              </a>
              {item.tip && <span class="nav-tip" role="tooltip">{item.tip}</span>}
            </li>
          ))
        }
        <li class="nav-item today-item">
          <a href="/" class="nav-link today-link">
            <span class="today-dot" aria-hidden="true"></span>
            今日更新
          </a>
          <div class="today-panel" id="today-panel">
            <div class="today-panel-head">
              <span class="today-panel-title">今日更新</span>
              <span class="today-panel-date">{todayStr}</span>
            </div>
            {
              todayPosts.length > 0 ? (
                <div class="today-list" id="today-list">
                  <span class="today-active" id="today-active" aria-hidden="true"></span>
                  {
                    todayPosts.map((p) => (
                      <a class="today-card" href={p.href}>
                        {
                          p.image && (
                            <span class="today-card-img">
                              <img src={p.image} alt="" loading="lazy" />
                            </span>
                          )
                        }
                        <span class="today-card-body">
                          <span class="today-card-section" style={`--sc: ${p.color}`}>{p.section}</span>
                          <span class="today-card-title">{p.title}</span>
                        </span>
                        <Icon name="arrow-right" size={13} />
                      </a>
                    ))
                  }
                </div>
              ) : (
                <p class="today-empty">今天还没有发布新文章。</p>
              )
            }
          </div>
        </li>
      </ul>
    </nav>

    <div class="actions">
      <a class:list={['icon-btn', { 'is-active': path === '/favorites' }]} href="/favorites/" aria-label="收藏与浏览历史" title="收藏与足迹">
        <Icon name="heart" size={18} />
      </a>
      <a class="icon-btn search-btn" href="/search/" aria-label="搜索">
        <Icon name="search" size={18} />
      </a>
      <button class="icon-btn" id="theme-toggle" aria-label="切换主题模式" title="主题模式">
        <span class="i-sun"><Icon name="sun" size={18} /></span>
        <span class="i-moon"><Icon name="moon" size={18} /></span>
        <span class="i-auto"><Icon name="auto" size={18} /></span>
      </button>
      <div class="disclaimer-wrap">
        <a class="disclaimer-link" href="/disclaimer/" title="本站搬运内容的免责声明">免责声明</a>
        <div class="disclaimer-panel" id="disclaimer-panel">
          <div class="disclaimer-panel-title">免责声明</div>
          <p class="disclaimer-panel-text">本站搬运的内容（GitHub 热门、每日文摘、文献与资料等）均来自公开渠道，版权归原作者或原平台所有，仅作个人学习、交流与记录之用，不用于任何商业用途。</p>
          <p class="disclaimer-panel-text">搬运时已尽可能注明原始出处与链接；如需引用、转载，请以原出处为准，商业使用请联系原作者。</p>
          <a class="disclaimer-panel-link" href="/disclaimer/">查看完整声明 <Icon name="arrow-right" size={12} /></a>
        </div>
      </div>
      <VisitorCounter variant="header" id="visitor-counter-header" />
      <div class="ambient-clock" id="ambient-clock" title="当前时间">--</div>
      <div class="ambient-weather" id="ambient-weather" title="按你的位置显示的天气" hidden>
        <span class="aw-icon" id="aw-icon"></span>
        <span class="aw-text" id="aw-text">天气加载中…</span>
      </div>
      <button class="icon-btn menu-btn" id="menu-toggle" aria-label="打开菜单" aria-expanded="false">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul>
      <li>
        <a href="/search/" class="mobile-link">
          <span class="mobile-link-icon"><Icon name="search" size={16} /></span>
          搜索
        </a>
      </li>
      <li class="mobile-today-wrap">
        <button class="mobile-link mobile-today-toggle" type="button" aria-expanded="false">
          <span class="mobile-link-icon mobile-today-dot" aria-hidden="true"></span>
          今日更新
          {todayPosts.length > 0 && <span class="mobile-today-count">{todayPosts.length}</span>}
        </button>
        {todayPosts.length > 0 && (
          <div class="mobile-today-list" hidden>
            {todayPosts.map((p) => (
              <a class="mobile-today-item" href={p.href}>
                <span class="mobile-today-sec" style={`--sc: ${p.color}`}>{p.section}</span>
                <span class="mobile-today-title">{p.title}</span>
              </a>
            ))}
          </div>
        )}
      </li>
      <li>
        <a href="/favorites/" class="mobile-link">
          <span class="mobile-link-icon"><Icon name="heart" size={16} /></span>
          收藏与足迹
        </a>
      </li>
      <li>
        <a href="/disclaimer/" class="mobile-link">
          <span class="mobile-link-icon"><Icon name="doc" size={16} /></span>
          免责声明
        </a>
      </li>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class:list={['mobile-link', { active: isActive(item.href) }]}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: background-color 0.35s var(--ease), box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .header.scrolled {
    background: var(--bg-glass);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom-color: var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: auto;
    min-height: var(--header-h);
    padding-block: 0.45rem;
  }

  /* ===== 品牌区：头像 + logo + 打字机 ===== */
  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 130px;
    width: auto;
    max-width: 180px;
    flex-shrink: 0;
    flex-grow: 0;
  }
  .brand-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .header-avatar {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    object-fit: cover;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
  }
  .header-tag {
    position: relative;
    font-size: 0.62rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    width: 100%;
    min-width: 0;
    max-width: 180px;
    height: 1em;
    line-height: 1;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 0;
  }
  /* 隐形占位：保持完整文字宽度，布局永不因打字变化 */
  .tag-ghost {
    visibility: hidden;
    white-space: nowrap;
    display: block;
  }
  /* 打字机文字：绝对定位覆盖在占位上，不参与布局 */
  .tag-live {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    color: var(--text-tertiary);
  }

  .nav {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
  }
  .nav ul {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: nowrap;
    white-space: nowrap;
  }
  .nav-item {
    position: relative;
    flex-shrink: 0;
  }
  /* 主题标签的悬浮简介 */
  .nav-tip {
    position: fixed;
    top: 60px;
    left: 50%;
    min-width: max-content;
    max-width: 260px;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-secondary);
    white-space: normal;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.25s var(--ease-out),
      visibility 0.25s;
    z-index: 110;
  }
  .nav-tip::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: var(--bg-glass-strong);
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
  }
  .nav-tip.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-link {
    position: relative;
    display: block;
    padding: 0.28rem 0.11rem;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-full);
    transition: color var(--speed) var(--ease), background-color var(--speed) var(--ease);
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--bg-glass);
  }
  .nav-link.active {
    color: var(--text);
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gradient);
  }

  /* ===== 今日更新：导航项 + 悬停下拉面板 ===== */
  .today-item {
    position: relative;
  }
  .today-link {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    color: var(--accent);
  }
  .today-link:hover {
    color: var(--accent);
    background: transparent;
  }
  .today-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gradient);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    animation: today-pulse 2.2s var(--ease-out) infinite;
  }
  @keyframes today-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    }
    50% {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 6%, transparent);
    }
  }
  .today-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translate(-50%, 8px);
    width: min(360px, calc(100vw - 2rem));
    padding: 0.85rem;
    border-radius: var(--radius-lg, 16px);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.28s var(--ease-out),
      transform 0.28s var(--ease-out),
      visibility 0.28s;
    z-index: 120;
  }
  .today-panel::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: var(--bg-glass-strong);
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
  }
  .today-item:hover .today-panel,
  .today-item:focus-within .today-panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }
  /* 触屏：点击"今日更新"展开面板（JS 加 .open 类） */
  .today-item.is-open .today-panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }
  .today-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.15rem 0.2rem 0.55rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.5rem;
  }
  .today-panel-title {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--text);
  }
  .today-panel-date {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .today-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-height: 56vh;
    overflow-y: auto;
    padding: 0.15rem;
  }
  /* 跟随鼠标滑动的选中高亮条 */
  .today-active {
    position: absolute;
    left: 0.15rem;
    right: 0.15rem;
    top: 0.15rem;
    height: calc((100% - 0.3rem) / 3);
    border-radius: var(--radius-md, 12px);
    background: var(--bg-glass);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    pointer-events: none;
    opacity: 0;
    transition:
      top 0.3s var(--ease-out),
      opacity 0.25s var(--ease-out);
    z-index: 0;
  }
  .today-item:hover .today-panel .today-active {
    opacity: 1;
  }
  .today-card {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem;
    border-radius: var(--radius-md, 12px);
    text-decoration: none;
    will-change: transform;
    transition:
      opacity var(--speed) var(--ease),
      background-color var(--speed) var(--ease);
    opacity: 0.55;
  }
  .today-card.is-active {
    opacity: 1;
  }
  .today-card:hover {
    background: transparent;
  }
  /* 选中态：标题加亮、箭头显现 */
  .today-card .today-card-title {
    transition: color var(--speed) var(--ease);
  }
  .today-card.is-active .today-card-title {
    color: var(--accent);
  }
  .today-card-img {
    flex-shrink: 0;
    width: 52px;
    height: 40px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-glass);
    border: 1px solid var(--border);
  }
  .today-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .today-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }
  .today-card-section {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--sc);
  }
  html[data-theme="dark"] .today-card-section {
    color: color-mix(in srgb, var(--sc) 55%, #ffffff);
  }
  .today-card-title {
    font-size: var(--text-sm);
    font-weight: 550;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .today-card > :last-child {
    flex-shrink: 0;
    color: var(--text-tertiary);
    opacity: 0;
    transform: translateX(-3px);
    transition:
      opacity var(--speed) var(--ease),
      color var(--speed) var(--ease),
      transform var(--speed) var(--ease);
  }
  .today-card.is-active > :last-child {
    opacity: 1;
    color: var(--accent);
    transform: translateX(0);
  }
  .today-empty {
    padding: 1rem 0.4rem;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.08rem;
    flex-shrink: 0;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--text);
    transition: background-color var(--speed) var(--ease), color var(--speed) var(--ease);
  }
  .icon-btn:hover {
    background: var(--bg-glass);
  }
  .icon-btn.is-active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  /* 免责声明：悬停弹出面板 */
  .disclaimer-wrap {
    position: relative;
  }
  .disclaimer-link {
    display: inline-flex;
    padding: 0.3rem 0.4rem;
    font-size: 0.66rem;
    font-weight: 600;
    color: var(--accent);
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    white-space: nowrap;
    transition: color var(--speed) var(--ease), border-color var(--speed) var(--ease), background-color var(--speed) var(--ease);
  }
  .disclaimer-link:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }
  /* 时钟 + 天气（从右下角浮动条移入导航栏，与访问统计同风格） */
  .ambient-clock,
  .ambient-weather {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.4rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    font-size: 0.64rem;
    white-space: nowrap;
    color: var(--text-secondary);
  }
  .ambient-clock {
    font-variant-numeric: tabular-nums;
    font-weight: 550;
    color: var(--text);
  }
  .ambient-weather[hidden] {
    display: none;
  }
  .aw-icon {
    font-size: 0.9rem;
    line-height: 1;
  }
  /* 中等宽度：时钟/天气压缩为精简胶囊（导航仍显示的区间） */
  @media (max-width: 1280px) {
    .ambient-weather .aw-text {
      max-width: 8em;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
  @media (min-width: 1025px) and (max-width: 1100px) {
    .ambient-clock,
    .ambient-weather {
      padding: 0.26rem 0.3rem;
      font-size: 0.6rem;
    }
    .ambient-clock {
      max-width: 10em;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ambient-weather {
      display: none;
    }
  }
  .disclaimer-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(320px, calc(100vw - 2rem));
    padding: 1rem 1.1rem;
    border-radius: var(--radius-lg, 16px);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity 0.28s var(--ease-out),
      transform 0.28s var(--ease-out),
      visibility 0.28s;
    z-index: 120;
  }
  .disclaimer-panel::before {
    content: '';
    position: absolute;
    top: -5px;
    right: 22px;
    transform: rotate(45deg);
    width: 10px;
    height: 10px;
    background: var(--bg-glass-strong);
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
  }
  .disclaimer-wrap:hover .disclaimer-panel,
  .disclaimer-wrap:focus-within .disclaimer-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* 触屏：点击免责声明展开面板（JS 加 .open 类） */
  .disclaimer-wrap.is-open .disclaimer-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  .disclaimer-panel-title {
    font-size: var(--text-sm);
    font-weight: 650;
    margin-bottom: 0.5rem;
  }
  .disclaimer-panel-text {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 0.45rem;
  }
  .disclaimer-panel-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.35rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }
  .disclaimer-panel-link:hover {
    text-decoration: underline;
  }
  .menu-btn {
    display: none;
  }

  /* 主题切换图标（三态：自动 / 浅色 / 深色） */
  .i-sun,
  .i-moon,
  .i-auto {
    display: none;
  }
  /* 自动模式：显示「自动」图标 */
  html[data-theme-mode='auto'] .i-auto {
    display: inline-flex;
  }
  /* 浅色模式：显示月亮（提示可切深色） */
  html[data-theme-mode='light'] .i-moon {
    display: inline-flex;
  }
  /* 深色模式：显示太阳（提示可切浅色） */
  html[data-theme-mode='dark'] .i-sun {
    display: inline-flex;
  }

  .mobile-menu {
    display: none;
    border-top: 1px solid var(--border);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
  }
  .mobile-menu ul {
    list-style: none;
    padding: 0.75rem var(--gutter) 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 0.5rem;
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: color var(--speed) var(--ease), background-color var(--speed) var(--ease);
  }
  .mobile-link-icon {
    display: inline-flex;
    color: var(--text-tertiary);
  }
  /* 移动菜单：今日更新入口 */
  .mobile-today-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--gradient);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .mobile-today-count {
    margin-left: auto;
    min-width: 1.4rem;
    padding: 0.05rem 0.45rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 650;
    text-align: center;
  }
  /* 移动菜单：今日更新展开列表 */
  .mobile-today-toggle {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
  }
  .mobile-today-list {
    display: flex;
    flex-direction: column;
    margin: 0.1rem 0 0.5rem 1.9rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--border);
    gap: 0.15rem;
  }
  .mobile-today-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.4rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: color var(--speed) var(--ease), background-color var(--speed) var(--ease);
  }
  .mobile-today-item:hover {
    color: var(--text);
    background: var(--bg-glass);
  }
  .mobile-today-sec {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--sc);
  }
  html[data-theme="dark"] .mobile-today-sec {
    color: color-mix(in srgb, var(--sc) 55%, #ffffff);
  }
  .mobile-today-title {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mobile-link:hover,
  .mobile-link.active {
    color: var(--text);
    background: var(--bg-glass);
  }

  /* 中等宽度（导航仍显示，但空间紧张）：进一步压缩栏目间距 */
  @media (max-width: 1100px) {
    .nav-link {
      padding: 0.28rem 0.06rem;
      font-size: 0.66rem;
    }
    .brand {
      max-width: 150px;
    }
    .header-tag {
      max-width: 150px;
      font-size: 0.58rem;
    }
    .disclaimer-link {
      padding: 0.28rem 0.32rem;
      font-size: 0.64rem;
    }
  }

  @media (max-width: 1024px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    .mobile-menu:not([hidden]) {
      display: block;
    }
    /* 触屏/窄屏：压缩品牌区与操作区，避免 actions 溢出视口 */
    .brand,
    .brand-tag {
      min-width: 0;
      width: auto;
      max-width: none;
    }
    .brand-top {
      gap: 0.5rem;
    }
    .header-avatar {
      width: 26px;
      height: 26px;
    }
    /* 窄屏隐藏免责声明文字入口（移动菜单里有完整入口） */
    .disclaimer-link {
      display: none;
    }
    .disclaimer-panel {
      display: none;
    }
    /* 移动端：搜索/收藏在移动菜单里有入口，header 图标隐藏给时钟天气让位 */
    .search-btn,
    .actions a[href="/favorites/"] {
      display: none;
    }
    /* 移动端时钟/天气：紧凑显示，天气文字省略 */
    .ambient-clock,
    .ambient-weather {
      padding: 0.26rem 0.3rem;
      font-size: 0.6rem;
    }
    .ambient-clock {
      max-width: 11em;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ambient-weather .aw-text {
      max-width: 8em;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  /* 超窄屏（<420px）：进一步压缩，保证 5 个操作图标不溢出 */
  @media (max-width: 420px) {
    .header-tag {
      display: none;
    }
    .actions {
      gap: 0.05rem;
    }
    .icon-btn {
      width: 30px;
      height: 30px;
    }
    /* 超窄：天气隐藏（空间不足），时钟截断为时间 */
    .ambient-weather {
      display: none;
    }
    .ambient-clock {
      max-width: 7.5em;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // ===== Header 高度自适应：main padding-top 跟随 header 实际高度 =====
  function syncMainPadding() {
    const main = document.getElementById('main');
    if (!main || !header) return;
    main.style.paddingTop = header.offsetHeight + 'px';
  }
  syncMainPadding();
  window.addEventListener('resize', syncMainPadding);
  // header 布局变化（导航换行等）后重新测量
  new ResizeObserver(syncMainPadding).observe(header);

  // ===== Header 打字机效果 =====
  const headerTw = document.getElementById('header-typewriter');
  const headerGhost = document.querySelector('.tag-ghost');
  if (headerTw && headerGhost) {
    const full = headerGhost.textContent || '';
    let hi = 0;
    let hDeleting = false;
    function hTick() {
      if (!hDeleting) {
        hi++;
        headerTw.textContent = full.slice(0, hi);
        if (hi >= full.length) {
          hDeleting = true;
          setTimeout(hTick, 2400);
          return;
        }
        setTimeout(hTick, 95);
      } else {
        hi--;
        headerTw.textContent = full.slice(0, hi);
        if (hi <= 0) {
          hDeleting = false;
          setTimeout(hTick, 600);
          return;
        }
        setTimeout(hTick, 48);
      }
    }
    setTimeout(hTick, 300);
  }

  const themeBtn = document.getElementById('theme-toggle');

  function themeByTime() {
    const h = new Date().getHours();
    return h >= 6 && h < 18 ? 'light' : 'dark';
  }

  function applyTheme(mode) {
    const root = document.documentElement;
    let theme = mode;
    if (mode === 'auto') {
      theme = themeByTime();
    }
    root.setAttribute('data-theme', theme);
    root.setAttribute('data-theme-mode', mode);
  }

  function currentMode() {
    return document.documentElement.getAttribute('data-theme-mode') || 'auto';
  }

  themeBtn?.addEventListener('click', () => {
    const order = ['auto', 'light', 'dark'];
    const cur = currentMode();
    const next = order[(order.indexOf(cur) + 1) % order.length];
    applyTheme(next);
    try {
      localStorage.setItem('theme', next);
    } catch (_) {
      /* 忽略隐私模式下 localStorage 不可用 */
    }
  });

  // 自动模式下按当地时间切换：每 30 秒检查一次，跨时段自动更新
  setInterval(() => {
    if (currentMode() === 'auto') {
      applyTheme('auto');
    }
  }, 30000);

  // ===== 导航 tooltip：fixed 定位到导航项下方（避免 overflow 裁剪）=====
  document.querySelectorAll('.nav-item').forEach(function (item) {
    const tip = item.querySelector('.nav-tip');
    if (!tip) return;
    item.addEventListener('mouseenter', function () {
      const rect = item.getBoundingClientRect();
      // 居中于导航项
      tip.style.left = rect.left + rect.width / 2 + 'px';
      tip.style.top = rect.bottom + 10 + 'px';
      // 防超出右屏
      tip.style.transform = 'translateX(-50%)';
      const tipRect = tip.getBoundingClientRect();
      if (tipRect.right > window.innerWidth - 8) {
        tip.style.transform = 'translateX(calc(-50% - ' + (tipRect.right - window.innerWidth + 8) + 'px))';
      }
      tip.classList.add('show');
    });
    item.addEventListener('mouseleave', function () {
      tip.classList.remove('show');
    });
  });

  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {    const open = menu?.hasAttribute('hidden');
    if (open) menu?.removeAttribute('hidden');
    else menu?.setAttribute('hidden', '');
    menuBtn?.setAttribute('aria-expanded', String(open));
  });

  // 移动菜单：今日更新展开/收起
  const mobileTodayToggle = document.querySelector('.mobile-today-toggle');
  const mobileTodayList = document.querySelector('.mobile-today-list');
  mobileTodayToggle?.addEventListener('click', () => {
    const open = mobileTodayList?.hasAttribute('hidden');
    if (open) mobileTodayList?.removeAttribute('hidden');
    else mobileTodayList?.setAttribute('hidden', '');
    mobileTodayToggle?.setAttribute('aria-expanded', String(!open));
  });

  // ===== 触屏设备：点击展开今日更新 / 免责声明面板（hover 在触屏上不可用） =====
  (function () {
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    if (!coarse) return; // 仅触屏设备
    const todayItem = document.querySelector('.today-item');
    const disclaimerWrap = document.querySelector('.disclaimer-wrap');
    // 关闭其他已展开的面板
    function closeAll(except) {
      [todayItem, disclaimerWrap].forEach((el) => {
        if (el && el !== except) el.classList.remove('is-open');
      });
    }
    if (todayItem) {
      const link = todayItem.querySelector('.today-link');
      link?.addEventListener('click', (e) => {
        e.preventDefault(); // 触屏：先展开面板，不跳转
        const willOpen = !todayItem.classList.contains('is-open');
        closeAll(todayItem);
        if (willOpen) todayItem.classList.add('is-open');
      });
    }
    if (disclaimerWrap) {
      const link = disclaimerWrap.querySelector('.disclaimer-link');
      link?.addEventListener('click', (e) => {
        e.preventDefault(); // 触屏：先展开面板，不跳转
        const willOpen = !disclaimerWrap.classList.contains('is-open');
        closeAll(disclaimerWrap);
        if (willOpen) disclaimerWrap.classList.add('is-open');
        else disclaimerWrap.classList.remove('is-open');
      });
    }
    // 点击页面其他区域关闭（监听捕获阶段，避免被面板内事件吞掉）
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.today-item') && !e.target.closest('.disclaimer-wrap')) {
        closeAll(null);
      }
    });
  })();

  // ===== 今日更新面板：鼠标滑动 → 波浪浮动 + 选中高亮 =====
  (function () {
    const panel = document.getElementById('today-panel');
    if (!panel) return;
    const list = document.getElementById('today-list');
    const cards = Array.from(panel.querySelectorAll('.today-card'));
    const active = document.getElementById('today-active');
    if (cards.length === 0) return;

    let target = 0; // 鼠标相对面板中心的纵向位置（-1 ~ 1）
    let current = 0;
    let rafId = null;
    let inPanel = false;
    let activeIndex = -1;

    // 把高亮条移动到第 index 张卡片
    function moveActive(index) {
      if (!active) return;
      if (index < 0 || index >= cards.length) {
        active.style.opacity = '0';
        activeIndex = -1;
        cards.forEach((c) => c.classList.remove('is-active'));
        return;
      }
      const first = cards[0].getBoundingClientRect();
      const card = cards[index].getBoundingClientRect();
      // 高亮条 top 相对 list 内容
      const top = card.top - first.top + (card.height - first.height) * 0;
      active.style.top = top + 'px';
      active.style.height = card.height + 'px';
      active.style.opacity = '1';
      cards.forEach((c, i) => c.classList.toggle('is-active', i === index));
      activeIndex = index;
    }

    function loop() {
      current += (target - current) * 0.16;
      const amp = 7; // 最大浮动像素
      const tilt = 1.6; // 最大倾斜角度
      cards.forEach((card, i) => {
        // 每张卡片按索引错开相位，形成波浪
        const phase = current * Math.PI * 2 + i * 1.05;
        const y = Math.sin(phase) * amp;
        const deg = Math.cos(phase) * tilt;
        card.style.transform = 'translateY(' + y.toFixed(2) + 'px) rotate(' + deg.toFixed(2) + 'deg)';
      });
      if (Math.abs(target - current) > 0.002) {
        rafId = requestAnimationFrame(loop);
      } else {
        rafId = null;
        if (!inPanel) {
          // 鼠标离开后归位
          cards.forEach((card) => {
            card.style.transform = '';
          });
        }
      }
    }

    function start() {
      if (rafId === null) rafId = requestAnimationFrame(loop);
    }

    panel.addEventListener('mousemove', function (e) {
      inPanel = true;
      const rect = panel.getBoundingClientRect();
      // 归一化到 -1 ~ 1（面板中心为 0）
      target = ((e.clientY - rect.top) / rect.height) * 2 - 1;
      start();

      // 选中高亮：找到鼠标所在的卡片
      let idx = -1;
      cards.forEach((card, i) => {
        const r = card.getBoundingClientRect();
        if (e.clientY >= r.top && e.clientY <= r.bottom) idx = i;
      });
      if (idx !== activeIndex) {
        moveActive(idx);
      }
    });

    panel.addEventListener('mouseleave', function () {
      inPanel = false;
      target = 0;
      start();
      moveActive(-1);
    });
  })();
</script>
