---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SECTIONS } from '../lib/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const nav = [
  { href: '/', label: '首页', tip: '回到这个安静的小站' },
  { href: '/teaching', label: '黑/白板前的冥想', tip: SECTIONS.find((s) => s.slug === 'teaching')?.description },
  { href: '/research', label: '每日文摘搬运', tip: SECTIONS.find((s) => s.slug === 'research')?.description },
  { href: '/papers', label: '文献精选', tip: SECTIONS.find((s) => s.slug === 'papers')?.description },
  { href: '/github', label: 'GitHub热门搬运', tip: SECTIONS.find((s) => s.slug === 'github')?.description },
  { href: '/work', label: '快乐之源', tip: SECTIONS.find((s) => s.slug === 'work')?.description },
  { href: '/life', label: '不胡思乱想', tip: SECTIONS.find((s) => s.slug === 'life')?.description },
  { href: '/works', label: 'si码如山', tip: '折腾出来的小东西，代码都在 GitHub' },
  { href: '/about', label: '关于', tip: '留言板 · 想说什么就说什么' },
];

const isActive = (href: string) => {
  if (href === '/') return path === '/';
  // 精确匹配路径边界：/work 不能匹配 /works
  return path === href || path.startsWith(href + '/');
};
---

<header class="header" id="site-header">
  <div class="container header-inner">
    <div class="brand">
      <div class="brand-top">
        <Logo />
        <img class="header-avatar" src="/images/avatar-real.jpg" alt="LEODENG 头像" />
      </div>
      <p class="header-tag">
        <span class="tag-ghost" aria-hidden="true">随手记下一些思考与日常，慢慢分享给路过的你。</span>
        <span class="tag-live" id="header-typewriter"></span>
      </p>
    </div>

    <nav class="nav" aria-label="主导航">
      <ul>
        {
          nav.map((item) => (
            <li class="nav-item">
              <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
                {item.label}
              </a>
              {item.tip && <span class="nav-tip" role="tooltip">{item.tip}</span>}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="icon-btn search-btn" href="/search/" aria-label="搜索">
        <Icon name="search" size={18} />
      </a>
      <button class="icon-btn" id="theme-toggle" aria-label="切换主题模式" title="主题模式">
        <span class="i-sun"><Icon name="sun" size={18} /></span>
        <span class="i-moon"><Icon name="moon" size={18} /></span>
        <span class="i-auto"><Icon name="auto" size={18} /></span>
      </button>
      <button class="icon-btn menu-btn" id="menu-toggle" aria-label="打开菜单" aria-expanded="false">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul>
      <li>
        <a href="/search/" class="mobile-link">
          <span class="mobile-link-icon"><Icon name="search" size={16} /></span>
          搜索
        </a>
      </li>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class:list={['mobile-link', { active: isActive(item.href) }]}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: background-color 0.35s var(--ease), box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .header.scrolled {
    background: var(--bg-glass);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom-color: var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: auto;
    min-height: var(--header-h);
    padding-block: 0.45rem;
  }

  /* ===== 品牌区：logo + 照片 + 打字机 ===== */
  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 300px;
    width: 300px;
    max-width: 300px;
    flex-shrink: 0;
    flex-grow: 0;
  }
  .brand-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .header-avatar {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    object-fit: cover;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
  }
  .header-tag {
    position: relative;
    font-size: 0.68rem;
    color: var(--text-tertiary);
    white-space: nowrap;
    width: 300px;
    min-width: 300px;
    max-width: 300px;
    height: 1em;
    line-height: 1;
    text-align: left;
    flex-shrink: 0;
  }
  /* 隐形占位：保持完整文字宽度，布局永不因打字变化 */
  .tag-ghost {
    visibility: hidden;
    white-space: nowrap;
    display: block;
  }
  /* 打字机文字：绝对定位覆盖在占位上，不参与布局 */
  .tag-live {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    color: var(--text-tertiary);
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }
  .nav-item {
    position: relative;
  }
  /* 主题标签的悬浮简介 */
  .nav-tip {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(-4px);
    min-width: max-content;
    max-width: 260px;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-secondary);
    white-space: normal;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.25s var(--ease-out),
      visibility 0.25s;
    z-index: 110;
  }
  .nav-tip::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: var(--bg-glass-strong);
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
  }
  .nav-item:hover .nav-tip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  /* 左侧导航项（首页）气泡不要超出屏幕 */
  .nav ul li:first-child .nav-tip {
    left: 0;
    transform: translateX(0) translateY(-4px);
  }
  .nav ul li:first-child .nav-tip::before {
    left: 1rem;
  }
  .nav ul li:first-child:hover .nav-tip {
    transform: translateX(0) translateY(0);
  }
  .nav-link {
    position: relative;
    display: block;
    padding: 0.4rem 0.55rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-full);
    transition: color var(--speed) var(--ease), background-color var(--speed) var(--ease);
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--bg-glass);
  }
  .nav-link.active {
    color: var(--text);
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gradient);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--text);
    transition: background-color var(--speed) var(--ease), color var(--speed) var(--ease);
  }
  .icon-btn:hover {
    background: var(--bg-glass);
  }
  .menu-btn {
    display: none;
  }

  /* 主题切换图标（三态：自动 / 浅色 / 深色） */
  .i-sun,
  .i-moon,
  .i-auto {
    display: none;
  }
  /* 自动模式：显示「自动」图标 */
  html[data-theme-mode='auto'] .i-auto {
    display: inline-flex;
  }
  /* 浅色模式：显示月亮（提示可切深色） */
  html[data-theme-mode='light'] .i-moon {
    display: inline-flex;
  }
  /* 深色模式：显示太阳（提示可切浅色） */
  html[data-theme-mode='dark'] .i-sun {
    display: inline-flex;
  }

  .mobile-menu {
    display: none;
    border-top: 1px solid var(--border);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
  }
  .mobile-menu ul {
    list-style: none;
    padding: 0.75rem var(--gutter) 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 0.5rem;
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: color var(--speed) var(--ease), background-color var(--speed) var(--ease);
  }
  .mobile-link-icon {
    display: inline-flex;
    color: var(--text-tertiary);
  }
  .mobile-link:hover,
  .mobile-link.active {
    color: var(--text);
    background: var(--bg-glass);
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    .mobile-menu:not([hidden]) {
      display: block;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // ===== Header 打字机效果 =====
  const headerTw = document.getElementById('header-typewriter');
  const headerGhost = document.querySelector('.tag-ghost');
  if (headerTw && headerGhost) {
    const full = headerGhost.textContent || '';
    let hi = 0;
    let hDeleting = false;
    function hTick() {
      if (!hDeleting) {
        hi++;
        headerTw.textContent = full.slice(0, hi);
        if (hi >= full.length) {
          hDeleting = true;
          setTimeout(hTick, 2400);
          return;
        }
        setTimeout(hTick, 95);
      } else {
        hi--;
        headerTw.textContent = full.slice(0, hi);
        if (hi <= 0) {
          hDeleting = false;
          setTimeout(hTick, 600);
          return;
        }
        setTimeout(hTick, 48);
      }
    }
    setTimeout(hTick, 300);
  }

  const themeBtn = document.getElementById('theme-toggle');

  function themeByTime() {
    const h = new Date().getHours();
    return h >= 6 && h < 18 ? 'light' : 'dark';
  }

  function applyTheme(mode) {
    const root = document.documentElement;
    let theme = mode;
    if (mode === 'auto') {
      theme = themeByTime();
    }
    root.setAttribute('data-theme', theme);
    root.setAttribute('data-theme-mode', mode);
  }

  function currentMode() {
    return document.documentElement.getAttribute('data-theme-mode') || 'auto';
  }

  themeBtn?.addEventListener('click', () => {
    const order = ['auto', 'light', 'dark'];
    const cur = currentMode();
    const next = order[(order.indexOf(cur) + 1) % order.length];
    applyTheme(next);
    try {
      localStorage.setItem('theme', next);
    } catch (_) {
      /* 忽略隐私模式下 localStorage 不可用 */
    }
  });

  // 自动模式下按当地时间切换：每 30 秒检查一次，跨时段自动更新
  setInterval(() => {
    if (currentMode() === 'auto') {
      applyTheme('auto');
    }
  }, 30000);

  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const open = menu?.hasAttribute('hidden');
    if (open) menu?.removeAttribute('hidden');
    else menu?.setAttribute('hidden', '');
    menuBtn?.setAttribute('aria-expanded', String(open));
  });
</script>
