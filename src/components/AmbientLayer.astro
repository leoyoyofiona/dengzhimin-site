<script is:inline>
  (function () {
    // ===== 1. 当前时间：年月日 星期 =====
    var clockEl = document.getElementById('ambient-clock');
    function pad(n) {
      return n < 10 ? '0' + n : '' + n;
    }
    function weekCN(i) {
      return ['日', '一', '二', '三', '四', '五', '六'][i];
    }
    function tick() {
      if (!clockEl) return;
      var d = new Date();
      clockEl.textContent =
        d.getFullYear() +
        '年' +
        (d.getMonth() + 1) +
        '月' +
        d.getDate() +
        '日 星期' +
        weekCN(d.getDay()) +
        ' ' +
        pad(d.getHours()) +
        ':' +
        pad(d.getMinutes());
    }
    tick();
    setInterval(tick, 30000);

    // ===== 2. 天气：按访问者 IP 定位城市，open-meteo 取天气 =====
    var weatherEl = document.getElementById('ambient-weather');
    var iconEl = document.getElementById('aw-icon');
    var textEl = document.getElementById('aw-text');
    var bgEl = document.getElementById('weather-bg');

    // weathercode → { icon, label, effect, sky }
    function weatherInfo(code, isDay, windKmh) {
      var e = { icon: '☀️', label: '晴', effect: 'none', sky: 'sun' };
      if (code === 0) e = { icon: isDay ? '☀️' : '🌙', label: '晴', effect: 'none', sky: 'sun' };
      else if (code === 1) e = { icon: '🌤️', label: '大致晴朗', effect: 'none', sky: 'sun' };
      else if (code === 2) e = { icon: '⛅', label: '多云', effect: 'none', sky: 'cloud-sun' };
      else if (code === 3) e = { icon: '☁️', label: '阴', effect: 'none', sky: 'cloud' };
      else if (code === 45 || code === 48) e = { icon: '🌫️', label: '雾', effect: 'fog', sky: 'fog' };
      else if (code >= 51 && code <= 57) e = { icon: '🌦️', label: '毛毛雨', effect: 'drizzle', sky: 'drizzle' };
      else if ((code >= 61 && code <= 67) || code === 80 || code === 81) e = { icon: '🌧️', label: '雨', effect: 'rain', sky: 'rain' };
      else if (code === 82) e = { icon: '⛈️', label: '大雨', effect: 'rain-heavy', sky: 'rain' };
      else if (code >= 71 && code <= 77) e = { icon: '🌨️', label: '雪', effect: 'snow', sky: 'snow' };
      else if (code === 85 || code === 86) e = { icon: '🌨️', label: '阵雪', effect: 'snow', sky: 'snow' };
      else if (code >= 95) e = { icon: '⛈️', label: '雷暴', effect: 'storm', sky: 'storm' };
      if (windKmh > 40) {
        e.icon = e.icon + ' 💨';
        e.effect = e.effect === 'none' ? 'wind' : e.effect + '-wind';
      }
      return e;
    }

    function renderWeatherBG(effect, sky) {
      if (!bgEl) return;
      bgEl.innerHTML = '';
      // 右上角天空图标：表达当前天气（太阳 / 云 / 雨 / 雪 / 雷暴 / 雾）
      var skyEl = document.createElement('div');
      skyEl.className = 'w-sky';
      skyEl.setAttribute('data-sky', sky || 'sun');
      bgEl.appendChild(skyEl);
      var count = 0;
      if (effect === 'rain' || effect === 'rain-heavy' || effect === 'drizzle' || effect === 'rain-wind') {
        count = effect === 'rain-heavy' ? 140 : effect === 'drizzle' ? 55 : 95;
        for (var i = 0; i < count; i++) {
          var d = document.createElement('span');
          d.className = 'w-drop';
          d.style.left = Math.random() * 100 + '%';
          d.style.height = 22 + Math.random() * 26 + 'px';
          d.style.animationDuration = 0.55 + Math.random() * 0.7 + 's';
          d.style.animationDelay = Math.random() * 2 + 's';
          bgEl.appendChild(d);
        }
      } else if (effect === 'snow' || effect === 'snow-wind') {
        for (var j = 0; j < 70; j++) {
          var f = document.createElement('span');
          f.className = 'w-flake';
          f.style.left = Math.random() * 100 + '%';
          f.style.animationDuration = 4.5 + Math.random() * 4.5 + 's';
          f.style.animationDelay = Math.random() * 6 + 's';
          f.style.opacity = 0.5 + Math.random() * 0.5;
          bgEl.appendChild(f);
        }
      } else if (effect === 'storm' || effect === 'storm-wind') {
        // 雷暴：闪电 + 雨
        var fl = document.createElement('span');
        fl.className = 'w-flash';
        bgEl.appendChild(fl);
        for (var k = 0; k < 110; k++) {
          var dd = document.createElement('span');
          dd.className = 'w-drop';
          dd.style.left = Math.random() * 100 + '%';
          dd.style.height = 24 + Math.random() * 28 + 'px';
          dd.style.animationDuration = 0.5 + Math.random() * 0.6 + 's';
          dd.style.animationDelay = Math.random() * 2 + 's';
          bgEl.appendChild(dd);
        }
      } else if (effect === 'wind') {
        for (var w = 0; w < 12; w++) {
          var g = document.createElement('span');
          g.className = 'w-gust';
          g.style.top = Math.random() * 100 + '%';
          g.style.animationDuration = 3 + Math.random() * 3 + 's';
          g.style.animationDelay = Math.random() * 4 + 's';
          bgEl.appendChild(g);
        }
      } else if (effect === 'fog') {
        // 雾：轻微缓慢漂移的横条
        for (var m = 0; m < 8; m++) {
          var fg = document.createElement('span');
          fg.className = 'w-gust';
          fg.style.top = Math.random() * 100 + '%';
          fg.style.width = 200 + Math.random() * 300 + 'px';
          fg.style.animationDuration = 12 + Math.random() * 8 + 's';
          fg.style.animationDelay = Math.random() * 6 + 's';
          fg.style.opacity = 0.25;
          bgEl.appendChild(fg);
        }
      }
    }

    // 带超时的 fetch 辅助（大陆网络抖动时快速失败，不长时间挂起）
    function wfetch(url, ms) {
      var ctrl = new AbortController();
      var timer = setTimeout(function () { ctrl.abort(); }, ms || 6000);
      return fetch(url, { signal: ctrl.signal }).finally(function () { clearTimeout(timer); });
    }

    // IP 定位多源 fallback：任一成功即返回 {lat, lon, city}，提高大陆可用性
    var GEO_SOURCES = [
      { url: 'https://ipwho.is/', parse: function (d) { return d && d.success !== false && d.latitude !== undefined ? { lat: d.latitude, lon: d.longitude, city: d.city || '' } : null; } },
      { url: 'https://ipinfo.io/json', parse: function (d) { var c = d && d.loc ? d.loc.split(',') : []; return c.length === 2 ? { lat: parseFloat(c[0]), lon: parseFloat(c[1]), city: d.city || '' } : null; } },
      { url: 'http://ip-api.com/json/', parse: function (d) { return d && d.status === 'success' ? { lat: d.lat, lon: d.lon, city: d.city || '' } : null; } },
    ];
    function locate() {
      function tryOne(i) {
        if (i >= GEO_SOURCES.length) return Promise.reject(new Error('geo all failed'));
        var src = GEO_SOURCES[i];
        return wfetch(src.url, 5000)
          .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
          .then(function (d) {
            var p = src.parse(d);
            return p ? p : Promise.reject();
          })
          .catch(function () { return tryOne(i + 1); });
      }
      return tryOne(0);
    }

    (function loadWeather() {
      if (!weatherEl || !bgEl) return;
      locate()
        .then(function (geo) {
          // open-meteo 天气（免费，无需 key；大陆一般可直连）
          var api =
            'https://api.open-meteo.com/v1/forecast?latitude=' +
            geo.lat +
            '&longitude=' +
            geo.lon +
            '&current_weather=true&timezone=auto';
          return wfetch(api, 7000).then(function (r2) {
            if (!r2.ok) return Promise.reject();
            return r2.json().then(function (w) {
              return { city: geo.city, w: w };
            });
          });
        })
        .then(function (data) {
          var cw = data.w.current_weather;
          var hour = new Date().getHours();
          var info = weatherInfo(cw.weathercode, hour >= 6 && hour < 19, cw.windspeed);
          weatherEl.hidden = false;
          iconEl.textContent = info.icon;
          textEl.textContent = (data.city || defaultCity) + ' · ' + info.label + ' ' + Math.round(cw.temperature) + '°C';
          renderWeatherBG(info.effect, info.sky);
        })
        .catch(function () {
          // 定位或天气失败：隐藏天气，保持时间显示
          if (weatherEl) weatherEl.hidden = true;
        });
    })();

    // ===== 3. 全站建议弹幕（顶部飘过 + 右下角发弹幕） =====
    var SUG_API = 'https://1303737693-hqp1nw586s.ap-shanghai.tencentscf.com/api/suggestions';
    var dmLayer = document.getElementById('dm-layer');
    var dmSend = document.getElementById('dm-send');
    var dmOpen = document.getElementById('dm-open');
    var dmCard = document.getElementById('dm-card');
    var dmName = document.getElementById('dm-name');
    var dmText = document.getElementById('dm-text');
    var dmSendBtn = document.getElementById('dm-sendbtn');
    var dmCount = document.getElementById('dm-count');
    var dmStatus = document.getElementById('dm-status');
    var dmItems = []; // 建议缓存（旧→新）
    var dmIdx = 0;
    var dmTimer = null;
    var dmPaused = false;

    var DM_TRAVEL_SEC = 14; // 单条飘完时间
    var DM_NAMES = ['游客', '路过的人', '一位朋友', '访客', '你'];

    function dmFmt(t) {
      var d = new Date(t);
      var p = function (n) { return n < 10 ? '0' + n : '' + n; };
      return p(d.getHours()) + ':' + p(d.getMinutes());
    }

    function dmEsc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '"' ? '&quot;' : '&#39;';
      });
    }

    // ===== 弹幕点赞 =====
    var DM_LIKED_KEY = 'leodeng:dm-liked'; // 已点赞 time 列表（localStorage）
    function dmReadLiked() {
      try {
        var v = JSON.parse(localStorage.getItem(DM_LIKED_KEY) || '[]');
        return Array.isArray(v) ? v : [];
      } catch (e) { return []; }
    }
    function dmIsLiked(time) {
      return dmReadLiked().indexOf(String(time)) !== -1;
    }
    function dmMarkLiked(time) {
      try {
        var v = dmReadLiked();
        v.push(String(time));
        if (v.length > 400) v = v.slice(-300); // 只记最近 300 条，防无限增长
        localStorage.setItem(DM_LIKED_KEY, JSON.stringify(v));
      } catch (e) {}
    }
    // 点击后在该位置跳出一个大拇指
    function dmPopThumb(x, y) {
      var el = document.createElement('span');
      el.className = 'dm-thumb-pop';
      el.textContent = '👍';
      el.style.left = x + 'px';
      el.style.top = y + 'px';
      document.body.appendChild(el);
      setTimeout(function () { el.remove(); }, 950);
    }
    // 点击后在该位置跳出"+1"飘字
    function dmPopPlus(x, y) {
      var el = document.createElement('span');
      el.className = 'dm-plus-pop';
      el.textContent = '+1';
      el.style.left = x + 'px';
      el.style.top = y + 'px';
      document.body.appendChild(el);
      setTimeout(function () { el.remove(); }, 900);
    }
    // 点赞重复提示条
    var dmToastEl = null;
    var dmToastTimer = null;
    function dmToast(msg) {
      if (!dmToastEl) {
        dmToastEl = document.createElement('div');
        dmToastEl.className = 'dm-toast';
        dmToastEl.setAttribute('role', 'status');
        document.body.appendChild(dmToastEl);
      }
      dmToastEl.textContent = msg;
      dmToastEl.classList.add('show');
      if (dmToastTimer) clearTimeout(dmToastTimer);
      dmToastTimer = setTimeout(function () {
        dmToastEl.classList.remove('show');
      }, 1800);
    }

    // 给一条弹幕绑定点赞交互（乐观更新：点了立即 +1，不等后端）
    function dmBindLike(span, item) {
      var time = Number(item && item.time);
      if (!time) return;
      var likeBtn = span.querySelector('.dm-like-btn');
      if (!likeBtn) return;
      var numEl = span.querySelector('.dm-like-num');
      var likesEl = span.querySelector('.dm-likes');
      function renderNum(n) {
        if (numEl) numEl.textContent = n > 0 ? String(n) : '';
        if (likesEl) {
          likesEl.textContent = n > 0 ? '👍 ' + n : '';
        }
      }
      function updateLikedUI() {
        if (likeBtn) likeBtn.classList.toggle('is-liked', dmIsLiked(time));
        renderNum(item.likes || 0);
      }
      updateLikedUI();
      likeBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        e.preventDefault();
        if (dmIsLiked(time)) {
          // 本浏览器已赞过：给提示，不再 +1
          dmToast('你已经点赞过了 👍');
          return;
        }
        // —— 乐观更新：立即 +1 并显示 ——
        dmMarkLiked(time);
        item.likes = (Number(item.likes) || 0) + 1;
        updateLikedUI();
        var rect = likeBtn.getBoundingClientRect();
        var cx = rect.left + rect.width / 2;
        var cy = rect.top;
        dmPopPlus(cx, cy);              // "+1" 飘字（即时反馈）
        dmPopThumb(cx, cy - 6);          // 大拇指导弹
        // 后台同步（失败则回滚，让用户可重试）
        var ctrl = new AbortController();
        var timer = setTimeout(function () { ctrl.abort(); }, 6000);
        fetch(SUG_API + '/like', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ time: time }),
          signal: ctrl.signal,
        })
          .then(function (r) { clearTimeout(timer); return r.json().catch(function () { return {}; }); })
          .then(function (res) {
            if (res && res.ok) {
              // 以后端返回的权威计数为准（防本地缓存与云端不一致）
              item.likes = Number(res.likes) || item.likes;
              updateLikedUI();
            } else {
              rollback();
            }
          })
          .catch(function () {
            clearTimeout(timer);
            rollback();
          });
        function rollback() {
          // 网络失败：撤掉本地点赞，允许重试
          try {
            var v = dmReadLiked().filter(function (x) { return x !== String(time); });
            localStorage.setItem(DM_LIKED_KEY, JSON.stringify(v));
          } catch (_) {}
          item.likes = Math.max(0, (Number(item.likes) || 0) - 1);
          updateLikedUI();
        }
      });
    }

    // 顶部发射一条弹幕
    function dmFire(item) {
      if (!dmLayer || dmPaused || !item || !item.text) return;
      var span = document.createElement('span');
      span.className = 'dm-item';
      var who = (item.name && item.name !== '匿名' && item.name !== '匿名 ') ? item.name : DM_NAMES[Math.floor(Math.random() * DM_NAMES.length)];
      var likesN = Number(item.likes) || 0;
      span.innerHTML =
        '<span class="dm-who">' + dmEsc(who) + '</span>' +
        dmEsc(item.text) +
        '<span class="dm-likes">' + (likesN > 0 ? '👍 ' + likesN : '') + '</span>' +
        '<span class="dm-actions"><button type="button" class="dm-like-btn" aria-label="点赞">👍<span class="dm-like-num"></span></button></span>';
      dmLayer.appendChild(span);
      span.addEventListener('animationend', function () { span.remove(); });
      span.style.animationDuration = DM_TRAVEL_SEC + 's';
      // 点击弹幕本体（非按钮区域）也弹出大拇指 + 点赞（触屏友好）
      span.addEventListener('click', function (e) {
        if (e.target && e.target.closest && e.target.closest('.dm-like-btn')) return; // 按钮已单独处理
        var btn = span.querySelector('.dm-like-btn');
        if (btn) btn.click();
      });
      dmBindLike(span, item);
    }

    // hover 任一条弹幕 → 所有弹幕暂停（防止后方的撞上来）；移开全部后继续
    function dmItemOn(e) {
      if (!e.target || !e.target.closest) return;
      if (e.target.closest('.dm-item')) dmLayer.classList.add('pause-all');
    }
    function dmItemOut(e) {
      var to = e.relatedTarget;
      var leavingItem = e.target && e.target.closest && e.target.closest('.dm-item');
      var enteringItem = to && to.closest ? to.closest('.dm-item') : null;
      // 从一条弹幕移到另一条：保持暂停
      if (leavingItem && !enteringItem) dmLayer.classList.remove('pause-all');
    }
    if (dmLayer) {
      dmLayer.addEventListener('mouseover', dmItemOn);
      dmLayer.addEventListener('mouseout', dmItemOut);
    }

    function dmNext() {
      if (dmPaused || !dmItems.length) return;
      dmFire(dmItems[dmIdx % dmItems.length]);
      dmIdx++;
      dmTimer = setTimeout(dmNext, 4000 + Math.random() * 6000); // 4–10 秒一条
    }

    // 拉取建议并开始播放
    function dmLoad() {
      var ctrl = new AbortController();
      var timer = setTimeout(function () { ctrl.abort(); }, 6000);
      fetch(SUG_API, { signal: ctrl.signal })
        .then(function (r) { clearTimeout(timer); return r.ok ? r.json() : Promise.reject(); })
        .then(function (list) {
          dmItems = Array.isArray(list) ? list : [];
          dmIdx = 0;
          if (dmItems.length && !dmTimer && !dmPaused) dmNext();
        })
        .catch(function () { clearTimeout(timer); /* 网络不可用：静默，不打扰 */ });
    }

    // 打开/关闭发送卡片（支持多个入口按钮：桌面导航 + 移动右下角）
    function dmCloseCard() {
      if (dmCard && !dmCard.hidden) {
        dmCard.hidden = true;
        dmSend.classList.remove('open');
      }
    }
    if (dmCard) {
      const dmBtns = document.querySelectorAll('.dm-open');
      dmBtns.forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation(); // 阻止冒泡到 document（避免开卡同时又被外部点击关闭）
          var show = dmCard.hidden;
          dmCard.hidden = !show;
          dmSend.classList.toggle('open', show);
          if (show) dmText.focus();
        });
      });
      // 点击卡片外部任意处：关闭输入卡
      document.addEventListener('click', function (e) {
        if (dmCard.hidden) return;
        var t = e.target;
        if (!t || !t.closest) return;
        // 点在卡片内或两个开关按钮上：不关闭
        if (t.closest('#dm-card') || t.closest('.dm-open')) return;
        dmCloseCard();
      });
      // Esc 也关闭
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') dmCloseCard();
      });
