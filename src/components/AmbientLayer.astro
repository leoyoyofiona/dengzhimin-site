    var amPanel = document.getElementById('am-panel');
    var amIcon = document.getElementById('am-icon');
    var amTitle = document.getElementById('am-title');
    var amSong = document.getElementById('am-song');
    var amPlay = document.getElementById('am-play');
    var amPrev = document.getElementById('am-prev');
    var amNext = document.getElementById('am-next');
    var amProgress = document.getElementById('am-progress-bar');

    var audio = null;
    var isPlaying = false;
    var playTimer = null;
    var curTitle = '';
    var curSongId = '';

    // ===== 随机音乐：CC 授权现代音乐（Internet Archive 镜像） =====
    // 正规来源：
    //   0) COS 音乐库（腾讯云，大陆可直连）——用户自备曲库，playlist.json 清单
    //   1) Jamendo 全量镜像（约 29.5 万首，CC 授权现代音乐）——搜索 q: jamendo AND mediatype:audio
    //   2) Free Music Archive 镜像（约 1.7 万集合，带 licenseurl CC 授权）——搜索 q: freemusicarchive AND mediatype:audio
    // 每个条目是一张专辑（含多首 mp3），随机选专辑 → 随机选曲目。
    // 均为 CC 授权，可合法流式播放，无侵权风险。
    var COS_BASE = 'https://thesis-music-hk-1303737693.cos.ap-hongkong.myqcloud.com';
    var MUSIC_SOURCES = [
      { key: 'jamendo', label: 'Jamendo', query: 'jamendo AND mediatype:audio', rows: 24 },
      { key: 'fma', label: 'Free Music Archive', query: 'freemusicarchive AND mediatype:audio', rows: 24 },
    ];
    // 兜底歌单（镜像不可用时）：公共领域经典（中文民歌 + 英文标准曲）
    var CLASSIC_SONGS = [
      'Moon River', 'Fly Me to the Moon', 'My Way', "Can't Help Falling in Love",
      'Edelweiss', 'Singin in the Rain', 'La Vie en Rose', 'Auld Lang Syne',
      'Greensleeves', 'Scarborough Fair', 'Amazing Grace', 'What a Wonderful World',
      'Over the Rainbow', 'Yesterday', 'Stand by Me', 'Unchained Melody',
      'Smoke Gets in Your Eyes', 'Dream a Little Dream of Me', 'Blue Moon',
      'Cheek to Cheek', 'The Way You Look Tonight', 'Autumn Leaves',
      '茉莉花', '康定情歌', '在那遥远的地方', '南泥湾',
      '友谊地久天长', '送别', '小河淌水', '沂蒙山小调', '彩云追月',
    ];
    // 记录失败：镜像条目 identifier / 兜底歌名，避免无限重试
    var failedIds = {};
    var failedSongs = {};

    function randomClassicSong() {
      var candidates = CLASSIC_SONGS.filter(function (s) {
        return !failedSongs[s];
      });
      if (!candidates.length) {
        failedSongs = {};
        candidates = CLASSIC_SONGS.slice();
      }
      return candidates[Math.floor(Math.random() * candidates.length)];
    }

    // 从 IA 镜像随机取一张专辑（Jamendo / FMA 轮流）
    function pickRandomAlbum() {
      var src = MUSIC_SOURCES[Math.floor(Math.random() * MUSIC_SOURCES.length)];
      var q = encodeURIComponent(src.query);
      return fetch(
        'https://archive.org/advancedsearch.php?q=' +
          q +
          '&fl%5B%5D=identifier&fl%5B%5D=title&fl%5B%5D=downloads&rows=' +
          src.rows +
          '&sort%5B%5D=downloads+desc&output=json'
      )
        .then(function (r) {
          return r.ok ? r.json() : Promise.reject(new Error('search failed'));
        })
        .then(function (d) {
          var docs = (d.response && d.response.docs) || [];
          // 过滤已失败的条目；全失败则整体重试
          var fresh = docs.filter(function (doc) {
            return !failedIds[doc.identifier];
          });
          var pool = fresh.length ? fresh : docs;
          if (!pool.length) return Promise.reject(new Error('no docs'));
          // 随机选一张专辑（下载量高的权重略大）
          var chosen = pool[Math.floor(Math.random() * Math.min(pool.length, 12))];
          return fetch('https://archive.org/metadata/' + encodeURIComponent(chosen.identifier)).then(function (r2) {
            if (!r2.ok) throw new Error('metadata failed');
            return r2.json();
          });
        })
        .then(function (meta) {
          var files = meta.files || [];
          var audioFiles = files.filter(function (f) {
            return /\.(mp3|ogg|m4a)$/i.test(f.name) && !/64kb|_64\.mp3|\.ogg$/i.test(f.name);
          });
          var pool = audioFiles.length ? audioFiles : files.filter(function (f) {
            return /\.(mp3|ogg|m4a)$/i.test(f.name);
          });
          if (!pool.length) throw new Error('no audio');
          var f = pool[Math.floor(Math.random() * pool.length)];
          var md = meta.metadata || {};
          var artist = md.artist || md.creator || '';
          var album = md.album || md.title || '';
          var track = f.title || String(f.name).replace(/\.[^.]+$/, '');
          // 显示：艺术家 - 曲名（专辑）
          var parts = [artist, track].filter(Boolean);
          var title = parts.join(' - ');
          if (album && album !== track && album !== md.title) title += '（' + album + '）';
          return {
            url:
              'https://archive.org/download/' +
              encodeURIComponent(md.identifier) +
              '/' +
              encodeURIComponent(f.name),
            title: String(title).slice(0, 70),
            source: 'CC 授权音乐',
            id: md.identifier,
            fallback: false,
          };
        });
    }

    // 兜底：按歌名在 IA 搜索公共领域/CC 录音（优先 1980 年前录音）
    function pickClassicSong() {
      var songName = randomClassicSong();
      var q = encodeURIComponent('"' + songName + '" AND mediatype:audio');
      return fetch(
        'https://archive.org/advancedsearch.php?q=' +
          q +
          '&fl%5B%5D=identifier&fl%5B%5D=title&fl%5B%5D=date&fl%5B%5D=downloads&rows=12&sort%5B%5D=downloads+desc&output=json'
      )
        .then(function (r) {
          return r.ok ? r.json() : Promise.reject();
        })
        .then(function (d) {
          var docs = (d.response && d.response.docs) || [];
          if (!docs.length) {
            failedSongs[songName] = true;
            return Promise.reject();
          }
          var pool = docs.filter(function (doc) {
            var dt = String(doc.date || '');
            var y = parseInt(dt, 10);
            return y > 0 && y < 1980;
          });
          var chosen = (pool.length ? pool : docs)[Math.floor(Math.random() * Math.min(pool.length || docs.length, 4))];
          return fetch('https://archive.org/metadata/' + encodeURIComponent(chosen.identifier)).then(function (r2) {
            return r2.ok ? r2.json() : Promise.reject();
          });
        })
        .then(function (meta) {
          var files = meta.files || [];
          var audioFiles = files.filter(function (f) {
            return /\.(mp3|ogg|m4a)$/i.test(f.name) && !/64kb|_64\.mp3|\.ogg$/i.test(f.name);
          });
          var pool = audioFiles.length ? audioFiles : files.filter(function (f) {
            return /\.(mp3|ogg|m4a)$/i.test(f.name);
          });
          if (!pool.length) return Promise.reject();
          var f = pool[Math.floor(Math.random() * pool.length)];
          var title = meta.metadata && (meta.metadata.title || meta.metadata.artist) || '未知曲目';
          return {
            url: 'https://archive.org/download/' + encodeURIComponent(meta.metadata.identifier) + '/' + encodeURIComponent(f.name),
            title: String(title).slice(0, 60),
            source: '经典',
            id: songName,
            fallback: true,
          };
        })
        .catch(function (e) {
          failedSongs[songName] = true;
          return Promise.reject(e);
        });
    }

    // ===== COS 音乐库（腾讯云香港，大陆/海外均可直连；用户自备 mp3） =====
    // 播放清单：优先站点同源 public/music/playlist.json（构建时由脚本生成，无 CORS 问题）
    var cosTried = false;
    var cosTracks = [];
    var cosUsed = {};
    function loadCosTracks() {
      if (cosTried) return Promise.resolve(cosTracks);
      cosTried = true;
      var ctrl = new AbortController();
      var timer = setTimeout(function () { ctrl.abort(); }, 6000);
      function parse(d) {
        var arr = (d && Array.isArray(d.tracks)) ? d.tracks : [];
        cosTracks = arr.filter(function (t) { return t && t.url; });
        return cosTracks;
      }
      // 同源清单（随站点发布）；失败则尝试 COS 远程清单（加歌后上传的）
      var local = location.origin + '/music/playlist.json';
      return fetch(local, { signal: ctrl.signal })
        .then(function (r) { clearTimeout(timer); return r.ok ? r.json() : Promise.reject(); })
        .then(parse)
        .catch(function () {
          return fetch(COS_BASE + '/music/playlist.json', { signal: ctrl.signal })
            .then(function (r) { clearTimeout(timer); return r.ok ? r.json() : Promise.reject(); })
            .then(parse)
            .catch(function () { clearTimeout(timer); return []; });
        });
    }
    // 从 COS 随机选一首未播过的
    function pickCosTrack() {
      return loadCosTracks().then(function (tracks) {
        var fresh = tracks.filter(function (t) { return !cosUsed[t.url]; });
        var pool = fresh.length ? fresh : tracks;
        if (!pool.length) return Promise.reject(new Error('cos empty'));
        var t = pool[Math.floor(Math.random() * pool.length)];
        cosUsed[t.url] = true;
        return {
          url: t.url.indexOf('http') === 0 ? t.url : COS_BASE + '/' + t.url.replace(/^\//, ''),
          title: t.title || String(t.url.split('/').pop()).replace(/\.[^.]+$/, ''),
          source: 'COS 音乐库',
          id: t.url,
          fallback: false,
        };
      });
    }

    // 主路径：COS 自备曲库 → CC 镜像 → 失败降级到经典兜底
    function pickRandomSong() {
      return pickCosTrack().catch(function () {
        return pickRandomAlbum();
      }).catch(function () {
        return pickClassicSong();
      });
    }

    function setPlayingUI(playing) {
      isPlaying = playing;
      amPlay.textContent = playing ? '⏸' : '▶';
      if (amToggle) amToggle.classList.toggle('playing', playing);
      amIcon.textContent = playing ? '🎶' : '🎵';
      if (playing && audio) {
        amSong.textContent = '正在播放：' + curTitle;
        amTitle.textContent = '随机音乐 · 30 分钟后自动停止';
      } else if (audio) {
        amSong.textContent = '已暂停：' + curTitle;
        amTitle.textContent = '随机音乐';
      }
    }

    function startTimer() {
      // 30 分钟自动停止
      if (playTimer) clearTimeout(playTimer);
      playTimer = setTimeout(function () {
        if (audio) {
          audio.pause();
          setPlayingUI(false);
          amSong.textContent = '已播放 30 分钟，休息一下耳朵～';
          amTitle.textContent = '随机音乐';
          amProgress.style.width = '0%';
        }
      }, 30 * 60000);
    }

    // 一次性手势解锁（Safari/移动端）：用独立临时音源播放一次静音，
    // 不接 ended 事件、不影响主播放 audio，用完即弃
    var unlocked = false;
    function unlockAutoplay() {
      if (unlocked) return;
      try {
        var u = new Audio();
        u.volume = 0.0001;
        u.preload = 'auto';
        u.src = 'data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=';
        u.play().then(function () {
          unlocked = true;
          u.src = '';
        }).catch(function () {});
      } catch (e) {}
    }

    // 尝试次数过多仍失败 → 探测网络是否被墙（大陆等地区连不上 archive.org）
    var musicFailCount = 0;
    var musicLimitedHint = false;
    function maybeLimitedHint() {
      musicFailCount++;
      if (musicLimitedHint || musicFailCount < 2) return;
      // 探测 Cloudflare API（与 archive.org 同属被墙目标）：连不上则提示地区受限
      try {
        var ctrl = new AbortController();
        var timer = setTimeout(function () { ctrl.abort(); }, 4000);
        fetch('https://1303737693-hqp1nw586s.ap-shanghai.tencentscf.com/api/health', { signal: ctrl.signal })
          .then(function (r) {
            clearTimeout(timer);
            if (!r.ok) throw new Error('bad');
            // API 可达（说明不是被墙，可能是音乐库临时问题）
            amSong.textContent = '音乐库暂时没响应，稍后再试～';
          })
          .catch(function () {
            clearTimeout(timer);
            musicLimitedHint = true;
            amSong.textContent = '当前网络无法访问在线音乐库，试试其他网络～';
          });
      } catch (e) {
        musicLimitedHint = true;
        amSong.textContent = '当前网络无法访问在线音乐库，试试其他网络～';
      }
    }

    function playSong() {
      // Safari/移动端自动播放限制：fetch 异步结束后 play() 已脱离用户
      // 手势上下文会被拒绝，故先解锁一次。
      unlockAutoplay();
      if (!audio) {
        audio = new Audio();
        audio.preload = 'auto';
        // 挂到 DOM 便于调试与进度显示（不显示控件）
        audio.style.display = 'none';
        document.body.appendChild(audio);
        audio.addEventListener('ended', function () {
          // 一首结束自动下一曲
          playSong();
        });
        audio.addEventListener('timeupdate', function () {
          if (audio.duration) {
            var pct = (audio.currentTime / audio.duration) * 100;
            amProgress.style.width = pct + '%';
          }
        });
        audio.addEventListener('error', function () {
          // 播放失败：标记该条目失败后换下一首
          if (curSongId) failedIds[curSongId] = true;
          if (musicLimitedHint) {
            amSong.textContent = '当前网络无法访问在线音乐库，试试其他网络～';
            return;
          }
          playSong();
        });
      }
      pickRandomSong()
        .then(function (song) {
          // 显示曲目名（CC 镜像：艺术家 - 曲名；兜底：经典曲目名）
          curTitle = song.title || song.id;
          curSongId = song.id || '';
          audio.src = song.url;
          audio.load();
          var p = audio.play();
          if (p && typeof p.then === 'function') {
            p.then(function () {
              setPlayingUI(true);
              startTimer();
            }).catch(function () {
              if (song.id) failedIds[song.id] = true;
              if (musicLimitedHint) {
                amSong.textContent = '当前网络无法访问在线音乐库，试试其他网络～';
                return;
              }
              maybeLimitedHint();
              amSong.textContent = '这首没找到合适录音，换一首…';
              setTimeout(playSong, 1500);
            });
          } else {
            setPlayingUI(true);
            startTimer();
          }
        })
        .catch(function () {
          maybeLimitedHint();
          amSong.textContent = '暂时没找到合适的歌，再试一次？';
          setTimeout(function () {
            amSong.textContent = '点击播放，随机来一首歌（COS 音乐库 / CC 授权）';
          }, 2500);
        });
    }

    function togglePlay() {
      if (!audio) {
        playSong();
        return;
      }
      if (isPlaying) {
        audio.pause();
        setPlayingUI(false);
      } else {
        audio.play().then(function () {
          setPlayingUI(true);
          startTimer();
        }).catch(function () {});
      }
    }

    function nextSong() {
      if (audio) {
        audio.pause();
        audio.src = '';
      }
      amProgress.style.width = '0%';
      playSong();
    }

    // 面板：hover 显示 / 移出隐藏（触屏点按切换）
    if (musicWrap && amPanel) {
      // 鼠标是否还在音乐区域（按钮或面板）内
      function insideMusic(el) {
        return el && musicWrap.contains(el);
      }
      musicWrap.addEventListener('mouseenter', function () {
        amPanel.hidden = false;
      });
      musicWrap.addEventListener('mouseleave', function (e) {
        // 若鼠标移入了面板（子元素），不隐藏
        if (insideMusic(e.relatedTarget)) return;
        amPanel.hidden = true;
      });
      amPanel.addEventListener('mouseenter', function () {
        amPanel.hidden = false;
      });
      amPanel.addEventListener('mouseleave', function (e) {
        if (insideMusic(e.relatedTarget)) return;
        amPanel.hidden = true;
      });
      amToggle.addEventListener('click', function (e) {
        e.stopPropagation();
        // 触屏/点击：展开面板；未在播放则直接开始播放，再点切换播放/暂停
        amPanel.hidden = false;
        togglePlay();
      });
      if (amPlay) amPlay.addEventListener('click', function (e) {
        e.stopPropagation();
        togglePlay();
      });
      if (amPrev) amPrev.addEventListener('click', function (e) {
        e.stopPropagation();
        // 上一曲：重播当前（无历史列表），简单回到开头
        if (audio && audio.currentTime > 3) {
          audio.currentTime = 0;
        } else {
          nextSong();
        }
      });
      if (amNext) amNext.addEventListener('click', function (e) {
        e.stopPropagation();
        nextSong();
      });
    }
  })();
</script>
