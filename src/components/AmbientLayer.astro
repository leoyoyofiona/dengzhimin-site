---
// 环境层：当前时间 + 天气（按访问者 IP 定位）+ 天气背景动画 + 工作/休息提醒
// 所有页面由 BaseLayout 引入，低调呈现
const now = new Date();
const defaultCity = '你所在的城市';
---

<!-- 时间与天气浮动条（右下角，低调） -->
<div class="ambient-bar" id="ambient-bar" aria-hidden="false">
  <div class="ambient-clock" id="ambient-clock" title="当前时间">--</div>
  <div class="ambient-weather" id="ambient-weather" title="按你的位置显示的天气" hidden>
    <span class="aw-icon" id="aw-icon"></span>
    <span class="aw-text" id="aw-text">天气加载中…</span>
  </div>
  <div class="ambient-music" id="ambient-music" title="随机播放 CC 授权音乐（Jamendo / Free Music Archive）">
    <button class="am-toggle" id="am-toggle" type="button" aria-label="随机播放音乐" title="随机播放 CC 授权音乐">
      <span class="am-icon" id="am-icon">🎵</span>
    </button>
    <div class="am-panel" id="am-panel" hidden>
      <div class="am-title" id="am-title">随机音乐</div>
      <div class="am-song" id="am-song">点击播放，随机来一首 CC 授权音乐</div>
      <div class="am-controls">
        <button class="am-btn" id="am-prev" type="button" title="上一曲" aria-label="上一曲">⏮</button>
        <button class="am-btn am-play" id="am-play" type="button" title="播放/暂停" aria-label="播放/暂停">▶</button>
        <button class="am-btn" id="am-next" type="button" title="下一曲" aria-label="下一曲">⏭</button>
      </div>
      <div class="am-progress"><span id="am-progress-bar"></span></div>
    </div>
  </div>
</div>

<!-- 天气背景动画层（不遮挡内容） -->
<div class="weather-bg" id="weather-bg" aria-hidden="true"></div>

<!-- 工作提醒 Toast -->
<div class="work-toast" id="work-toast" role="alert" hidden></div>

<style>
  /* ===== 时间与天气浮动条 ===== */
  .ambient-bar {
    position: fixed;
    right: max(0.9rem, env(safe-area-inset-right));
    bottom: max(0.9rem, env(safe-area-inset-bottom));
    z-index: 300;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.85rem;
    border-radius: var(--radius-full);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    white-space: nowrap;
    opacity: 0.78;
    transition: opacity 0.3s var(--ease);
    pointer-events: auto;
  }
  .ambient-bar:hover {
    opacity: 1;
  }
  .ambient-clock {
    font-variant-numeric: tabular-nums;
    font-weight: 550;
    color: var(--text);
  }
  .ambient-weather {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-tertiary);
  }
  .ambient-weather[hidden] {
    display: none;
  }
  .aw-icon {
    font-size: 0.95rem;
    line-height: 1;
  }
  @media (max-width: 560px) {
    .ambient-bar {
      font-size: 0.68rem;
      padding: 0.35rem 0.7rem;
    }
    .ambient-clock {
      max-width: 9.5em;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  /* ===== 随机音乐 ===== */
  .ambient-music {
    position: relative;
    margin-left: 0.15rem;
  }
  .am-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: none;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: 0.9rem;
    cursor: pointer;
    transition: background-color var(--speed) var(--ease), transform var(--speed) var(--ease);
  }
  .am-toggle:hover {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    transform: scale(1.08);
  }
  .am-toggle.playing {
    animation: am-spin 3s linear infinite;
  }
  @keyframes am-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .am-panel {
    position: absolute;
    right: 0;
    bottom: 100%;
    width: 240px;
    padding: 0.85rem 1rem 0.9rem;
    border-radius: var(--radius-lg);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    z-index: 310;
  }
  /* 面板与按钮之间的透明桥接区：鼠标平滑过渡，避免误触隐藏 */
  .am-panel::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -12px;
    height: 12px;
  }
  .am-panel[hidden] {
    display: none;
  }
  .am-title {
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--text-tertiary);
    letter-spacing: 0.05em;
    margin-bottom: 0.3rem;
  }
  .am-song {
    font-size: var(--text-sm);
    font-weight: 550;
    color: var(--text);
    line-height: 1.4;
    margin-bottom: 0.6rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .am-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
  }
  .am-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 50%;
    background: var(--bg-glass);
    color: var(--text);
    font-size: 0.85rem;
    cursor: pointer;
    transition: background-color var(--speed) var(--ease), transform var(--speed) var(--ease);
  }
  .am-btn:hover {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    transform: scale(1.08);
  }
  .am-play {
    width: 40px;
    height: 40px;
    background: var(--gradient);
    color: #fff;
    font-size: 0.95rem;
  }
  .am-play:hover {
    background: var(--gradient);
    transform: scale(1.06);
  }
  .am-progress {
    margin-top: 0.6rem;
    height: 3px;
    border-radius: 3px;
    background: var(--border);
    overflow: hidden;
  }
  .am-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--gradient);
    transition: width 0.5s linear;
  }

  /* ===== 工作/休息提醒 Toast ===== */
  .work-toast {
    position: fixed;
    left: 50%;
    top: max(4.5rem, calc(var(--header-h) + 0.75rem));
    transform: translateX(-50%);
    z-index: 500;
    max-width: min(440px, calc(100vw - 2rem));
    padding: 0.85rem 1.2rem;
    border-radius: var(--radius-lg);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: var(--shadow-lg);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text);
    text-align: center;
    opacity: 0;
    transform: translateX(-50%) translateY(-8px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
    pointer-events: none;
  }
  .work-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .work-toast.rest {
    border-color: color-mix(in srgb, #e11d48 45%, var(--border));
  }
  .work-toast .wt-emoji {
    font-size: 1.25rem;
    display: block;
    margin-bottom: 0.2rem;
  }
</style>

<style is:global>
  /* ===== 天气背景动画层（JS 动态创建元素，需全局样式） ===== */
  .weather-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .weather-bg .w-drop,
  .weather-bg .w-flake,
  .weather-bg .w-gust,
  .weather-bg .w-flash {
    position: absolute;
    top: -10%;
    display: block;
  }
  .weather-bg .w-drop {
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(180deg, transparent, rgba(96, 148, 232, 0.85));
    box-shadow: 0 0 3px rgba(96, 148, 232, 0.35);
    animation: w-fall linear infinite;
  }
  .weather-bg .w-flake {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.75);
    animation: w-fall linear infinite, w-sway ease-in-out infinite alternate;
  }
  .weather-bg .w-gust {
    width: 80px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    animation: w-gust linear infinite;
  }
  .weather-bg .w-flash {
    width: 100%;
    height: 100%;
    background: rgba(255, 244, 200, 0.2);
    animation: w-flash 4s ease-in-out infinite;
  }
  @keyframes w-fall {
    0% {
      transform: translateY(-10vh);
    }
    100% {
      transform: translateY(110vh);
    }
  }
  @keyframes w-sway {
    0% {
      margin-left: 0;
    }
    100% {
      margin-left: 18px;
    }
  }
  @keyframes w-gust {
    0% {
      transform: translateX(-15vw);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      transform: translateX(115vw);
      opacity: 0;
    }
  }
  @keyframes w-flash {
    0%,
    88%,
    100% {
      opacity: 0;
    }
    90% {
      opacity: 1;
    }
    93% {
      opacity: 0;
    }
    96% {
      opacity: 0.7;
    }
  }
  html[data-theme='dark'] .weather-bg .w-drop {
    background: linear-gradient(180deg, transparent, rgba(130, 180, 255, 0.45));
  }

</style>


<script is:inline>
  (function () {
    // ===== 1. 当前时间：年月日 星期 =====
    var clockEl = document.getElementById('ambient-clock');
    function pad(n) {
      return n < 10 ? '0' + n : '' + n;
    }
    function weekCN(i) {
      return ['日', '一', '二', '三', '四', '五', '六'][i];
    }
    function tick() {
      if (!clockEl) return;
      var d = new Date();
      clockEl.textContent =
        d.getFullYear() +
        '年' +
        (d.getMonth() + 1) +
        '月' +
        d.getDate() +
        '日 星期' +
        weekCN(d.getDay()) +
        ' ' +
        pad(d.getHours()) +
        ':' +
        pad(d.getMinutes());
    }
    tick();
    setInterval(tick, 30000);

    // ===== 2. 天气：按访问者 IP 定位城市，open-meteo 取天气 =====
    var weatherEl = document.getElementById('ambient-weather');
    var iconEl = document.getElementById('aw-icon');
    var textEl = document.getElementById('aw-text');
    var bgEl = document.getElementById('weather-bg');

    // weathercode → { icon, label, effect }
    function weatherInfo(code, isDay, windKmh) {
      var e = { icon: '☀️', label: '晴', effect: 'none' };
      if (code === 0) e = { icon: isDay ? '☀️' : '🌙', label: '晴', effect: 'none' };
      else if (code === 1) e = { icon: '🌤️', label: '大致晴朗', effect: 'none' };
      else if (code === 2) e = { icon: '⛅', label: '多云', effect: 'none' };
      else if (code === 3) e = { icon: '☁️', label: '阴', effect: 'none' };
      else if (code === 45 || code === 48) e = { icon: '🌫️', label: '雾', effect: 'fog' };
      else if (code >= 51 && code <= 57) e = { icon: '🌦️', label: '毛毛雨', effect: 'drizzle' };
      else if ((code >= 61 && code <= 67) || code === 80 || code === 81) e = { icon: '🌧️', label: '雨', effect: 'rain' };
      else if (code === 82) e = { icon: '⛈️', label: '大雨', effect: 'rain-heavy' };
      else if (code >= 71 && code <= 77) e = { icon: '🌨️', label: '雪', effect: 'snow' };
      else if (code === 85 || code === 86) e = { icon: '🌨️', label: '阵雪', effect: 'snow' };
      else if (code >= 95) e = { icon: '⛈️', label: '雷暴', effect: 'storm' };
      if (windKmh > 40) {
        e.icon = e.icon + ' 💨';
        e.effect = e.effect === 'none' ? 'wind' : e.effect + '-wind';
      }
      return e;
    }

    function renderWeatherBG(effect) {
      if (!bgEl) return;
      bgEl.innerHTML = '';
      var count = 0;
      if (effect === 'rain' || effect === 'rain-heavy' || effect === 'drizzle' || effect === 'rain-wind') {
        count = effect === 'rain-heavy' ? 140 : effect === 'drizzle' ? 55 : 95;
        for (var i = 0; i < count; i++) {
          var d = document.createElement('span');
          d.className = 'w-drop';
          d.style.left = Math.random() * 100 + '%';
          d.style.height = 22 + Math.random() * 26 + 'px';
          d.style.animationDuration = 0.55 + Math.random() * 0.7 + 's';
          d.style.animationDelay = Math.random() * 2 + 's';
          bgEl.appendChild(d);
        }
      } else if (effect === 'snow' || effect === 'snow-wind') {
        for (var j = 0; j < 70; j++) {
          var f = document.createElement('span');
          f.className = 'w-flake';
          f.style.left = Math.random() * 100 + '%';
          f.style.animationDuration = 4.5 + Math.random() * 4.5 + 's';
          f.style.animationDelay = Math.random() * 6 + 's';
          f.style.opacity = 0.5 + Math.random() * 0.5;
          bgEl.appendChild(f);
        }
      } else if (effect === 'storm' || effect === 'storm-wind') {
        // 雷暴：闪电 + 雨
        var fl = document.createElement('span');
        fl.className = 'w-flash';
        bgEl.appendChild(fl);
        for (var k = 0; k < 110; k++) {
          var dd = document.createElement('span');
          dd.className = 'w-drop';
          dd.style.left = Math.random() * 100 + '%';
          dd.style.height = 24 + Math.random() * 28 + 'px';
          dd.style.animationDuration = 0.5 + Math.random() * 0.6 + 's';
          dd.style.animationDelay = Math.random() * 2 + 's';
          bgEl.appendChild(dd);
        }
      } else if (effect === 'wind') {
        for (var w = 0; w < 12; w++) {
          var g = document.createElement('span');
          g.className = 'w-gust';
          g.style.top = Math.random() * 100 + '%';
          g.style.animationDuration = 3 + Math.random() * 3 + 's';
          g.style.animationDelay = Math.random() * 4 + 's';
          bgEl.appendChild(g);
        }
      } else if (effect === 'fog') {
        // 雾：轻微缓慢漂移的横条
        for (var m = 0; m < 8; m++) {
          var fg = document.createElement('span');
          fg.className = 'w-gust';
          fg.style.top = Math.random() * 100 + '%';
          fg.style.width = 200 + Math.random() * 300 + 'px';
          fg.style.animationDuration = 12 + Math.random() * 8 + 's';
          fg.style.animationDelay = Math.random() * 6 + 's';
          fg.style.opacity = 0.25;
          bgEl.appendChild(fg);
        }
      }
    }

    (function loadWeather() {
      if (!weatherEl || !bgEl) return;
      // 1) IP 定位城市（ipwho.is 免费，无需 key）
      fetch('https://ipwho.is/', { mode: 'cors' })
        .then(function (r) {
          return r.ok ? r.json() : Promise.reject();
        })
        .then(function (ip) {
          var lat = ip.latitude;
          var lon = ip.longitude;
          var city = ip.city || '';
          if (lat === undefined || lon === undefined) return Promise.reject();
          // 2) open-meteo 天气（免费，无需 key）
          var api =
            'https://api.open-meteo.com/v1/forecast?latitude=' +
            lat +
            '&longitude=' +
            lon +
            '&current_weather=true&timezone=auto';
          return fetch(api, { mode: 'cors' }).then(function (r2) {
            return r2.ok ? r2.json().then(function (w) {
              return { city: city, w: w };
            }) : Promise.reject();
          });
        })
        .then(function (data) {
          var cw = data.w.current_weather;
          var hour = new Date().getHours();
          var info = weatherInfo(cw.weathercode, hour >= 6 && hour < 19, cw.windspeed);
          weatherEl.hidden = false;
          iconEl.textContent = info.icon;
          textEl.textContent = (data.city || defaultCity) + ' · ' + info.label + ' ' + Math.round(cw.temperature) + '°C';
          renderWeatherBG(info.effect);
        })
        .catch(function () {
          // IP 定位或天气失败：隐藏天气，保持时间显示
          if (weatherEl) weatherEl.hidden = true;
        });
    })();

    // ===== 3. 工作/休息提醒 =====
    var toast = document.getElementById('work-toast');
    var STORAGE = 'leodeng:work';
    var MINS = 60000;
    var shown30 = false;
    var shown60 = false;
    var shownLate = false;

    function readState() {
      try {
        var s = JSON.parse(localStorage.getItem(STORAGE) || '{}');
        return s;
      } catch (e) {
        return {};
      }
    }
    function writeState(s) {
      try {
        localStorage.setItem(STORAGE, JSON.stringify(s));
      } catch (e) {}
    }

    function showToast(msg, isRest, duration) {
      if (!toast) return;
      toast.className = 'work-toast' + (isRest ? ' rest' : '');
      toast.innerHTML = '<span class="wt-emoji">' + (isRest ? '💪' : '🌿') + '</span>' + msg;
      toast.hidden = false;
      // 强制重绘触发过渡
      void toast.offsetWidth;
      toast.classList.add('show');
      setTimeout(function () {
        toast.classList.remove('show');
      }, duration || 6000);
    }

    function checkWork() {
      var s = readState();
      var now = Date.now();
      // 会话开始时间：本次页面会话（刷新/跳页后重置为继续累计？用 localStorage 跨页累计）
      if (!s.start) {
        s.start = now;
        writeState(s);
        return;
      }
      var elapsedMin = Math.floor((now - s.start) / MINS);

      // 30 分钟
      if (!shown30 && elapsedMin >= 30 && elapsedMin < 60) {
        shown30 = true;
        showToast('已经连续工作 ' + elapsedMin + ' 分钟啦～<br>起来活动活动，喝口水，看看窗外，眼睛和颈椎都需要休息。', false, 7000);
      }
      // 60 分钟
      if (!shown60 && elapsedMin >= 60) {
        shown60 = true;
        showToast('已经连续工作超过 1 小时了！<br>站起来走动几分钟，伸展一下，身体是革命的本钱。', true, 9000);
      }
      // 晚上 10 点后
      var h = new Date().getHours();
      if (!shownLate && h >= 22) {
        shownLate = true;
        showToast('已经晚上 10 点了～<br>身体是革命的本钱，早点休息、好好睡觉，明天再奋斗！晚安 🌙', true, 10000);
      }
    }
    // 启动：首次访问 2 秒后检查一次；之后每 1 分钟检查
    setTimeout(checkWork, 2000);
    setInterval(checkWork, 60000);

    // 页面可见时重置？不重置——"连续工作"指打开电脑/浏览本站持续时长
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) {
        // 回到页面：若离开超过 15 分钟，视为新会话（不算连续工作）
        var s = readState();
        if (s.start && Date.now() - s.start > 15 * MINS) {
          s.start = Date.now();
          shown30 = false;
          shown60 = false;
          writeState(s);
        }
      }
    });

    // ===== 4. 随机音乐（CC 授权：Jamendo / Free Music Archive 镜像） =====
    var musicWrap = document.getElementById('ambient-music');
    var amToggle = document.getElementById('am-toggle');
    var amPanel = document.getElementById('am-panel');
    var amIcon = document.getElementById('am-icon');
    var amTitle = document.getElementById('am-title');
    var amSong = document.getElementById('am-song');
    var amPlay = document.getElementById('am-play');
    var amPrev = document.getElementById('am-prev');
    var amNext = document.getElementById('am-next');
    var amProgress = document.getElementById('am-progress-bar');

    var audio = null;
    var isPlaying = false;
    var playTimer = null;
    var curTitle = '';

    // ===== 随机音乐：CC 授权现代音乐（Internet Archive 镜像） =====
    // 正规来源：
    //   1) Jamendo 全量镜像（约 29.5 万首，CC 授权现代音乐）——搜索 q: jamendo AND mediatype:audio
    //   2) Free Music Archive 镜像（约 1.7 万集合，带 licenseurl CC 授权）——搜索 q: freemusicarchive AND mediatype:audio
    // 每个条目是一张专辑（含多首 mp3），随机选专辑 → 随机选曲目。
    // 均为 CC 授权，可合法流式播放，无侵权风险。
    var MUSIC_SOURCES = [
      { key: 'jamendo', label: 'Jamendo', query: 'jamendo AND mediatype:audio', rows: 24 },
      { key: 'fma', label: 'Free Music Archive', query: 'freemusicarchive AND mediatype:audio', rows: 24 },
    ];
    // 兜底歌单（镜像不可用时）：公共领域经典（中文民歌 + 英文标准曲）
    var CLASSIC_SONGS = [
      'Moon River', 'Fly Me to the Moon', 'My Way', "Can't Help Falling in Love",
      'Edelweiss', 'Singin in the Rain', 'La Vie en Rose', 'Auld Lang Syne',
      'Greensleeves', 'Scarborough Fair', 'Amazing Grace', 'What a Wonderful World',
      'Over the Rainbow', 'Yesterday', 'Stand by Me', 'Unchained Melody',
      'Smoke Gets in Your Eyes', 'Dream a Little Dream of Me', 'Blue Moon',
      'Cheek to Cheek', 'The Way You Look Tonight', 'Autumn Leaves',
      '茉莉花', '康定情歌', '在那遥远的地方', '南泥湾',
      '友谊地久天长', '送别', '小河淌水', '沂蒙山小调', '彩云追月',
    ];
    // 记录失败：镜像条目 identifier / 兜底歌名，避免无限重试
    var failedIds = {};
    var failedSongs = {};

    function randomClassicSong() {
      var candidates = CLASSIC_SONGS.filter(function (s) {
        return !failedSongs[s];
      });
      if (!candidates.length) {
        failedSongs = {};
        candidates = CLASSIC_SONGS.slice();
      }
      return candidates[Math.floor(Math.random() * candidates.length)];
    }

    // 从 IA 镜像随机取一张专辑（Jamendo / FMA 轮流）
    function pickRandomAlbum() {
      var src = MUSIC_SOURCES[Math.floor(Math.random() * MUSIC_SOURCES.length)];
      var q = encodeURIComponent(src.query);
      return fetch(
        'https://archive.org/advancedsearch.php?q=' +
          q +
          '&fl%5B%5D=identifier&fl%5B%5D=title&fl%5B%5D=downloads&rows=' +
          src.rows +
          '&sort%5B%5D=downloads+desc&output=json'
      )
        .then(function (r) {
          return r.ok ? r.json() : Promise.reject(new Error('search failed'));
        })
        .then(function (d) {
          var docs = (d.response && d.response.docs) || [];
          // 过滤已失败的条目；全失败则整体重试
          var fresh = docs.filter(function (doc) {
            return !failedIds[doc.identifier];
          });
          var pool = fresh.length ? fresh : docs;
          if (!pool.length) return Promise.reject(new Error('no docs'));
          // 随机选一张专辑（下载量高的权重略大）
          var chosen = pool[Math.floor(Math.random() * Math.min(pool.length, 12))];
          return fetch('https://archive.org/metadata/' + encodeURIComponent(chosen.identifier)).then(function (r2) {
            if (!r2.ok) throw new Error('metadata failed');
            return r2.json();
          });
        })
        .then(function (meta) {
          var files = meta.files || [];
          var audioFiles = files.filter(function (f) {
            return /\.(mp3|ogg|m4a)$/i.test(f.name) && !/64kb|_64\.mp3|\.ogg$/i.test(f.name);
          });
          var pool = audioFiles.length ? audioFiles : files.filter(function (f) {
            return /\.(mp3|ogg|m4a)$/i.test(f.name);
          });
          if (!pool.length) throw new Error('no audio');
          var f = pool[Math.floor(Math.random() * pool.length)];
          var md = meta.metadata || {};
          var artist = md.artist || md.creator || '';
          var album = md.album || md.title || '';
          var track = f.title || String(f.name).replace(/\.[^.]+$/, '');
          // 显示：艺术家 - 曲名（专辑）
          var parts = [artist, track].filter(Boolean);
          var title = parts.join(' - ');
          if (album && album !== track && album !== md.title) title += '（' + album + '）';
          return {
            url:
              'https://archive.org/download/' +
              encodeURIComponent(md.identifier) +
              '/' +
              encodeURIComponent(f.name),
            title: String(title).slice(0, 70),
            source: 'CC 授权音乐',
            id: md.identifier,
            fallback: false,
          };
        });
    }

    // 兜底：按歌名在 IA 搜索公共领域/CC 录音（优先 1980 年前录音）
    function pickClassicSong() {
      var songName = randomClassicSong();
      var q = encodeURIComponent('"' + songName + '" AND mediatype:audio');
      return fetch(
        'https://archive.org/advancedsearch.php?q=' +
          q +
          '&fl%5B%5D=identifier&fl%5B%5D=title&fl%5B%5D=date&fl%5B%5D=downloads&rows=12&sort%5B%5D=downloads+desc&output=json'
      )
        .then(function (r) {
          return r.ok ? r.json() : Promise.reject();
        })
        .then(function (d) {
          var docs = (d.response && d.response.docs) || [];
          if (!docs.length) {
            failedSongs[songName] = true;
            return Promise.reject();
          }
          var pool = docs.filter(function (doc) {
            var dt = String(doc.date || '');
            var y = parseInt(dt, 10);
            return y > 0 && y < 1980;
          });
          var chosen = (pool.length ? pool : docs)[Math.floor(Math.random() * Math.min(pool.length || docs.length, 4))];
          return fetch('https://archive.org/metadata/' + encodeURIComponent(chosen.identifier)).then(function (r2) {
            return r2.ok ? r2.json() : Promise.reject();
          });
        })
        .then(function (meta) {
          var files = meta.files || [];
          var audioFiles = files.filter(function (f) {
            return /\.(mp3|ogg|m4a)$/i.test(f.name) && !/64kb|_64\.mp3|\.ogg$/i.test(f.name);
          });
          var pool = audioFiles.length ? audioFiles : files.filter(function (f) {
            return /\.(mp3|ogg|m4a)$/i.test(f.name);
          });
          if (!pool.length) return Promise.reject();
          var f = pool[Math.floor(Math.random() * pool.length)];
          var title = meta.metadata && (meta.metadata.title || meta.metadata.artist) || '未知曲目';
          return {
            url: 'https://archive.org/download/' + encodeURIComponent(meta.metadata.identifier) + '/' + encodeURIComponent(f.name),
            title: String(title).slice(0, 60),
            source: '经典',
            id: songName,
            fallback: true,
          };
        })
        .catch(function (e) {
          failedSongs[songName] = true;
          return Promise.reject(e);
        });
    }

    // 主路径：CC 镜像 → 失败降级到经典兜底
    function pickRandomSong() {
      return pickRandomAlbum().catch(function () {
        return pickClassicSong();
      });
    }

    function setPlayingUI(playing) {
      isPlaying = playing;
      amPlay.textContent = playing ? '⏸' : '▶';
      if (amToggle) amToggle.classList.toggle('playing', playing);
      amIcon.textContent = playing ? '🎶' : '🎵';
      if (playing && audio) {
        amSong.textContent = '正在播放：' + curTitle;
        amTitle.textContent = '随机音乐 · 30 分钟后自动停止';
      } else if (audio) {
        amSong.textContent = '已暂停：' + curTitle;
        amTitle.textContent = '随机音乐';
      }
    }

    function startTimer() {
      // 30 分钟自动停止
      if (playTimer) clearTimeout(playTimer);
      playTimer = setTimeout(function () {
        if (audio) {
          audio.pause();
          setPlayingUI(false);
          amSong.textContent = '已播放 30 分钟，休息一下耳朵～';
          amTitle.textContent = '随机音乐';
          amProgress.style.width = '0%';
        }
      }, 30 * 60000);
    }

    function playSong() {
      pickRandomSong()
        .then(function (song) {
          // 显示曲目名（CC 镜像：艺术家 - 曲名；兜底：经典曲目名）
          curTitle = song.title || song.id;
          if (!audio) {
            audio = new Audio();
            audio.preload = 'auto';
            // 挂到 DOM 便于调试与进度显示（不显示控件）
            audio.style.display = 'none';
            document.body.appendChild(audio);
            audio.addEventListener('ended', function () {
              // 一首结束自动下一曲
              playSong();
            });
            audio.addEventListener('timeupdate', function () {
              if (audio.duration) {
                var pct = (audio.currentTime / audio.duration) * 100;
                amProgress.style.width = pct + '%';
              }
            });
            audio.addEventListener('error', function () {
              // 播放失败：标记该条目失败后换下一首
              if (song.id) failedIds[song.id] = true;
              playSong();
            });
          }
          audio.src = song.url;
          audio.load();
          var p = audio.play();
          if (p && typeof p.then === 'function') {
            p.then(function () {
              setPlayingUI(true);
              startTimer();
            }).catch(function () {
              if (song.id) failedIds[song.id] = true;
              amSong.textContent = '这首没找到合适录音，换一首…';
              setTimeout(playSong, 1500);
            });
          } else {
            setPlayingUI(true);
            startTimer();
          }
        })
        .catch(function () {
          amSong.textContent = '暂时没找到合适的歌，再试一次？';
          setTimeout(function () {
            amSong.textContent = '点击播放，随机来一首 CC 授权音乐';
          }, 2500);
        });
    }

    function togglePlay() {
      if (!audio) {
        playSong();
        return;
      }
      if (isPlaying) {
        audio.pause();
        setPlayingUI(false);
      } else {
        audio.play().then(function () {
          setPlayingUI(true);
          startTimer();
        }).catch(function () {});
      }
    }

    function nextSong() {
      if (audio) {
        audio.pause();
        audio.src = '';
      }
      amProgress.style.width = '0%';
      playSong();
    }

    // 面板：hover 显示 / 移出隐藏（触屏点按切换）
    if (musicWrap && amPanel) {
      // 鼠标是否还在音乐区域（按钮或面板）内
      function insideMusic(el) {
        return el && musicWrap.contains(el);
      }
      musicWrap.addEventListener('mouseenter', function () {
        amPanel.hidden = false;
      });
      musicWrap.addEventListener('mouseleave', function (e) {
        // 若鼠标移入了面板（子元素），不隐藏
        if (insideMusic(e.relatedTarget)) return;
        amPanel.hidden = true;
      });
      amPanel.addEventListener('mouseenter', function () {
        amPanel.hidden = false;
      });
      amPanel.addEventListener('mouseleave', function (e) {
        if (insideMusic(e.relatedTarget)) return;
        amPanel.hidden = true;
      });
      amToggle.addEventListener('click', function (e) {
        e.stopPropagation();
        // 触屏/点击：展开面板；再次点击切换播放
        if (amPanel.hidden) {
          amPanel.hidden = false;
        } else {
          togglePlay();
        }
      });
      if (amPlay) amPlay.addEventListener('click', function (e) {
        e.stopPropagation();
        togglePlay();
      });
      if (amPrev) amPrev.addEventListener('click', function (e) {
        e.stopPropagation();
        // 上一曲：重播当前（无历史列表），简单回到开头
        if (audio && audio.currentTime > 3) {
          audio.currentTime = 0;
        } else {
          nextSong();
        }
      });
      if (amNext) amNext.addEventListener('click', function (e) {
        e.stopPropagation();
        nextSong();
      });
    }
  })();
</script>
