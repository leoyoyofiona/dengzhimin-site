      if (dmStatus) dmStatus.hidden = true;
      var ctrl = new AbortController();
      var timer = setTimeout(function () { ctrl.abort(); }, 6000);
      fetch(SUG_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: dmName ? dmName.value.trim() : '', text: text }),
        signal: ctrl.signal,
      })
        .then(async function (r) { clearTimeout(timer); if (!r.ok) { let m = ''; try { m = (await r.json()).error || ''; } catch (_) {} throw new Error(m || 'http'); }
          // 乐观加入并立即发射
          var rec = { name: (dmName && dmName.value.trim()) || '匿名', text: text, time: Date.now() };
          dmItems.push(rec);
          dmFire(rec);
          if (dmText) dmText.value = '';
          if (dmName) dmName.value = '';
          if (dmCount) dmCount.textContent = '0/500';
          if (dmCard) dmCard.hidden = true;
          dmSend.classList.remove('open');
          if (!dmTimer) dmNext();
          return null; })
        .catch(function (err) {
          clearTimeout(timer);
          var msg = (err && err.message) || '';
          if (dmStatus) {
            dmStatus.textContent = msg && msg !== 'http' ? msg : '发送失败，请稍后重试。';
            dmStatus.hidden = false;
          }
        })
        .finally(function () { if (dmSendBtn) dmSendBtn.disabled = false; });
    }
