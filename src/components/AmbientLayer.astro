        var s = readState();
        if (s.start && Date.now() - s.start > 15 * MINS) {
          s.start = Date.now();
          shown30 = false;
          shown60 = false;
          writeState(s);
        }
      }
    });

    // ===== 4. 随机音乐（CC 授权：Jamendo / Free Music Archive 镜像） =====
    var musicWrap = document.getElementById('ambient-music');
