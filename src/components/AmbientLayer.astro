---
// 环境层：当前时间 + 天气（按访问者 IP 定位）+ 天气背景动画 + 工作/休息提醒
// 所有页面由 BaseLayout 引入，低调呈现
const now = new Date();
const defaultCity = '你所在的城市';
---

<!-- 全站建议弹幕（顶部飘过，pointer-events:none） -->
<div class="dm-layer" id="dm-layer" aria-hidden="true"></div>

<!-- 发弹幕：桌面 = 导航"今日更新"右侧按钮（在 Header 中）；移动 = 右下角按钮 -->
<div class="dm-send" id="dm-send">
  <button class="dm-open" id="dm-open" type="button" title="发条弹幕交流/建议（公开可见）" aria-label="弹幕交流">💬 弹幕交流</button>
</div>
<div class="dm-card" id="dm-card" hidden>
  <div class="dm-card-title">发条建议 / 弹幕（公开可见）</div>
  <input id="dm-name" class="dm-name" type="text" maxlength="20" placeholder="昵称（可选，默认匿名）" autocomplete="off" />
  <textarea id="dm-text" class="dm-text" rows="2" maxlength="500" placeholder="想说什么…（⌘/Ctrl+Enter 发送，内容经自动过滤）"></textarea>
  <div class="dm-card-foot">
    <span class="dm-count" id="dm-count">0/500</span>
    <button class="dm-sendbtn" id="dm-sendbtn" type="button">发送 💬</button>
  </div>
  <p class="dm-status" id="dm-status" hidden></p>
  <div class="dm-card-adminbar">
    <button class="dm-admin-toggle" id="dm-admin-toggle" type="button">🔧 管理弹幕</button>
  </div>
  <div class="dm-admin" id="dm-admin" hidden>
    <div class="dm-admin-login">
      <input id="dm-admin-pass" class="dm-name" type="password" maxlength="20" placeholder="管理密码" autocomplete="off" />
      <button class="dm-sendbtn" id="dm-admin-loginbtn" type="button">验证</button>
    </div>
    <div class="dm-admin-body" id="dm-admin-body" hidden>
      <div class="dm-admin-tools">
        <button class="dm-admin-clear" id="dm-admin-clear" type="button">🗑 清空全部</button>
        <span class="dm-admin-tip">点击条目右侧 × 可删除单条</span>
      </div>
      <div class="dm-admin-list" id="dm-admin-list"></div>
      <p class="dm-admin-status" id="dm-admin-status" hidden></p>
    </div>
  </div>
</div>

<!-- 天气背景动画层（不遮挡内容） -->
<div class="weather-bg" id="weather-bg" aria-hidden="true"></div>

<!-- 工作提醒 Toast -->
<div class="work-toast" id="work-toast" role="alert" hidden></div>

<style>
/* ===== 工作/休息提醒 Toast ===== */
  .work-toast {
    position: fixed;
    left: 50%;
    top: max(4.5rem, calc(var(--header-h) + 0.75rem));
    transform: translateX(-50%);
    z-index: 500;
    max-width: min(440px, calc(100vw - 2rem));
    padding: 0.85rem 1.2rem;
    border-radius: var(--radius-lg);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: var(--shadow-lg);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text);
    text-align: center;
    opacity: 0;
    transform: translateX(-50%) translateY(-8px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
    pointer-events: none;
  }
  .work-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .work-toast.rest {
    border-color: color-mix(in srgb, #e11d48 45%, var(--border));
  }
  .work-toast .wt-emoji {
    font-size: 1.25rem;
    display: block;
    margin-bottom: 0.2rem;
  }
</style>

<style is:global>
  /* ===== 全站建议弹幕层（顶部飘过，不遮挡内容） ===== */
  .dm-layer {
    position: fixed;
    top: calc(var(--header-h) + 4px);
    left: 0;
    right: 0;
    height: 0;
    z-index: 260;
    pointer-events: none;
    overflow: visible;
  }
  /* 桌面：第二行还有栏目导航（约 --header-h + 37px 高），弹幕再下移避开标签文字 */
  @media (min-width: 1025px) {
    .dm-layer {
      top: calc(var(--header-h) + 2.5rem);
    }
  }
  .dm-layer .dm-item {
    position: absolute;
    top: 0;
    left: 100%;
    white-space: nowrap;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    backdrop-filter: saturate(180%) blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 0.3rem 0.9rem;
    box-shadow: var(--shadow-sm);
    opacity: 0.94;
    animation: dm-fly linear forwards;
    /* 单条弹幕可被鼠标命中（悬浮暂停 / 点赞） */
    pointer-events: auto;
    cursor: default;
  }
  /* 悬浮：所有弹幕一起暂停（防后面的撞上来），当前条显示点赞按钮 */
  .dm-layer.pause-all .dm-item {
    animation-play-state: paused;
  }
  .dm-item .dm-actions {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    margin-left: 0.55rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease);
    pointer-events: none;
  }
  .dm-item:hover .dm-actions {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }
  .dm-layer.pause-all .dm-item:hover .dm-actions {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }
  .dm-item .dm-like-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.1rem 0.25rem;
    border-radius: var(--radius-full);
    transition: transform 0.15s var(--ease), color 0.15s var(--ease);
  }
  .dm-item .dm-like-btn:hover {
    transform: scale(1.25);
    color: var(--accent);
  }
  .dm-item .dm-like-btn.is-liked {
    color: var(--accent);
  }
  .dm-item .dm-like-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-tertiary);
    margin-left: 0.1rem;
    font-variant-numeric: tabular-nums;
  }
  /* 弹幕下方点赞计数徽标 */
  .dm-item .dm-likes {
    display: inline-flex;
    align-items: center;
    gap: 0.12rem;
    margin-left: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
    vertical-align: middle;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-radius: var(--radius-full);
    padding: 0.08rem 0.4rem;
    pointer-events: none;
  }
  .dm-item .dm-likes:empty { display: none; }
  /* hover 时只留一个 👍（浮现按钮），常驻计数徽标隐藏，避免两个大拇指 */
  .dm-item:hover .dm-likes { display: none; }
  @media (hover: none) {
    .dm-item .dm-likes { display: none; }
    .dm-item:hover .dm-likes { display: none; }
  }
  /* 点击后跳出的大拇指动画 */
  .dm-thumb-pop {
    position: fixed;
    z-index: 340;
    pointer-events: none;
    font-size: 2.4rem;
    line-height: 1;
    animation: dm-thumb-pop 0.9s var(--ease-out) forwards;
  }
  @keyframes dm-thumb-pop {
    0% { transform: translate(-50%, 0) scale(0.3); opacity: 0; }
    35% { transform: translate(-50%, -14px) scale(1.25); opacity: 1; }
    70% { transform: translate(-50%, -30px) scale(1); opacity: 1; }
    100% { transform: translate(-50%, -54px) scale(0.9); opacity: 0; }
  }
  /* 点赞后的 "+1" 飘字 */
  .dm-plus-pop {
    position: fixed;
    z-index: 341;
    pointer-events: none;
    font-size: 1.25rem;
    font-weight: 800;
    color: #f59f00;
    text-shadow: 0 0 6px color-mix(in srgb, #f59f00 55%, transparent);
    animation: dm-plus-pop 0.85s var(--ease-out) forwards;
  }
  @keyframes dm-plus-pop {
    0% { transform: translate(-50%, 0) scale(0.5); opacity: 0; }
    30% { transform: translate(-50%, -16px) scale(1.4); opacity: 1; }
    60% { transform: translate(-50%, -40px) scale(1.1); opacity: 1; }
    100% { transform: translate(-50%, -72px) scale(0.95); opacity: 0; }
  }
  /* 点赞/操作提示条 */
  .dm-toast {
    position: fixed;
    top: max(7.2rem, calc(var(--header-h) + 2.5rem + 2rem));
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
    z-index: 360;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: var(--shadow-lg);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .dm-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  @media (hover: none) {
    /* 触屏：不自动显示赞按钮，仅保留点击赞（由 JS 点击弹幕切换） */
    .dm-item .dm-actions { opacity: 1; transform: none; pointer-events: auto; margin-left: 0.3rem; }
  }
  @keyframes dm-fly {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100vw - 120%)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dm-layer .dm-item { animation: none; }
  }
  /* 弹幕内昵称高亮 */
  .dm-item .dm-who { color: var(--accent); font-weight: 700; margin-right: 0.35em; }

  /* ===== 发弹幕：桌面 = Header 导航"今日更新"右侧按钮；移动 = 右下角按钮 ===== */
  .dm-send {
    position: fixed;
    right: max(0.9rem, env(safe-area-inset-right));
    bottom: max(3.6rem, calc(env(safe-area-inset-bottom) + 2.8rem));
    z-index: 320;
    display: flex;
  }
  .dm-open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.42rem 0.85rem;
    border: none;
    border-radius: var(--radius-full);
    background: var(--gradient);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    transition: transform var(--speed) var(--ease), box-shadow var(--speed) var(--ease);
  }
  .dm-open:hover { transform: translateY(-2px); box-shadow: var(--shadow-glow); }
  /* 桌面：隐藏右下角浮钮（改用导航按钮），输入卡移到导航下方右侧 */
  @media (min-width: 1025px) {
    .dm-send { display: none; }
    .dm-card {
      position: fixed;
      top: calc(var(--header-h) + 3.1rem);
      right: max(calc((100vw - var(--maxw)) / 2), var(--gutter));
      z-index: 340;
    }
  }
  /* 移动：保留右下角浮钮，输入卡在浮钮上方 */
  @media (max-width: 1024px) {
    .dm-card {
      position: fixed;
      right: max(0.9rem, env(safe-area-inset-right));
      bottom: max(5.6rem, calc(env(safe-area-inset-bottom) + 4.9rem));
      z-index: 340;
    }
  }
  .dm-card {
    width: min(300px, calc(100vw - 2rem));
    padding: 0.9rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--bg-glass-strong);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dm-card[hidden], .dm-send[hidden] { display: none; }
  .dm-card-title { font-size: var(--text-xs); font-weight: 650; color: var(--text-tertiary); letter-spacing: 0.03em; }
  .dm-name, .dm-text {
    width: 100%;
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-family: inherit;
    font-size: var(--text-sm);
  }
  .dm-text { resize: vertical; min-height: 60px; line-height: 1.5; }
  .dm-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .dm-count { font-size: 0.72rem; color: var(--text-tertiary); }
  .dm-sendbtn {
    padding: 0.4rem 0.9rem;
    border: none;
    border-radius: var(--radius-full);
    background: var(--gradient);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform var(--speed) var(--ease);
  }
  .dm-sendbtn:hover { transform: scale(1.05); }
  .dm-status { margin: 0; font-size: 0.78rem; color: #e03131; }
  .dm-status[hidden] { display: none; }
  /* ===== 弹幕管理 ===== */
  .dm-card-adminbar {
    border-top: 1px dashed var(--border);
    padding-top: 0.4rem;
    display: flex;
    justify-content: flex-end;
  }
  .dm-admin-toggle {
    border: none;
    background: none;
    color: var(--text-tertiary);
    font-size: 0.7rem;
    cursor: pointer;
    padding: 0.1rem 0.2rem;
  }
  .dm-admin-toggle:hover { color: var(--accent); }
  .dm-admin { display: flex; flex-direction: column; gap: 0.4rem; border-top: 1px dashed var(--border); padding-top: 0.5rem; }
  .dm-admin[hidden] { display: none; }
  .dm-admin-login { display: flex; gap: 0.4rem; }
  .dm-admin-login .dm-name { flex: 1; }
  .dm-admin-body { display: flex; flex-direction: column; gap: 0.4rem; }
  .dm-admin-body[hidden] { display: none; }
  .dm-admin-tools { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; }
  .dm-admin-clear {
    border: none;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, #e03131 12%, transparent);
    color: #e03131;
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
  }
  .dm-admin-clear:hover { background: #e03131; color: #fff; }
  .dm-admin-tip { font-size: 0.66rem; color: var(--text-tertiary); }
  .dm-admin-list { display: flex; flex-direction: column; gap: 0.3rem; max-height: 190px; overflow-y: auto; }
  .dm-admin-item {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    font-size: 0.74rem;
    line-height: 1.45;
    padding: 0.3rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--bg-glass);
    border: 1px solid var(--border);
  }
  .dm-admin-item .dai-who { color: var(--accent); font-weight: 700; flex-shrink: 0; }
  .dm-admin-item .dai-text { flex: 1; color: var(--text-secondary); word-break: break-word; }
  .dm-admin-item .dai-time { color: var(--text-tertiary); font-size: 0.62rem; flex-shrink: 0; }
  .dm-admin-item .dai-del {
    border: none;
    background: none;
    color: var(--text-tertiary);
    font-size: 0.85rem;
    cursor: pointer;
    line-height: 1;
    padding: 0;
    flex-shrink: 0;
  }
  .dm-admin-item .dai-del:hover { color: #e03131; }
  .dm-admin-status { margin: 0; font-size: 0.72rem; color: #2f9e44; }
  .dm-admin-status.error { color: #e03131; }
  .dm-admin-status[hidden] { display: none; }

  /* ===== 天气背景动画层（JS 动态创建元素，需全局样式） ===== */
  .weather-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .weather-bg .w-drop,
  .weather-bg .w-flake,
  .weather-bg .w-gust,
  .weather-bg .w-flash {
    position: absolute;
    top: -10%;
    display: block;
  }
  .weather-bg .w-drop {
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(180deg, transparent, rgba(96, 148, 232, 0.85));
    box-shadow: 0 0 3px rgba(96, 148, 232, 0.35);
    animation: w-fall linear infinite;
  }
  .weather-bg .w-flake {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.75);
    animation: w-fall linear infinite, w-sway ease-in-out infinite alternate;
  }
  .weather-bg .w-gust {
    width: 80px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    animation: w-gust linear infinite;
  }
  .weather-bg .w-flash {
    width: 100%;
    height: 100%;
    background: rgba(255, 244, 200, 0.2);
    animation: w-flash 4s ease-in-out infinite;
  }
  @keyframes w-fall {
    0% {
      transform: translateY(-10vh);
    }
    100% {
      transform: translateY(110vh);
    }
  }
  @keyframes w-sway {
    0% {
      margin-left: 0;
    }
    100% {
      margin-left: 18px;
    }
  }
  @keyframes w-gust {
    0% {
      transform: translateX(-15vw);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      transform: translateX(115vw);
      opacity: 0;
    }
  }
  @keyframes w-flash {
    0%,
    88%,
    100% {
      opacity: 0;
    }
    90% {
      opacity: 1;
    }
    93% {
      opacity: 0;
    }
    96% {
      opacity: 0.7;
    }
  }
  html[data-theme='dark'] .weather-bg .w-drop {
    background: linear-gradient(180deg, transparent, rgba(130, 180, 255, 0.45));
  }

  /* ===== 右上角天空图标：表达当前天气（低调不抢眼） ===== */
  .weather-bg .w-sky {
    position: absolute;
    top: 14%;
    right: 6%;
    width: 92px;
    height: 92px;
    opacity: 0.85;
    pointer-events: none;
    filter: saturate(0.95);
  }
  /* 太阳：核心 + 旋转光芒 */
  .w-sky[data-sky='sun']::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle at 40% 38%, #fff6d8, #ffd766 55%, #ffb03a);
    box-shadow: 0 0 22px 10px rgba(255, 196, 90, 0.35), 0 0 48px 22px rgba(255, 196, 90, 0.18);
  }
  .w-sky[data-sky='sun']::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 96px;
    height: 96px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: repeating-conic-gradient(rgba(255, 208, 110, 0.55) 0deg 7deg, transparent 7deg 22deg);
    -webkit-mask: radial-gradient(circle, transparent 46%, #000 60%);
    mask: radial-gradient(circle, transparent 46%, #000 60%);
    animation: w-sky-spin 36s linear infinite;
  }
  /* 多云：小太阳 + 云 */
  .w-sky[data-sky='cloud-sun']::before {
    content: '';
    position: absolute;
    right: 8px;
    top: 6px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 38%, #fff6d8, #ffd766 55%, #ffb03a);
    box-shadow: 0 0 16px 6px rgba(255, 196, 90, 0.3);
  }
  .w-sky[data-sky='cloud-sun']::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 22px;
    width: 66px;
    height: 30px;
    border-radius: 30px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(214, 222, 236, 0.8));
    box-shadow:
      24px -12px 0 -2px rgba(255, 255, 255, 0.88),
      44px -4px 0 -4px rgba(214, 222, 236, 0.8);
  }
  /* 阴天：灰云 */
  .w-sky[data-sky='cloud']::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 26px;
    width: 76px;
    height: 32px;
    border-radius: 30px;
    background: linear-gradient(180deg, rgba(208, 216, 232, 0.95), rgba(170, 180, 200, 0.85));
    box-shadow:
      26px -14px 0 -2px rgba(208, 216, 232, 0.9),
      48px -6px 0 -5px rgba(170, 180, 200, 0.85);
  }
  /* 毛毛雨 / 雨：云 + 斜雨丝 */
  .w-sky[data-sky='drizzle']::before,
  .w-sky[data-sky='rain']::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 18px;
    width: 76px;
