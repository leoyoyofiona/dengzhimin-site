---
import { SITE } from '../lib/site';
---

<a class="logo" href="/" aria-label={`${SITE.name} 首页`}>
  <span class="wordmark">{SITE.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text);
  }
  .wordmark {
    font-weight: 650;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }
</style>
