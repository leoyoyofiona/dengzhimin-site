---
import { SITE, SECTIONS } from '../lib/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="brand">
      <p class="brand-name">LEODENG</p>
      <p class="brand-tag">{SITE.tagline}</p>
    </div>

    <nav class="footer-nav" aria-label="页脚导航">
      <div class="col">
        <p class="col-title">栏目</p>
        <ul>
          {
            SECTIONS.map((s) => (
              <li>
                <a href={`/${s.slug}/`}>{s.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="col">
        <p class="col-title">更多</p>
        <ul>
          <li><a href="/works/">si码如山</a></li>
          <li><a href="/about/">留言板</a></li>
          <li><a href="/search/">搜索</a></li>
          <li><a href="/rss.xml">RSS 订阅</a></li>
        </ul>
      </div>
      <div class="col">
        <p class="col-title">联系</p>
        <ul>
          <li>
            <a class="contact-link" href={`mailto:${SITE.email}`}>
              <Icon name="mail" size={14} />
              <span>{SITE.email}</span>
            </a>
          </li>
          <li>
            <a
              class="contact-link"
              href={`https://github.com/${SITE.github}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="github" size={14} />
              <span>GitHub</span>
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {SITE.name} · {SITE.domain}</p>
    <p class="visits" id="visits-counter" title="访问统计">
      <Icon name="eye" size={13} />
      <span>访问中…</span>
    </p>
    <p class="credit">由 <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> 构建</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border);
    background: var(--bg-glass);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    margin-top: 2rem;
  }
  .footer-inner {
    max-width: 760px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2.5rem;
    padding-block: 1.5rem 1rem;
    flex-wrap: wrap;
  }
  .brand {
    max-width: 14rem;
  }
  .brand-name {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }
  .brand-tag {
    margin-top: 0.3rem;
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .footer-nav {
    display: flex;
    gap: 2.5rem;
  }
  .col-title {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-tertiary);
    margin-bottom: 0.5rem;
  }
  .col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .col a {
    color: var(--text-secondary);
    font-size: var(--text-xs);
    transition: color var(--speed) var(--ease);
  }
  .col a:hover {
    color: var(--text);
  }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .footer-bottom {
    max-width: 760px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    flex-wrap: wrap;
  }
  .credit a {
    color: var(--text-tertiary);
  }
  .credit a:hover {
    color: var(--text);
  }

  /* ===== 访问统计 ===== */
  .visits {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-tertiary);
  }
  .visits .hidden {
    visibility: hidden;
  }

  @media (max-width: 720px) {
    .footer-inner {
      flex-direction: column;
      gap: 1.5rem;
    }
    .footer-nav {
      gap: 2rem;
    }
  }
</style>

<script>
  // ===== 访问统计：上报 + 显示（访客数 / 浏览次数） =====
  // 依赖自建留言板 API（dengzhimin-guestbook-api）；API 不可用时静默隐藏
  (function () {
    const API = 'https://dengzhimin-guestbook-api.leooelcn.workers.dev/api/visits';
    const counter = document.getElementById('visits-counter');
    if (!counter) return;
    if (counter.dataset.bound) return;
    counter.dataset.bound = '1';

    const uidKey = 'leodeng:visitor-uid';
    const localKey = 'leodeng:visits-local';

    function getUid() {
      try {
        let uid = localStorage.getItem(uidKey);
        if (!uid) {
          uid =
            (crypto.randomUUID && crypto.randomUUID()) ||
            'v-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
          localStorage.setItem(uidKey, uid);
        }
        return uid;
      } catch (_) {
        return '';
      }
    }

    function fmt(n) {
      if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
      if (n >= 10000) return (n / 10000).toFixed(1) + 'w';
      return String(n);
    }

    // 本机累计访问（每次页面加载 +1），作为 API 不可用时的兜底
    function bumpLocal() {
      try {
        const n = (parseInt(localStorage.getItem(localKey), 10) || 0) + 1;
        localStorage.setItem(localKey, String(n));
        return n;
      } catch (_) {
        return 0;
      }
    }
    const localVisits = bumpLocal();
    const text = counter.querySelector('span');

    async function report(attempt = 0) {
      try {
        // 上报本次访问
        const res = await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ uid: getUid() }),
        });
        if (!res.ok) throw new Error('bad status');
        const data = await res.json();
        text.textContent = '访问 ' + fmt(data.visitors || 0) + ' 人 · 浏览 ' + fmt(data.views || 0) + ' 次';
      } catch (_) {
        // 首次失败后 3 秒重试一次（网络偶发抖动），仍失败才显示本机累计
        if (attempt < 1) {
          setTimeout(function () {
            report(attempt + 1);
          }, 3000);
          return;
        }
        // API 不可用：显示本机累计（本机视为 1 位访客，浏览为本地累计次数）
        if (text) text.textContent = localVisits > 0 ? '访问 1 人 · 浏览 ' + fmt(localVisits) + ' 次' : '访问 1 人 · 浏览 1 次';
        counter.title = '全站统计暂不可用，当前为本机累计';
      }
    }
    // 立即显示本机计数（保证秒开），再异步拉取全站统计覆盖
    if (text) text.textContent = localVisits > 0 ? '访问 1 人 · 浏览 ' + fmt(localVisits) + ' 次' : '访问 1 人 · 浏览 1 次';
    report();
  })();
</script>
