---
import { SITE, SECTIONS } from '../lib/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="brand">
      <p class="brand-name">LEODENG</p>
      <p class="brand-tag">{SITE.tagline}</p>
    </div>

    <nav class="footer-nav" aria-label="页脚导航">
      <div class="col">
        <p class="col-title">栏目</p>
        <ul>
          {
            SECTIONS.map((s) => (
              <li>
                <a href={`/${s.slug}/`}>{s.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="col">
        <p class="col-title">更多</p>
        <ul>
          <li><a href="/works/">si码如山</a></li>
          <li><a href="/about/">留言板</a></li>
          <li><a href="/search/">搜索</a></li>
          <li><a href="/rss.xml">RSS 订阅</a></li>
        </ul>
      </div>
      <div class="col">
        <p class="col-title">联系</p>
        <ul>
          <li>
            <a class="contact-link" href={`mailto:${SITE.email}`}>
              <Icon name="mail" size={14} />
              <span>{SITE.email}</span>
            </a>
          </li>
          <li>
            <a
              class="contact-link"
              href={`https://github.com/${SITE.github}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="github" size={14} />
              <span>GitHub</span>
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {SITE.name} · {SITE.domain}</p>
    <p class="visits" id="visits-counter" title="访问统计">
      <Icon name="eye" size={13} />
      <span>访问中…</span>
    </p>
    <p class="credit">由 <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> 构建</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-glass);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    margin-top: 2rem;
  }
  .footer-inner {
    max-width: 760px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2.5rem;
    padding-block: 1.5rem 1rem;
    flex-wrap: wrap;
  }
  .brand {
    max-width: 14rem;
  }
  .brand-name {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }
  .brand-tag {
    margin-top: 0.3rem;
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .footer-nav {
    display: flex;
    gap: 2.5rem;
  }
  .col-title {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-tertiary);
    margin-bottom: 0.5rem;
  }
  .col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .col a {
    color: var(--text-secondary);
    font-size: var(--text-xs);
    transition: color var(--speed) var(--ease);
  }
  .col a:hover {
    color: var(--text);
  }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .footer-bottom {
    max-width: 760px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    flex-wrap: wrap;
  }
  .credit a {
    color: var(--text-tertiary);
  }
  .credit a:hover {
    color: var(--text);
  }

  /* ===== 访问统计 ===== */
  .visits {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--text-tertiary);
  }
  .visits .hidden {
    visibility: hidden;
  }

  @media (max-width: 720px) {
    .footer-inner {
      flex-direction: column;
      gap: 1.5rem;
    }
    .footer-nav {
      gap: 2rem;
    }
  }
</style>

<script>
  // ===== 访问统计：上报 + 显示（访客数 / 浏览次数） =====
  // 依赖自建留言板 API（dengzhimin-guestbook-api）；API 不可用时静默隐藏
  (function () {
    const API = 'https://dengzhimin-guestbook-api.onrender.com/api/visits';
    const counter = document.getElementById('visits-counter');
    if (!counter) return;

    const uidKey = 'leodeng:visitor-uid';
    function getUid() {
      try {
        let uid = localStorage.getItem(uidKey);
        if (!uid) {
          uid =
            (crypto.randomUUID && crypto.randomUUID()) ||
            'v-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
          localStorage.setItem(uidKey, uid);
        }
        return uid;
      } catch (_) {
        return '';
      }
    }

    function fmt(n) {
      if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
      if (n >= 10000) return (n / 10000).toFixed(1) + 'w';
      return String(n);
    }

    async function report() {
      try {
        // 上报本次访问
        const res = await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ uid: getUid() }),
        });
        if (!res.ok) throw new Error('bad status');
        const data = await res.json();
        counter.querySelector('span').textContent =
          '访问 ' + fmt(data.visitors || 0) + ' 人 · 浏览 ' + fmt(data.views || 0) + ' 次';
      } catch (_) {
        // API 不可用：隐藏计数器
        counter.style.display = 'none';
      }
    }
    report();
  })();
</script>
